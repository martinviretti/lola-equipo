---
import Icon from './Icon.astro';

type Tipo = 'peligro' | 'importante' | 'consejo' | 'local' | 'verificar';
interface Props {
  tipo?: Tipo;
}

const { tipo = 'importante' } = Astro.props;

const estilos: Record<Tipo, { icono: string; etiqueta: string; clases: string; icClases: string }> = {
  peligro: {
    icono: 'warning',
    etiqueta: 'Cuidado',
    clases: 'bg-peligro-suave ring-peligro/25',
    icClases: 'bg-peligro text-white',
  },
  importante: {
    icono: 'info',
    etiqueta: 'Importante',
    clases: 'bg-menta-suave ring-profundo/15',
    icClases: 'bg-profundo text-white',
  },
  consejo: {
    icono: 'lightbulb',
    etiqueta: 'Consejo de mostrador',
    clases: 'bg-white ring-profundo/12',
    icClases: 'bg-menta text-profundo',
  },
  local: {
    icono: 'storefront',
    etiqueta: 'Completar en el local',
    clases: 'bg-arena-suave ring-arena border border-dashed border-texto-2/40',
    icClases: 'bg-arena text-profundo',
  },
  verificar: {
    icono: 'seal-question',
    etiqueta: 'Dato a verificar',
    clases: 'bg-ambar-suave ring-ambar/25',
    icClases: 'bg-ambar text-white',
  },
};

const e = estilos[tipo] ?? estilos.importante;
---

<aside class:list={['alerta not-prose flex gap-3 rounded-2xl p-4 ring-1 sm:gap-4 sm:p-5', e.clases]} data-tipo={tipo}>
  <span class:list={['flex size-8 shrink-0 items-center justify-center rounded-full', e.icClases]}>
    <Icon name={e.icono} class="size-5" />
  </span>
  <div class="alerta-cuerpo min-w-0 flex-1">
    <p class="text-xs font-bold tracking-wide text-profundo uppercase">{e.etiqueta}</p>
    <div class="mt-1 text-[0.98rem] leading-relaxed"><slot /></div>
  </div>
</aside>

<style>
  .alerta-cuerpo :global(p + p),
  .alerta-cuerpo :global(ul),
  .alerta-cuerpo :global(ol) {
    margin-top: 0.5em;
  }
  .alerta-cuerpo :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
  }
  .alerta-cuerpo :global(ol) {
    list-style: decimal;
    padding-left: 1.2em;
  }
  .alerta-cuerpo :global(strong) {
    font-weight: 700;
    color: var(--color-profundo);
  }
  @media print {
    .alerta {
      box-shadow: none;
      border: 0.75pt solid #b9c7bf;
    }
  }
</style>
