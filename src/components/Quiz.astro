---
import Icon from './Icon.astro';

interface Pregunta {
  pregunta: string;
  opciones: string[];
  correcta: number;
  explicacion: string;
}
interface Props {
  slug: string;
  preguntas: Pregunta[];
}

const { slug, preguntas } = Astro.props;
const letras = ['A', 'B', 'C', 'D'];
---

<section id="quiz" class="no-print mt-16 rounded-3xl bg-white p-5 ring-1 ring-profundo/10 sm:p-8" data-quiz={slug} data-total={preguntas.length}>
  <div class="flex items-start gap-4">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
      <Icon name="list-checks" class="size-6" />
    </span>
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-profundo">Ponete a prueba</h2>
      <p class="mt-1 text-base text-texto-2">
        {preguntas.length} preguntas. Elegí una respuesta y te contamos si está bien y por qué.
      </p>
    </div>
  </div>

  <ol class="mt-8 flex flex-col gap-6">
    {
      preguntas.map((q, i) => (
        <li class="pregunta rounded-2xl bg-crema p-4 sm:p-5" data-pregunta={i} data-correcta={q.correcta}>
          <p class="text-base font-semibold text-profundo sm:text-lg">
            <span class="mr-1 text-marca tabular-nums">{i + 1}.</span> {q.pregunta}
          </p>
          <div class="mt-4 flex flex-col gap-2" role="group" aria-label={`Opciones de la pregunta ${i + 1}`}>
            {q.opciones.map((op, j) => (
              <button
                type="button"
                data-opcion={j}
                class="opcion flex w-full items-start gap-3 rounded-xl bg-white p-3 text-left text-base ring-1 ring-profundo/10 transition-colors duration-300 hover:bg-menta-suave disabled:cursor-default"
              >
                <span class="letra flex size-7 shrink-0 items-center justify-center rounded-full bg-menta-suave text-sm font-bold text-profundo">
                  {letras[j]}
                </span>
                <span class="pt-0.5">{op}</span>
              </button>
            ))}
          </div>
          <div class="explicacion mt-3 hidden rounded-xl p-3 text-[0.95rem] leading-relaxed" aria-live="polite">
            <p class="veredicto font-bold"></p>
            <p class="mt-1 text-texto">{q.explicacion}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="resultado mt-8 hidden rounded-2xl bg-profundo p-5 text-white sm:p-6" aria-live="polite">
    <p class="text-sm font-semibold text-menta">Tu resultado</p>
    <p class="mt-1 text-3xl font-bold"><span data-ok>0</span> de {preguntas.length}</p>
    <p class="mt-2 text-base text-white/80" data-mensaje></p>
    <button type="button" data-reintentar class="boton mt-4 bg-white/10 text-white hover:bg-white/20">
      <Icon name="arrow-counter-clockwise" class="size-5" />
      Volver a intentar
    </button>
  </div>
</section>

<style>
  .opcion.es-correcta {
    background: var(--color-menta-suave);
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  .opcion.es-correcta .letra {
    background: var(--color-marca);
    color: #fff;
  }
  .opcion.es-incorrecta {
    background: var(--color-peligro-suave);
    box-shadow: inset 0 0 0 2px var(--color-peligro);
  }
  .opcion.es-incorrecta .letra {
    background: var(--color-peligro);
    color: #fff;
  }
  .explicacion.bien {
    background: var(--color-menta-suave);
  }
  .explicacion.bien .veredicto {
    color: var(--color-profundo);
  }
  .explicacion.mal {
    background: var(--color-peligro-suave);
  }
  .explicacion.mal .veredicto {
    color: var(--color-peligro);
  }
</style>

<script>
  import { guardarQuiz } from '../scripts/progreso';

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
    const slug = quiz.dataset.quiz!;
    const total = Number(quiz.dataset.total);
    const preguntas = [...quiz.querySelectorAll<HTMLElement>('[data-pregunta]')];
    const resultado = quiz.querySelector<HTMLElement>('.resultado')!;
    let respondidas = 0;
    let ok = 0;

    const mensaje = (n: number) => {
      const r = n / total;
      if (r === 1) return 'Perfecto. Tenés este módulo dominado.';
      if (r >= 0.7) return 'Muy bien. Repasá las que fallaste y seguí con el próximo módulo.';
      return 'Te conviene releer el módulo con calma y volver a intentarlo. No pasa nada: para eso está.';
    };

    preguntas.forEach((p) => {
      const correcta = Number(p.dataset.correcta);
      const botones = [...p.querySelectorAll<HTMLButtonElement>('[data-opcion]')];
      const exp = p.querySelector<HTMLElement>('.explicacion')!;
      botones.forEach((b) =>
        b.addEventListener('click', () => {
          const elegida = Number(b.dataset.opcion);
          const bien = elegida === correcta;
          botones.forEach((x) => (x.disabled = true));
          botones[correcta].classList.add('es-correcta');
          if (!bien) b.classList.add('es-incorrecta');
          exp.classList.remove('hidden');
          exp.classList.add(bien ? 'bien' : 'mal');
          exp.querySelector('.veredicto')!.textContent = bien ? 'Correcto.' : 'No es esa.';
          respondidas++;
          if (bien) ok++;
          if (respondidas === total) {
            resultado.classList.remove('hidden');
            resultado.querySelector('[data-ok]')!.textContent = String(ok);
            resultado.querySelector('[data-mensaje]')!.textContent = mensaje(ok);
            guardarQuiz(slug, ok, total);
          }
        }),
      );
    });

    quiz.querySelector('[data-reintentar]')?.addEventListener('click', () => {
      respondidas = 0;
      ok = 0;
      resultado.classList.add('hidden');
      preguntas.forEach((p) => {
        p.querySelectorAll<HTMLButtonElement>('[data-opcion]').forEach((b) => {
          b.disabled = false;
          b.classList.remove('es-correcta', 'es-incorrecta');
        });
        const exp = p.querySelector<HTMLElement>('.explicacion')!;
        exp.classList.add('hidden');
        exp.classList.remove('bien', 'mal');
      });
      quiz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
