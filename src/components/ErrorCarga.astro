---
// Cartel de las pestañas del panel de admin cuando la primera carga falla. Lo muestra y lo esconde
// arrancarPanel() (src/scripts/admin/arranque.ts); "Reintentar" vuelve a pedir los datos.
import Icon from './Icon.astro';
---

<div class="mt-8 hidden rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" role="alert" data-error-carga>
  <Icon name="wifi-slash" class="mx-auto size-10 text-ambar" />
  <p class="mt-3 text-lg font-semibold text-profundo">No se pudieron cargar los datos</p>
  <p class="mt-1 text-texto-2">Revisá la conexión a internet y probá de nuevo.</p>
  <button type="button" class="boton boton-principal mt-5" data-reintentar>Reintentar</button>
</div>
