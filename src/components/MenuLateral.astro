---
// Menú lateral de la app: en celular se abre desde la izquierda con el botón ☰ del
// encabezado; en computadora queda fijo al costado. Lista todas las góndolas por zona;
// la góndola abierta muestra sus productos y las demás los cargan al tocar la flechita.
// En el celular no repite lo que ya está en la barra de abajo (Inicio, Bienvenida, Buscar,
// Guardados, Examinarme): ahí quedan solo Fichar, Instalar, el panel de admin y las góndolas.
import { url, sinBase } from '../lib/url';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/logo-lola-circulo.png';
import Icon from './Icon.astro';
import { getGuia, porZona, urlCategoria } from '../data/guia';

const ruta = sinBase(Astro.url.pathname);
const categorias = await getGuia();
const zonas = porZona(categorias);
const actual = categorias.find((c) => ruta === `/guia/${c.id}`);
const productos = actual ? (await render(actual)).headings.filter((h) => h.depth === 3) : [];

// enBarra: también está en la barra de abajo del celular, así que en el celular no se repite acá.
const principales = [
  { href: url('/'), icono: 'house', label: 'Inicio', activa: ruta === '/', enBarra: true },
  { href: url('/bienvenida'), icono: 'hand-waving', label: 'Bienvenida', activa: ruta.startsWith('/bienvenida'), enBarra: true },
  { href: url('/buscar'), icono: 'magnifying-glass', label: 'Buscar', activa: ruta.startsWith('/buscar'), enBarra: true },
  { href: url('/guardados'), icono: 'star', label: 'Guardados', activa: ruta.startsWith('/guardados'), enBarra: true },
  { href: url('/examen'), icono: 'exam', label: 'Examinarme', activa: ruta.startsWith('/examen'), enBarra: true },
  { href: url('/fichar'), icono: 'qr-code', label: 'Fichar', activa: ruta.startsWith('/fichar'), enBarra: false },
];
---

<aside id="menu-lateral" class="menu no-print" aria-label="Menú principal" data-menu>
  <div class="menu-cabeza">
    <Image src={logo} alt="" width={48} height={48} class="size-12 rounded-full shadow-[0_6px_20px_rgb(33_76_59/0.15)]" />
    <span class="min-w-0 flex-1">
      <span class="block text-base leading-tight font-bold text-profundo">La Almacén de Lola</span>
      <span class="block text-sm text-texto-2">Intranet del equipo</span>
    </span>
    <button type="button" class="flex size-11 items-center justify-center rounded-full text-profundo hover:bg-menta-suave" aria-label="Cerrar el menú" data-menu-cerrar>
      <Icon name="x" class="size-6" />
    </button>
  </div>

  <nav class="menu-cuerpo" data-menu-cuerpo>
    <ul class="flex flex-col gap-0.5">
      {
        principales.map((p) => (
          <li class:list={[p.enBarra && 'solo-compu']}>
            <a href={p.href} class="menu-item" aria-current={p.activa ? 'page' : undefined}>
              <Icon name={p.icono} class="size-5 shrink-0" />
              {p.label}
            </a>
          </li>
        ))
      }
      <!-- El panel tiene cuatro partes: Inicio (/admin), Horarios y fichajes (/fichadas), Gestión de equipo (/equipo) y Aprendizaje (/aprendizaje). -->
      <li class="hidden" data-solo-admin>
        <a href={url('/admin')} class="menu-item" aria-current={['/admin', '/fichadas', '/equipo', '/aprendizaje'].some((r) => ruta.startsWith(r)) ? 'page' : undefined}>
          <Icon name="users-three" class="size-5 shrink-0" />
          Panel de admin
        </a>
      </li>
      <li class="solo-navegador">
        <a href={url('/instalar')} class="menu-item" aria-current={ruta.startsWith('/instalar') ? 'page' : undefined}>
          <Icon name="download-simple" class="size-5 shrink-0" />
          Instalar la app
        </a>
      </li>
    </ul>

    <p class="menu-titulo">Góndolas</p>
    {
      zonas.map((z) => (
        <div class="mt-3">
          <p class="menu-zona">{z.nombre}</p>
          <ul class="flex flex-col gap-0.5">
            {z.categorias.map((c) => {
              const esActual = actual?.id === c.id;
              return (
                <li data-menu-gondola={c.id}>
                  <div class="flex items-center gap-1">
                    <a href={urlCategoria(c)} class="menu-item flex-1" aria-current={esActual ? 'page' : undefined}>
                      <Icon name={c.data.icono} class="size-5 shrink-0" />
                      <span class="min-w-0 flex-1">{c.data.titulo}</span>
                    </a>
                    <button
                      type="button"
                      class="menu-flecha"
                      aria-expanded={esActual ? 'true' : 'false'}
                      aria-controls={`menu-${c.id}`}
                      aria-label={`Ver los productos de ${c.data.titulo}`}
                      data-menu-flecha
                    >
                      <Icon name="caret-down" class="size-4" />
                    </button>
                  </div>
                  <ul id={`menu-${c.id}`} class="menu-productos" hidden={!esActual}>
                    {esActual &&
                      productos.map((h) => (
                        <li>
                          <a href={`#${h.slug}`} data-producto={h.slug}>
                            {h.text}
                          </a>
                        </li>
                      ))}
                  </ul>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

  </nav>
</aside>
<div class="menu-fondo no-print lg:hidden" data-menu-cerrar aria-hidden="true"></div>

<style>
  .menu {
    display: flex;
    flex-direction: column;
    background: var(--color-crema);
  }
  .menu-cabeza {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: calc(14px + env(safe-area-inset-top)) 12px 14px 18px;
    border-bottom: 1px solid rgb(33 76 59 / 0.08);
  }
  .menu-cuerpo {
    position: relative;
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 14px 12px calc(28px + env(safe-area-inset-bottom));
  }
  .menu-titulo {
    margin: 22px 10px 0;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-profundo);
  }
  .menu-zona {
    margin: 0 10px 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-marca-texto);
  }
  .menu :global(.menu-item) {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    border-radius: var(--radius-chico);
    padding: 9px 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-texto);
    transition: background-color 200ms;
  }
  .menu :global(.menu-item svg) {
    color: var(--color-marca-texto);
  }
  .menu :global(.menu-item:hover) {
    background: var(--color-menta-suave);
  }
  .menu :global(.menu-item[aria-current='page']) {
    background: var(--color-menta);
    color: var(--color-profundo);
  }
  .menu :global(.menu-item[aria-current='page'] svg) {
    color: var(--color-profundo);
  }
  .menu-flecha {
    display: flex;
    width: 44px;
    height: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-texto-2);
  }
  .menu-flecha:hover {
    background: var(--color-menta-suave);
  }
  .menu-flecha :global(svg) {
    transition: transform 250ms var(--ease-fluid);
  }
  .menu-flecha[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .menu-productos {
    margin: 2px 0 8px 27px;
    border-left: 2px solid var(--color-menta);
    padding-left: 8px;
  }
  .menu-productos :global(a) {
    display: flex;
    min-height: 44px;
    align-items: center;
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--color-texto-2);
  }
  .menu-productos :global(a:hover) {
    background: var(--color-menta-suave);
    color: var(--color-profundo);
  }
  .menu-productos :global(a[aria-current='true']) {
    background: var(--color-menta-suave);
    font-weight: 700;
    color: var(--color-profundo);
  }
  .menu-productos :global(.cargando) {
    padding: 6px 10px;
    font-size: 0.875rem;
    color: var(--color-texto-2);
  }
  .menu-productos :global(.reintentar) {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-top: 2px;
    border-radius: 10px;
    padding: 0 10px;
    font-weight: 700;
    color: var(--color-profundo);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Celular y tablet: cajón que entra desde la izquierda */
  @media (max-width: 1023px) {
    .menu {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 70;
      width: min(86vw, 340px);
      transform: translateX(-102%);
      visibility: hidden;
      box-shadow: 24px 0 60px -20px rgb(33 76 59 / 0.35);
      transition:
        transform 320ms var(--ease-fluid),
        visibility 0s 320ms;
    }
    :global(html.menu-abierto) .menu {
      transform: none;
      visibility: visible;
      transition: transform 320ms var(--ease-fluid);
    }
    .menu-fondo {
      position: fixed;
      inset: 0;
      z-index: 65;
      background: rgb(20 40 31 / 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity 320ms var(--ease-fluid);
    }
    :global(html.menu-abierto) .menu-fondo {
      opacity: 1;
      pointer-events: auto;
    }
    :global(html.menu-abierto) {
      overflow: hidden;
    }
    /* Lo que ya está en la barra de abajo no se repite en el cajón */
    .solo-compu {
      display: none;
    }
  }

  /* Computadora: columna fija al costado */
  @media (min-width: 1024px) {
    .menu {
      position: sticky;
      top: 64px;
      height: calc(100svh - 64px);
      width: 300px;
      flex: none;
      border-right: 1px solid rgb(33 76 59 / 0.08);
    }
    /* El logo ya está en el encabezado */
    .menu-cabeza {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu-fondo {
      transition: none !important;
    }
  }
</style>

<script>
  import { cargarFichas } from '../scripts/app';

  const raiz = document.documentElement;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const cuerpo = menu.querySelector<HTMLElement>('[data-menu-cuerpo]')!;
  const abrir = document.querySelector<HTMLButtonElement>('[data-menu-abrir]');
  const escritorio = matchMedia('(min-width: 1024px)');

  const abierto = () => raiz.classList.contains('menu-abierto');
  function cerrar() {
    if (!abierto()) return;
    raiz.classList.remove('menu-abierto');
    abrir?.setAttribute('aria-expanded', 'false');
    abrir?.focus();
  }
  function mostrar() {
    raiz.classList.add('menu-abierto');
    abrir?.setAttribute('aria-expanded', 'true');
    llevarAlActivo();
    menu.querySelector<HTMLElement>('[data-menu-cerrar]')?.focus();
  }

  // Deja visible en el menú la góndola o la sección en la que estás.
  function llevarAlActivo() {
    const activo = cuerpo.querySelector<HTMLElement>('[aria-current="page"]');
    if (activo) cuerpo.scrollTop = Math.max(0, activo.offsetTop - cuerpo.clientHeight / 3);
  }

  abrir?.addEventListener('click', () => (abierto() ? cerrar() : mostrar()));
  document.querySelectorAll('[data-menu-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrar();
  });
  // Tocar un producto de la misma página cierra el cajón para ver la ficha.
  menu.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (a && !escritorio.matches) raiz.classList.remove('menu-abierto');
  });
  escritorio.addEventListener('change', () => raiz.classList.remove('menu-abierto'));
  llevarAlActivo();

  // Flechitas: muestran los productos de cada góndola (las otras góndolas los traen de fichas.json).
  menu.querySelectorAll<HTMLButtonElement>('[data-menu-flecha]').forEach((b) => {
    b.addEventListener('click', async () => {
      const lista = document.getElementById(b.getAttribute('aria-controls')!)!;
      const ver = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(ver));
      lista.hidden = !ver;
      if (!ver || lista.childElementCount) return;
      const gondola = b.closest<HTMLElement>('[data-menu-gondola]')!.dataset.menuGondola;
      lista.innerHTML = '<li class="cargando">Cargando…</li>';
      try {
        const fichas = (await cargarFichas()).filter((f) => f.gondolaId === gondola);
        lista.replaceChildren(
          ...fichas.map((f) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = f.url;
            a.textContent = f.titulo;
            li.append(a);
            return li;
          }),
        );
      } catch {
        // Sin conexión: mensaje con un botón para volver a probar (la flechita queda abierta).
        const li = document.createElement('li');
        li.className = 'cargando';
        li.textContent = 'No se pudo cargar. ';
        const otra = document.createElement('button');
        otra.type = 'button';
        otra.className = 'reintentar';
        otra.textContent = 'Probar de nuevo';
        otra.addEventListener('click', () => {
          lista.replaceChildren();
          b.setAttribute('aria-expanded', 'false');
          b.click();
        });
        li.append(otra);
        lista.replaceChildren(li);
      }
    });
  });

  // En una góndola, marca en el menú el producto que estás leyendo.
  const enlaces = new Map(
    [...menu.querySelectorAll<HTMLAnchorElement>('[data-producto]')].map((a) => [a.dataset.producto!, a] as const),
  );
  if (enlaces.size) {
    let marcado: HTMLAnchorElement | undefined;
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          const a = enlaces.get(e.target.id);
          if (!a || a === marcado) continue;
          marcado?.removeAttribute('aria-current');
          a.setAttribute('aria-current', 'true');
          marcado = a;
          // Acompaña el scroll del menú en computadora.
          if (escritorio.matches) {
            const arriba = a.offsetTop - cuerpo.scrollTop;
            if (arriba < 40 || arriba > cuerpo.clientHeight - 60) cuerpo.scrollTop = a.offsetTop - cuerpo.clientHeight / 2;
          }
        }
      },
      { rootMargin: '-90px 0px -65% 0px' },
    );
    document.querySelectorAll('.ficha h3[id]').forEach((h) => observador.observe(h));
  }
</script>
