---
// Íconos Phosphor (variante light) embebidos como SVG en línea.
interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-6', label } = Astro.props;

// Solo los íconos que usa la app.
// Si sumás uno, agregalo a la lista (los nombres son los de node_modules/@phosphor-icons/core/assets/light).
const icons = import.meta.glob<string>(
  '/node_modules/@phosphor-icons/core/assets/light/{hand-waving,storefront,book-open-text,heartbeat,tag,grains-slash,warning-circle,drop,plant,leaf,coffee,tea-bag,nut,grains,bowl-food,drop-half,jar-label,barbell,cookie,snowflake,clipboard-text,question,users-three,cube,flask,bread,egg-crack,orange-slice,pepper,sparkle,shield-check,list-checks,thermometer-cold,calendar-check,basket,fire,magnifying-glass,printer,arrow-left,arrow-right,check,check-circle,x-circle,clock,list,file-pdf,warning,lightbulb,map-pin,seal-question,arrow-counter-clockwise,arrow-clockwise,play,pause,speaker-x,caret-down,info,x,cards,star,download-simple,export,plus-square,squares-four,shuffle,arrows-clockwise,device-mobile,wifi-slash,house,exam,trophy,target,smiley,cash-register,notebook,receipt,percent,broom,package,truck,hand-heart,chat-circle-dots,seal-check,lock-key,fork-knife,power,bicycle,t-shirt,user-circle,sneaker,door,timer,instagram-logo,briefcase,music-notes,speaker-low,guitar,headphones,spotify-logo,handshake,device-mobile-slash,heart,dots-three-vertical,dots-three,share-network,copy,android-logo,apple-logo,lightning,arrow-square-out,qr-code,user-focus,seal-warning,calendar-blank,caret-left,caret-right,desktop,wifi-high,arrows-out,flower,acorn,bowl-steam,cooking-pot,pint-glass,cheese,carrot,beer-bottle,hand-soap,sign-out,cloud-arrow-up,gear-six,chart-bar,user-gear}-light.svg',
  { query: '?raw', import: 'default', eager: true },
);

const raw = icons[`/node_modules/@phosphor-icons/core/assets/light/${name}-light.svg`];
if (!raw) throw new Error(`Ícono Phosphor inexistente o no listado en Icon.astro: ${name}`);

const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
const svg = raw.replace('<svg ', `<svg class="${className}" ${a11y} `);
---

<Fragment set:html={svg} />
