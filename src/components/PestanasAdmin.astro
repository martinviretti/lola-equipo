---
// Encabezado del Panel de admin, con sus cuatro partes (cada una es una página):
//  · Inicio: lo que hay que mirar hoy y los pendientes.
//  · Horarios y fichajes: quién vino, las horas de la semana y las correcciones.
//  · Gestión de equipo: altas, bajas y la ficha de cada persona.
//  · Aprendizaje: el avance en la guía y los exámenes.
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  activa: 'inicio' | 'fichaje' | 'equipo' | 'aprendizaje';
}
const { activa } = Astro.props;
const pestanas = [
  { id: 'inicio', href: url('/admin'), icono: 'house', texto: 'Inicio', sub: 'Lo que hay que mirar hoy' },
  { id: 'fichaje', href: url('/fichadas'), icono: 'clock', texto: 'Horarios y fichajes', sub: 'Quién vino, horas y correcciones' },
  { id: 'equipo', href: url('/equipo'), icono: 'users-three', texto: 'Gestión de equipo', sub: 'Altas, bajas y la ficha de cada una' },
  { id: 'aprendizaje', href: url('/aprendizaje'), icono: 'book-open-text', texto: 'Aprendizaje', sub: 'Avance en la guía y exámenes' },
];
---

<h1 class="titulo-degrade text-4xl font-bold tracking-tight">Panel de admin</h1>
<nav class="pestanas mt-5" aria-label="Partes del panel de admin">
  {
    pestanas.map((p) => (
      <a href={p.href} class:list={['pestana', { activa: p.id === activa }]} aria-current={p.id === activa ? 'page' : undefined}>
        <Icon name={p.icono} class="size-6 shrink-0" />
        <span class="min-w-0 text-left leading-tight">
          <span class="block font-bold">{p.texto}</span>
          <span class="block text-xs">{p.sub}</span>
        </span>
      </a>
    ))
  }
</nav>

<style>
  .pestanas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    border-radius: 22px;
    background: var(--color-menta-suave);
    padding: 6px;
  }
  @media (min-width: 900px) {
    .pestanas {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pestana {
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 16px;
    padding: 10px 12px;
    color: var(--color-texto-2);
    transition:
      background 160ms,
      color 160ms;
  }
  .pestana:hover {
    background: rgb(255 255 255 / 0.55);
    color: var(--color-profundo);
  }
  .pestana.activa {
    background: #fff;
    color: var(--color-profundo);
    box-shadow: 0 8px 24px -14px rgb(33 76 59 / 0.6);
  }
  .pestana.activa :global(svg) {
    color: var(--color-marca);
  }
</style>
