---
// Cartel A4 para plastificar y pegar en la góndola. Todas las medidas van en cqw
// (porcentaje del ancho del cartel): así la vista previa en pantalla es una réplica
// exacta, a escala, de la hoja impresa. 100cqw = 210 mm.
// La tabla "guía" muestra como máximo 4 filas para que todo entre en la hoja.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/logo-lola-circulo.png';

export interface DatosCartel {
  slug: string;
  sector: string;
  titulo: string;
  icono: string;
  intro: string;
  datos: { titulo: string; texto: string }[];
  sabias: string;
  guiaTitulo?: string;
  guia?: { nombre: string; texto: string }[];
}

interface Props {
  cartel: DatosCartel;
}

const { cartel: c } = Astro.props;
---

<div class="cartel-marco">
  <article class="cartel" aria-label={`Cartel: ${c.sector}`}>
    <div class="cartel-hojas fondo-hojas" aria-hidden="true"></div>

    <header class="cartel-cabecera">
      <div class="cartel-marca">
        <Image src={logo} alt="" width={150} height={150} class="cartel-logo" />
        <span>El Almacén de Lola</span>
      </div>
      <span class="cartel-sector">{c.sector}</span>
    </header>

    <div class="cartel-titulo">
      <div class="cartel-titulo-fila">
        <span class="cartel-icono"><Icon name={c.icono} class="cartel-icono-svg" /></span>
        <h2>{c.titulo}</h2>
      </div>
      <p>{c.intro}</p>
    </div>

    <ul class="cartel-datos">
      {
        c.datos.map((d) => (
          <li>
            <strong>{d.titulo}</strong>
            <span>{d.texto}</span>
          </li>
        ))
      }
    </ul>

    <aside class="cartel-sabias">
      <span class="cartel-sabias-etiqueta">¿Sabías que…?</span>
      <p>{c.sabias}</p>
    </aside>

    {
      c.guia && c.guia.length > 0 && (
        <section class="cartel-guia">
          <p class="cartel-guia-titulo">{c.guiaTitulo ?? 'Elegí el tuyo'}</p>
          <dl>
            {c.guia.slice(0, 4).map((g) => (
              <div>
                <dt>{g.nombre}</dt>
                <dd>{g.texto}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <footer class="cartel-pie">
      <span>¿Tenés dudas? Preguntanos, estamos para ayudarte.</span>
      <span>@lolasaludable</span>
    </footer>
  </article>
</div>

<style>
  .cartel-marco {
    container-type: inline-size;
    width: 100%;
  }
  .cartel {
    position: relative;
    overflow: hidden;
    aspect-ratio: 210 / 297;
    background: var(--color-crema);
    color: var(--color-texto);
    padding: 5.5cqw 6.5cqw 4.5cqw;
    display: flex;
    flex-direction: column;
    gap: 2.2cqw;
    border-radius: 2cqw;
    box-shadow: 0 0 0 1px rgb(33 76 59 / 0.1), 0 2cqw 6cqw -3cqw rgb(33 76 59 / 0.35);
  }
  .cartel-hojas {
    position: absolute;
    inset: 0 0 auto 0;
    height: 38%;
    background-size: 22cqw 22cqw;
    opacity: 0.8;
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }
  .cartel > *:not(.cartel-hojas) {
    position: relative;
  }

  .cartel-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cartel-marca {
    display: flex;
    align-items: center;
    gap: 2cqw;
    font-size: 2.3cqw;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .cartel-logo {
    width: 8cqw;
    height: 8cqw;
    border-radius: 50%;
    box-shadow: 0 1cqw 3cqw rgb(33 76 59 / 0.15);
  }
  .cartel-sector {
    border-radius: 999px;
    background: var(--color-profundo);
    color: #fff;
    padding: 1.2cqw 3cqw;
    font-size: 2.2cqw;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .cartel-titulo {
    margin-top: 0.5cqw;
  }
  .cartel-titulo-fila {
    display: flex;
    align-items: center;
    gap: 3cqw;
  }
  .cartel-icono {
    display: inline-flex;
    flex: none;
    width: 10.5cqw;
    height: 10.5cqw;
    align-items: center;
    justify-content: center;
    border-radius: 3.2cqw;
    background: var(--color-menta);
    color: var(--color-profundo);
  }
  .cartel-icono :global(.cartel-icono-svg) {
    width: 6.5cqw;
    height: 6.5cqw;
  }
  .cartel-titulo h2 {
    font-size: 5.8cqw;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-profundo);
    text-wrap: balance;
  }
  .cartel-titulo p {
    margin-top: 1.6cqw;
    font-size: 2.4cqw;
    line-height: 1.4;
    color: var(--color-texto-2);
    max-width: 85%;
  }

  .cartel-datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.8cqw;
  }
  .cartel-datos li {
    display: flex;
    flex-direction: column;
    gap: 0.8cqw;
    border-radius: 2.6cqw;
    background: #fff;
    padding: 2cqw 2.4cqw;
    box-shadow: inset 0 0 0 0.25cqw rgb(33 76 59 / 0.08);
  }
  .cartel-datos strong {
    font-size: 2.35cqw;
    line-height: 1.2;
    font-weight: 800;
    color: var(--color-profundo);
  }
  .cartel-datos span {
    font-size: 1.95cqw;
    line-height: 1.38;
  }

  .cartel-sabias {
    border-radius: 2.6cqw;
    background: var(--color-profundo);
    color: #fff;
    padding: 2.4cqw 3cqw;
  }
  .cartel-sabias-etiqueta {
    font-size: 2.2cqw;
    font-weight: 800;
    color: var(--color-menta);
  }
  .cartel-sabias p {
    margin-top: 0.6cqw;
    font-size: 2.15cqw;
    line-height: 1.4;
  }

  .cartel-guia-titulo {
    font-size: 2.5cqw;
    font-weight: 800;
    color: var(--color-profundo);
  }
  .cartel-guia dl {
    margin-top: 1.2cqw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3cqw;
  }
  .cartel-guia dl > div {
    display: flex;
    gap: 1.5cqw;
    border-bottom: 0.25cqw solid rgb(33 76 59 / 0.12);
    padding: 0.8cqw 0;
    font-size: 1.9cqw;
    line-height: 1.35;
  }
  .cartel-guia dt {
    flex: none;
    font-weight: 800;
    color: var(--color-marca);
  }

  .cartel-pie {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    border-top: 0.3cqw solid rgb(33 76 59 / 0.15);
    padding-top: 2cqw;
    font-size: 2cqw;
    font-weight: 700;
    color: var(--color-profundo);
  }

  @media print {
    .cartel-marco {
      width: 210mm;
      page: portada;
      break-after: page;
    }
    .cartel {
      width: 210mm;
      height: 297mm;
      aspect-ratio: auto;
      border-radius: 0;
      box-shadow: none;
    }
  }
</style>
