---
// Fila "Instalá la app" para el inicio. Solo aparece en el celular y mientras la app no esté
// instalada. Cerrada es una fila fina; "Cómo" despliega los pasos del teléfono y navegador que la
// abrió (src/scripts/instalar.ts). En Android con el aviso de Chrome, "Instalar" la instala directo.
import { url } from '../lib/url';
import Icon from './Icon.astro';

const { class: clase } = Astro.props;
---

<section class:list={['instalar', clase]} data-instalar-tarjeta aria-labelledby="instalar-titulo" hidden>
  <div class="instalar-fila">
    <img src={url('/iconos/icono-192.png')} alt="" width="36" height="36" class="hidden size-9 shrink-0 rounded-xl min-[380px]:block" />
    <div class="min-w-0 flex-1">
      <p id="instalar-titulo" class="leading-tight font-bold text-profundo">Instalá la app</p>
      <p class="mt-0.5 text-sm leading-snug text-texto-2">Anda sin internet.</p>
    </div>
    <button type="button" class="instalar-accion" data-instalar-boton hidden>Instalar</button>
    <button type="button" class="instalar-accion" aria-expanded="false" aria-controls="instalar-detalle" data-instalar-ver hidden>
      Cómo <Icon name="caret-down" class="instalar-flecha size-4" />
    </button>
    <button
      type="button"
      class="tap -mr-2 flex shrink-0 items-center justify-center rounded-full text-texto-2 hover:bg-menta-suave"
      aria-label="Ahora no"
      data-instalar-cerrar
    >
      <Icon name="x" class="size-5" />
    </button>
  </div>

  <div id="instalar-detalle" class="instalar-detalle" data-instalar-detalle hidden>
    <!-- Android sin el aviso: menú del navegador -->
    <ol class="pasos-instalar" data-caso="android-menu" hidden>
      <li><span class="num">1</span><span>Tocá <span class="chip"><Icon name="dots-three-vertical" class="size-4" /></span> arriba a la derecha de Chrome.</span></li>
      <li><span class="num">2</span><span>Elegí <strong>Instalar aplicación</strong> o <strong>Agregar a la pantalla principal</strong>.</span></li>
      <li><span class="num">3</span><span>Confirmá con <strong>Instalar</strong>. ¡Listo!</span></li>
    </ol>

    <!-- iPhone con Safari -->
    <ol class="pasos-instalar" data-caso="ios-safari" hidden>
      <li>
        <span class="num">1</span><span>Tocá <span class="chip"><Icon name="export" class="size-4" /></span> <strong>Compartir</strong>. Si no lo ves, tocá
          primero <span class="chip"><Icon name="dots-three" class="size-4" /></span> abajo.</span>
      </li>
      <li><span class="num">2</span><span>Elegí <span class="chip"><Icon name="plus-square" class="size-4" /></span> <strong>Agregar a pantalla de inicio</strong>.</span></li>
      <li><span class="num">3</span><span>Tocá <strong>Agregar</strong>. ¡Listo!</span></li>
    </ol>

    <!-- iPhone con otro navegador -->
    <div data-caso="ios-otro" hidden>
      <p class="text-[0.95rem]">En iPhone la app se instala desde <strong>Safari</strong>. Copiá el link y pegalo en Safari.</p>
      <button type="button" class="boton boton-principal mt-3 w-full" data-instalar-copiar>
        <Icon name="copy" class="size-5" /> <span data-copiar-texto>Copiar el link</span>
      </button>
    </div>

    <!-- Dentro de Instagram, Facebook, TikTok… -->
    <div data-caso="app-interna" hidden>
      <p class="text-[0.95rem]">
        La abriste dentro de otra app. Para instalarla, tocá <span class="chip"><Icon name="dots-three" class="size-4" /></span> y elegí <strong>Abrir en el navegador</strong>.
        O copiá el link y pegalo en Chrome o Safari.
      </p>
      <button type="button" class="boton boton-principal mt-3 w-full" data-instalar-copiar>
        <Icon name="copy" class="size-5" /> <span data-copiar-texto>Copiar el link</span>
      </button>
    </div>

    <div class="mt-2 flex flex-wrap items-center justify-between gap-x-3 text-sm">
      <a href={url('/instalar')} class="inline-flex min-h-11 items-center font-semibold text-profundo underline underline-offset-4">Ver paso a paso</a>
      <button type="button" class="inline-flex min-h-11 items-center font-semibold text-texto-2 underline underline-offset-4" data-instalar-listo hidden>
        Ya la instalé
      </button>
    </div>
  </div>
</section>

<style>
  .instalar {
    border-radius: var(--radius-tarjeta);
    background: #fff;
    padding: 10px 12px 10px 12px;
    box-shadow: var(--shadow-reposo);
  }
  .instalar-fila {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .instalar-accion {
    display: inline-flex;
    min-height: 44px;
    flex: none;
    align-items: center;
    gap: 6px;
    border-radius: 9999px;
    background: var(--color-profundo);
    padding: 0 16px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
  }
  .instalar-accion[hidden] {
    display: none;
  }
  .instalar-flecha {
    transition: transform 250ms var(--ease-fluid);
  }
  .instalar-accion[aria-expanded='true'] .instalar-flecha {
    transform: rotate(180deg);
  }
  .instalar-detalle {
    margin-top: 10px;
    border-top: 1px solid rgb(33 76 59 / 0.08);
    padding-top: 12px;
  }
  .instalar :global(strong) {
    color: var(--color-profundo);
  }
  .pasos-instalar {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pasos-instalar li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border-radius: var(--radius-chico);
    background: var(--color-crema);
    padding: 10px 12px;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .num {
    display: flex;
    width: 24px;
    height: 24px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-menta);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-profundo);
  }
  .chip {
    display: inline-flex;
    width: 26px;
    height: 26px;
    vertical-align: middle;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--color-menta-suave);
    color: var(--color-profundo);
  }
</style>

<script>
  import { caso, alCambiar, instalar, ocultarTarjeta, tarjetaOculta, copiarEnlace } from '../scripts/instalar';

  const tarjeta = document.querySelector<HTMLElement>('[data-instalar-tarjeta]');
  if (tarjeta) {
    const botonInstalar = tarjeta.querySelector<HTMLButtonElement>('[data-instalar-boton]')!;
    const botonVer = tarjeta.querySelector<HTMLButtonElement>('[data-instalar-ver]')!;
    const detalle = tarjeta.querySelector<HTMLElement>('[data-instalar-detalle]')!;
    const pintar = () => {
      const c = caso();
      const mostrar = c !== 'instalada' && c !== 'computadora' && !tarjetaOculta();
      tarjeta.hidden = !mostrar;
      tarjeta.querySelectorAll<HTMLElement>('[data-caso]').forEach((b) => (b.hidden = b.dataset.caso !== c));
      // Con el aviso de Chrome alcanza un botón; en los demás casos, "Cómo" muestra los pasos.
      botonInstalar.hidden = c !== 'android-boton';
      botonVer.hidden = c === 'android-boton';
      if (c === 'android-boton') detalle.hidden = true;
      // En iPhone no se puede saber si ya la instaló desde Safari: se lo preguntamos.
      tarjeta.querySelector<HTMLElement>('[data-instalar-listo]')!.hidden = !c.startsWith('ios');
    };
    const cerrar = () => {
      ocultarTarjeta();
      tarjeta.hidden = true;
    };
    botonVer.addEventListener('click', () => {
      const ver = detalle.hidden;
      detalle.hidden = !ver;
      botonVer.setAttribute('aria-expanded', String(ver));
    });
    tarjeta.querySelector('[data-instalar-cerrar]')?.addEventListener('click', cerrar);
    tarjeta.querySelector('[data-instalar-listo]')?.addEventListener('click', cerrar);
    botonInstalar.addEventListener('click', async () => {
      if (await instalar()) tarjeta.hidden = true;
    });
    tarjeta.querySelectorAll<HTMLButtonElement>('[data-instalar-copiar]').forEach((b) =>
      b.addEventListener('click', async () => {
        const ok = await copiarEnlace();
        const t = b.querySelector('[data-copiar-texto]');
        if (t) t.textContent = ok ? '¡Link copiado!' : 'No se pudo copiar: mantené apretada la dirección y copiala a mano';
      }),
    );
    alCambiar(pintar);
    pintar();
  }
</script>
