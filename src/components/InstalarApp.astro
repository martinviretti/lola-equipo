---
// Tarjeta "Instalá la app de Lola" para el inicio. Solo aparece en el celular y mientras la app
// no esté instalada; muestra los pasos del teléfono y navegador que la abrió (src/scripts/instalar.ts).
import { url } from '../lib/url';
import Icon from './Icon.astro';

const { class: clase } = Astro.props;
---

<section class:list={['instalar', clase]} data-instalar-tarjeta aria-labelledby="instalar-titulo" hidden>
  <div class="flex items-start gap-3">
    <img src={url('/iconos/icono-192.png')} alt="" width="56" height="56" class="size-14 shrink-0 rounded-2xl shadow-[0_6px_18px_rgb(0_0_0/0.25)]" />
    <div class="min-w-0 flex-1">
      <p id="instalar-titulo" class="text-lg leading-tight font-bold">Instalá la app de Lola</p>
      <p class="mt-1 text-sm text-white/80">Queda en tu pantalla de inicio, se abre en un toque y funciona sin internet.</p>
    </div>
    <button type="button" class="-mt-1 -mr-1 flex size-9 shrink-0 items-center justify-center rounded-full text-white/70 hover:bg-white/10" aria-label="Ahora no" data-instalar-cerrar>
      <Icon name="x" class="size-5" />
    </button>
  </div>

  <!-- Android con el aviso de Chrome: un botón -->
  <div class="mt-4" data-caso="android-boton" hidden>
    <button type="button" class="boton-instalar" data-instalar-boton>
      <Icon name="download-simple" class="size-6" /> Instalar la app
    </button>
  </div>

  <!-- Android sin el aviso: menú del navegador -->
  <ol class="pasos-instalar" data-caso="android-menu" hidden>
    <li><span class="num">1</span><span>Tocá <span class="chip"><Icon name="dots-three-vertical" class="size-4" /></span> arriba a la derecha de Chrome.</span></li>
    <li><span class="num">2</span><span>Elegí <strong>Instalar aplicación</strong> o <strong>Agregar a la pantalla principal</strong>.</span></li>
    <li><span class="num">3</span><span>Confirmá con <strong>Instalar</strong>. ¡Listo!</span></li>
  </ol>

  <!-- iPhone con Safari -->
  <ol class="pasos-instalar" data-caso="ios-safari" hidden>
    <li>
      <span class="num">1</span><span>Tocá <span class="chip"><Icon name="export" class="size-4" /></span> <strong>Compartir</strong>. Si no lo ves, tocá
        primero <span class="chip"><Icon name="dots-three" class="size-4" /></span> abajo.</span>
    </li>
    <li><span class="num">2</span><span>Elegí <span class="chip"><Icon name="plus-square" class="size-4" /></span> <strong>Agregar a pantalla de inicio</strong>.</span></li>
    <li><span class="num">3</span><span>Tocá <strong>Agregar</strong>. ¡Listo!</span></li>
  </ol>

  <!-- iPhone con otro navegador -->
  <div class="mt-4" data-caso="ios-otro" hidden>
    <p class="text-[0.95rem]">En iPhone la app se instala desde <strong>Safari</strong>. Copiá el link y pegalo en Safari.</p>
    <button type="button" class="boton-instalar mt-3" data-instalar-copiar>
      <Icon name="copy" class="size-5" /> <span data-copiar-texto>Copiar el link</span>
    </button>
  </div>

  <!-- Dentro de Instagram, Facebook, TikTok… -->
  <div class="mt-4" data-caso="app-interna" hidden>
    <p class="text-[0.95rem]">
      La abriste dentro de otra app. Para instalarla, tocá <span class="chip"><Icon name="dots-three" class="size-4" /></span> y elegí <strong>Abrir en el navegador</strong>.
      O copiá el link y pegalo en Chrome o Safari.
    </p>
    <button type="button" class="boton-instalar mt-3" data-instalar-copiar>
      <Icon name="copy" class="size-5" /> <span data-copiar-texto>Copiar el link</span>
    </button>
  </div>

  <div class="mt-4 flex items-center justify-between gap-3 text-sm">
    <a href={url('/instalar')} class="font-semibold text-menta underline underline-offset-4">Ver paso a paso</a>
    <button type="button" class="font-semibold text-white/80 underline underline-offset-4" data-instalar-listo hidden>Ya la instalé</button>
  </div>
</section>

<style>
  .instalar {
    border-radius: 26px;
    background: linear-gradient(145deg, var(--color-profundo), #2d6a55);
    padding: 18px;
    color: #fff;
    box-shadow: 0 22px 44px -26px rgb(33 76 59 / 0.75);
  }
  .instalar :global(strong) {
    color: #fff;
  }
  .boton-instalar {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    background: var(--color-menta);
    padding: 14px 18px;
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-profundo);
    transition: transform 200ms var(--ease-fluid);
  }
  .boton-instalar:active {
    transform: scale(0.97);
  }
  .pasos-instalar {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pasos-instalar li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.1);
    padding: 10px 12px;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .num {
    display: flex;
    width: 24px;
    height: 24px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-menta);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-profundo);
  }
  .chip {
    display: inline-flex;
    width: 26px;
    height: 26px;
    vertical-align: middle;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #fff;
    color: var(--color-profundo);
  }
</style>

<script>
  import { caso, alCambiar, instalar, ocultarTarjeta, tarjetaOculta, copiarEnlace } from '../scripts/instalar';

  const tarjeta = document.querySelector<HTMLElement>('[data-instalar-tarjeta]');
  if (tarjeta) {
    const pintar = () => {
      const c = caso();
      const mostrar = c !== 'instalada' && c !== 'computadora' && !tarjetaOculta();
      tarjeta.hidden = !mostrar;
      tarjeta.querySelectorAll<HTMLElement>('[data-caso]').forEach((b) => (b.hidden = b.dataset.caso !== c));
      // En iPhone no se puede saber si ya la instaló desde Safari: se lo preguntamos.
      tarjeta.querySelector<HTMLElement>('[data-instalar-listo]')!.hidden = !c.startsWith('ios');
    };
    const cerrar = () => {
      ocultarTarjeta();
      tarjeta.hidden = true;
    };
    tarjeta.querySelector('[data-instalar-cerrar]')?.addEventListener('click', cerrar);
    tarjeta.querySelector('[data-instalar-listo]')?.addEventListener('click', cerrar);
    tarjeta.querySelector('[data-instalar-boton]')?.addEventListener('click', async () => {
      if (await instalar()) tarjeta.hidden = true;
    });
    tarjeta.querySelectorAll<HTMLButtonElement>('[data-instalar-copiar]').forEach((b) =>
      b.addEventListener('click', async () => {
        const ok = await copiarEnlace();
        const t = b.querySelector('[data-copiar-texto]');
        if (t) t.textContent = ok ? '¡Link copiado!' : 'No se pudo copiar';
      }),
    );
    alCambiar(pintar);
    pintar();
  }
</script>
