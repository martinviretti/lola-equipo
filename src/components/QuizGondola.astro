---
// Repaso corto al final de cada góndola (src/data/quiz/<id>.json): 5 preguntas, de a una,
// con la respuesta al instante. Con 4 bien o más, la góndola queda completada.
// Mientras se responde, <html> lleva la clase "repaso-en-curso" (la página de la góndola
// esconde "Otras góndolas" con eso).
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { getGuia, urlCategoria } from '../data/guia';

interface Props {
  gondolaId: string;
  titulo: string;
  siguiente?: { url: string; titulo: string };
}

const { gondolaId, titulo, siguiente } = Astro.props;
const quizzes = import.meta.glob<{ default: unknown[] }>('../data/quiz/*.json', { eager: true });
const preguntas = quizzes[`../data/quiz/${gondolaId}.json`]?.default ?? [];
const APRUEBA = Math.ceil(preguntas.length * 0.8);
// Las góndolas que tienen repaso, en orden: para contar el avance total y sugerir la próxima.
const gondolas = (await getGuia())
  .filter((c) => `../data/quiz/${c.id}.json` in quizzes)
  .map((c) => ({ id: c.id, titulo: c.data.titulo, url: urlCategoria(c) }));
const json = (d: unknown) => JSON.stringify(d).replace(/</g, '\\u003c');
---

{
  preguntas.length > 0 && (
    <section class="quiz no-print mt-10" data-quiz={gondolaId} data-aprueba={APRUEBA} aria-labelledby={`quiz-${gondolaId}`}>
      <script type="application/json" data-quiz-preguntas set:html={json(preguntas)} />
      <script type="application/json" data-quiz-gondolas set:html={json({ gondolas, siguiente: siguiente ?? null, examen: url('/examen') })} />

      <div class="quiz-cabeza">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
          <Icon name="exam" class="size-7" />
        </span>
        <div class="min-w-0">
          <h2 id={`quiz-${gondolaId}`} class="text-xl font-bold text-profundo">Repaso: {titulo}</h2>
          <p class="text-sm text-texto-2" data-quiz-estado>
            {preguntas.length} preguntas cortas. Con {APRUEBA} bien, la góndola queda completada.
          </p>
        </div>
      </div>

      <!-- Inicio -->
      <div data-paso="inicio">
        <button type="button" class="boton boton-principal mt-4 w-full" data-quiz-empezar>
          <Icon name="exam" class="size-5" /> <span data-quiz-empezar-texto>Hacer el repaso</span>
        </button>
      </div>

      <!-- Pregunta -->
      <div class="hidden" data-paso="pregunta">
        <div class="mt-4 flex items-center gap-1.5" data-quiz-puntos aria-hidden="true"></div>
        <p class="mt-3 text-xs font-bold tracking-wide text-marca-texto uppercase" data-quiz-contador></p>
        <p class="mt-1 text-lg leading-snug font-bold text-profundo focus:outline-none" tabindex="-1" data-quiz-pregunta></p>
        <div class="mt-3 flex flex-col gap-2" data-quiz-opciones></div>
        <div class="mt-3 hidden" data-quiz-devolucion>
          <span class="mt-0.5 shrink-0" data-quiz-devolucion-icono></span>
          <p class="min-w-0" data-quiz-devolucion-texto></p>
        </div>
        <button type="button" class="boton boton-principal mt-3 hidden w-full" data-quiz-siguiente>Siguiente</button>
      </div>
      <!-- Siempre montada: los lectores de pantalla anuncian cada devolución -->
      <p class="sr-only" role="status" aria-live="polite" data-quiz-anuncio></p>

      <!-- Resultado -->
      <div class="festejo hidden text-center" data-paso="resultado">
        <span class="festejo-icono mx-auto mt-5 hidden size-14 items-center justify-center rounded-full bg-profundo text-white [&:not(.hidden)]:flex" data-quiz-festejo-icono>
          <Icon name="seal-check" class="size-8" />
        </span>
        <h3 class="mt-4 text-2xl font-bold text-profundo focus:outline-none" tabindex="-1" data-quiz-titulo></h3>
        <p class="mt-1 text-3xl font-bold text-profundo tabular-nums" data-quiz-nota></p>
        <p class="mt-1 font-semibold empty:hidden" data-quiz-mensaje></p>
        <div class="mt-4 hidden rounded-2xl bg-menta-suave px-4 py-3" data-quiz-avance>
          <p class="text-[0.95rem] font-semibold text-profundo" data-quiz-avance-texto></p>
          <div class="mx-auto mt-2 h-2 max-w-[280px] overflow-hidden rounded-full bg-white">
            <div class="festejo-barra h-full rounded-full bg-marca" data-quiz-avance-barra></div>
          </div>
        </div>
        <div class="mt-4 grid gap-2 sm:grid-cols-2" data-quiz-acciones>
          <button type="button" class="boton boton-principal" data-quiz-otra>
            <Icon name="arrows-clockwise" class="size-5" /> Hacerlo de nuevo
          </button>
          <a href="#" class="boton boton-secundario hidden" data-quiz-ir>
            <span data-quiz-ir-texto></span> <Icon name="arrow-right" class="size-5 shrink-0" />
          </a>
        </div>
      </div>
    </section>
  )
}

<template data-quiz-icono="bien"><Icon name="check-circle" class="size-6" /></template>
<template data-quiz-icono="mal"><Icon name="x-circle" class="size-6" /></template>

<style>
  .quiz {
    scroll-margin-top: 80px;
    border-radius: 28px;
    background: #fff;
    padding: 20px;
    box-shadow: 0 0 0 2px var(--color-menta), 0 24px 48px -36px rgb(33 76 59 / 0.5);
  }
  .quiz-cabeza {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .quiz.completada {
    box-shadow: 0 0 0 2px var(--color-marca), 0 24px 48px -36px rgb(33 76 59 / 0.5);
  }
  .quiz :global(.op) {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    border-radius: 16px;
    background: var(--color-crema);
    padding: 13px 14px;
    text-align: left;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.12);
  }
  .quiz :global(.op .marca) {
    margin-left: auto;
    flex: none;
  }
  .quiz :global(.op:not(:disabled):active) {
    transform: scale(0.99);
  }
  .quiz :global(.op.bien) {
    background: var(--color-menta);
    box-shadow: inset 0 0 0 2px var(--color-marca);
    font-weight: 600;
  }
  .quiz :global(.op.bien .marca) {
    color: var(--color-marca-texto);
  }
  .quiz :global(.op.mal) {
    background: var(--color-peligro-suave);
    box-shadow: inset 0 0 0 2px var(--color-peligro);
  }
  .quiz :global(.op.mal .marca) {
    color: var(--color-peligro);
  }
  .quiz :global(.op:disabled:not(.bien):not(.mal)) {
    opacity: 0.55;
  }
  .quiz :global(.vf) {
    justify-content: center;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .quiz :global(.vf .marca) {
    margin-left: 0;
  }
  .quiz :global(.punto) {
    height: 6px;
    flex: 1;
    border-radius: 9999px;
    background: var(--color-menta-suave);
  }
  .quiz :global(.punto.ok) {
    background: var(--color-marca);
  }
  .quiz :global(.punto.no) {
    background: var(--color-peligro);
  }
  .quiz :global(.punto.actual) {
    background: var(--color-profundo);
  }
  /* Festejo breve al completar la góndola por primera vez */
  .festejo.animar .festejo-icono {
    animation: festejo-pop 520ms var(--ease-fluid) both;
  }
  .festejo.animar .festejo-barra {
    animation: festejo-barra 900ms var(--ease-fluid) 150ms both;
  }
  @keyframes festejo-pop {
    0% {
      transform: scale(0.4);
      opacity: 0;
    }
    70% {
      transform: scale(1.12);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes festejo-barra {
    from {
      width: var(--antes, 0%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .festejo.animar .festejo-icono,
    .festejo.animar .festejo-barra {
      animation: none;
    }
  }
</style>

<script>
  import { app } from '../scripts/app';

  interface P {
    id: string;
    tipo: 'opcion' | 'vf';
    pregunta: string;
    opciones?: string[];
    correcta: number | boolean;
    explicacion: string;
  }
  interface Gondolas {
    gondolas: { id: string; titulo: string; url: string }[];
    siguiente: { url: string; titulo: string } | null;
    examen: string;
  }

  const mezclar = <T,>(a: T[]) => a.map((v) => [Math.random(), v] as const).sort((x, y) => x[0] - y[0]).map(([, v]) => v);
  const suave = (): ScrollBehavior => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
  const icono = (nombre: 'bien' | 'mal', clase: string) => {
    const svg = document.querySelector<HTMLTemplateElement>(`template[data-quiz-icono="${nombre}"]`)!.content.firstElementChild!.cloneNode(true) as SVGElement;
    svg.setAttribute('class', clase);
    return svg;
  };

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((caja) => {
    const id = caja.dataset.quiz!;
    const aprueba = Number(caja.dataset.aprueba);
    const banco: P[] = JSON.parse(caja.querySelector('[data-quiz-preguntas]')!.textContent!);
    const datos: Gondolas = JSON.parse(caja.querySelector('[data-quiz-gondolas]')!.textContent!);
    const $ = <T extends HTMLElement>(s: string) => caja.querySelector<T>(s)!;
    const pasos = [...caja.querySelectorAll<HTMLElement>('[data-paso]')];
    const enfocar = (e: HTMLElement) => e.focus({ preventScroll: true });
    /** Góndolas con el repaso aprobado (de las que existen hoy). */
    const completadas = () => {
      const q = app.estado().quizzes;
      return new Set(datos.gondolas.filter((g) => q[g.id]?.completadaEl).map((g) => g.id));
    };

    // "repaso-en-curso" en <html> solo mientras se responde y la pestaña Repaso está a la vista.
    const panel = caja.closest<HTMLElement>('[data-panel]');
    let enCurso = false;
    const marcarEnCurso = () => document.documentElement.classList.toggle('repaso-en-curso', enCurso && !panel?.hidden);
    if (panel) new MutationObserver(marcarEnCurso).observe(panel, { attributes: true, attributeFilter: ['hidden'] });
    const ver = (n: string) => {
      pasos.forEach((p) => p.classList.toggle('hidden', p.dataset.paso !== n));
      enCurso = n === 'pregunta';
      marcarEnCurso();
    };

    let orden: P[] = [];
    let i = 0;
    let resultados: boolean[] = [];

    const anunciar = (texto: string) => {
      const region = $('[data-quiz-anuncio]');
      region.textContent = '';
      requestAnimationFrame(() => (region.textContent = texto));
    };

    const pintarEstado = () => {
      const q = app.quiz(id);
      if (!q) return;
      caja.classList.toggle('completada', !!q.completadaEl);
      $('[data-quiz-estado]').textContent = q.completadaEl
        ? `Góndola completada. Tu mejor resultado: ${q.mejor} de ${q.total}.`
        : `Tu mejor resultado: ${q.mejor} de ${q.total}. Con ${aprueba} bien, queda completada.`;
      $('[data-quiz-empezar-texto]').textContent = q.completadaEl ? 'Hacerlo de nuevo' : 'Volver a intentar';
    };

    const pintarPuntos = () => {
      $('[data-quiz-puntos]').replaceChildren(
        ...orden.map((_, k) => {
          const s = document.createElement('span');
          s.className = `punto ${k < i ? (resultados[k] ? 'ok' : 'no') : k === i ? 'actual' : ''}`;
          return s;
        }),
      );
    };

    function marcar(b: HTMLButtonElement, bien: boolean) {
      b.classList.add(bien ? 'bien' : 'mal');
      const texto = document.createElement('span');
      texto.className = 'sr-only';
      texto.textContent = bien ? ' (la correcta)' : ' (tu respuesta)';
      b.append(icono(bien ? 'bien' : 'mal', 'marca size-6'), texto);
    }

    function responder(acerto: boolean, botones: HTMLButtonElement[], elegido: HTMLButtonElement, correcto: HTMLButtonElement) {
      const p = orden[i];
      resultados[i] = acerto;
      botones.forEach((b) => (b.disabled = true));
      marcar(correcto, true);
      if (!acerto) marcar(elegido, false);
      // Frase clara: nada de "No." a secas (en verdadero o falso se confundía con la respuesta).
      const inicio = acerto ? '¡Bien!' : p.tipo === 'vf' ? `Era ${p.correcta ? 'verdadero' : 'falso'}.` : 'No era esa.';
      const dev = $('[data-quiz-devolucion]');
      dev.className = `mt-3 flex gap-2.5 rounded-2xl p-3 text-[0.95rem] leading-relaxed ${acerto ? 'bg-menta-suave text-profundo' : 'bg-peligro-suave text-texto'}`;
      $('[data-quiz-devolucion-icono]').replaceChildren(icono(acerto ? 'bien' : 'mal', `size-6 ${acerto ? 'text-marca-texto' : 'text-peligro'}`));
      const texto = $('[data-quiz-devolucion-texto]');
      const fuerte = document.createElement('strong');
      fuerte.textContent = inicio;
      texto.replaceChildren(fuerte, ` ${p.explicacion}`);
      const laCorrecta = !acerto && p.tipo !== 'vf' ? ` La correcta: ${correcto.firstChild?.textContent ?? ''}.` : '';
      anunciar(`${inicio}${laCorrecta} ${p.explicacion}`);
      const sig = $('[data-quiz-siguiente]');
      sig.textContent = i + 1 < orden.length ? 'Siguiente' : 'Ver cómo me fue';
      sig.classList.remove('hidden');
      enfocar(sig);
      sig.scrollIntoView({ behavior: suave(), block: 'nearest' });
    }

    function pintar() {
      const p = orden[i];
      pintarPuntos();
      $('[data-quiz-contador]').textContent = `Pregunta ${i + 1} de ${orden.length}${p.tipo === 'vf' ? ' · Verdadero o falso' : ''}`;
      $('[data-quiz-pregunta]').textContent = p.pregunta;
      $('[data-quiz-devolucion]').className = 'mt-3 hidden';
      $('[data-quiz-siguiente]').classList.add('hidden');
      const cont = $('[data-quiz-opciones]');
      let botones: HTMLButtonElement[];
      const boton = (texto: string, clase: string) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = clase;
        const t = document.createElement('span');
        t.textContent = texto;
        b.append(t);
        return b;
      };
      if (p.tipo === 'vf') {
        cont.className = 'mt-3 grid grid-cols-2 gap-2';
        botones = [true, false].map((v) => {
          const b = boton(v ? 'Verdadero' : 'Falso', 'op vf');
          b.addEventListener('click', () => responder(v === p.correcta, botones, b, botones[p.correcta ? 0 : 1]));
          return b;
        });
      } else {
        cont.className = 'mt-3 flex flex-col gap-2';
        const ops = mezclar(p.opciones!.map((texto, k) => ({ texto, k })));
        botones = ops.map((o) => {
          const b = boton(o.texto, 'op');
          b.dataset.k = String(o.k);
          b.addEventListener('click', () =>
            responder(o.k === p.correcta, botones, b, botones.find((x) => Number(x.dataset.k) === p.correcta)!),
          );
          return b;
        });
      }
      cont.replaceChildren(...botones);
      enfocar($('[data-quiz-pregunta]'));
    }

    function terminar() {
      const bien = resultados.filter(Boolean).length;
      const aprobado = bien >= aprueba;
      const antes = app.quiz(id)?.completadaEl;
      const listasAntes = completadas().size;
      app.registrarQuiz(id, bien, orden.length, aprobado);
      const listas = completadas();
      const total = datos.gondolas.length;

      $('[data-quiz-nota]').textContent = `${bien} de ${orden.length}`;
      const titulo = $('[data-quiz-titulo]');
      const msj = $('[data-quiz-mensaje]');
      const festejo = $('[data-paso="resultado"]');
      festejo.classList.remove('animar');
      $('[data-quiz-festejo-icono]').classList.toggle('hidden', !aprobado || !!antes);
      $('[data-quiz-avance]').classList.toggle('hidden', !aprobado);

      // La próxima góndola: la siguiente sin completar (si no queda ninguna, el examen).
      const pos = datos.gondolas.findIndex((g) => g.id === id);
      const resto = [...datos.gondolas.slice(pos + 1), ...datos.gondolas.slice(0, Math.max(pos, 0))];
      const pendiente = resto.find((g) => !listas.has(g.id));
      const ir = $<HTMLAnchorElement>('[data-quiz-ir]');
      const irTexto = $('[data-quiz-ir-texto]');
      const otra = $('[data-quiz-otra]');
      const acciones = $('[data-quiz-acciones]');

      if (aprobado) {
        titulo.textContent = antes ? '¡Muy bien! Seguís sabiéndolo.' : '¡Góndola completada!';
        msj.className = 'mt-1 font-semibold text-marca-texto';
        msj.textContent = '';
        $('[data-quiz-avance-texto]').textContent =
          listas.size >= total ? `¡Completaste las ${total} góndolas!` : `Llevás ${listas.size} de ${total} góndolas completadas.`;
        const barra = $('[data-quiz-avance-barra]');
        barra.style.width = `${(listas.size / total) * 100}%`;
        barra.style.setProperty('--antes', `${(listasAntes / total) * 100}%`);
        if (!antes) {
          void festejo.offsetWidth; // reinicia la animación
          festejo.classList.add('animar');
        }
        if (pendiente) {
          ir.href = pendiente.url;
          irTexto.textContent = `Seguir con ${pendiente.titulo}`;
        } else {
          ir.href = datos.examen;
          irTexto.textContent = 'Ir a Examinarme';
        }
        // Aprobó: lo principal es seguir; hacerlo de nuevo queda como secundario.
        ir.className = 'boton boton-principal';
        otra.className = 'boton boton-secundario';
        acciones.prepend(ir);
      } else {
        titulo.textContent = bien >= aprueba - 1 ? 'Te faltó poco' : 'Todavía no';
        msj.className = 'mt-1 font-semibold text-texto-2';
        msj.textContent =
          bien >= aprueba - 1 ? `Necesitás ${aprueba} bien. Probá de nuevo.` : `Necesitás ${aprueba} bien. Repasá la góndola y probá de nuevo.`;
        // No aprobó: lo principal es hacerlo de nuevo; la siguiente góndola queda como secundaria.
        otra.className = 'boton boton-principal';
        if (datos.siguiente) {
          ir.href = datos.siguiente.url;
          irTexto.textContent = `Ir a ${datos.siguiente.titulo}`;
          ir.className = 'boton boton-secundario';
        } else ir.className = 'hidden';
        acciones.prepend(otra);
      }
      pintarEstado();
      ver('resultado');
      anunciar(`${titulo.textContent} ${bien} de ${orden.length}.`);
      enfocar(titulo);
    }

    function empezar() {
      orden = mezclar(banco);
      i = 0;
      resultados = [];
      ver('pregunta');
      pintar();
      caja.scrollIntoView({ behavior: suave(), block: 'start' });
    }

    $('[data-quiz-empezar]').addEventListener('click', empezar);
    $('[data-quiz-otra]').addEventListener('click', empezar);
    $('[data-quiz-siguiente]').addEventListener('click', () => {
      i++;
      if (i < orden.length) pintar();
      else terminar();
    });
    pintarEstado();
  });
</script>
