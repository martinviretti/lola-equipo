---
// Repaso corto al final de cada góndola (src/data/quiz/<id>.json): 5 preguntas, de a una,
// con la respuesta al instante. Con 4 bien o más, la góndola queda completada.
import Icon from './Icon.astro';

interface Props {
  gondolaId: string;
  titulo: string;
  siguiente?: { url: string; titulo: string };
}

const { gondolaId, titulo, siguiente } = Astro.props;
const quizzes = import.meta.glob<{ default: unknown[] }>('../data/quiz/*.json', { eager: true });
const preguntas = quizzes[`../data/quiz/${gondolaId}.json`]?.default ?? [];
const APRUEBA = Math.ceil(preguntas.length * 0.8);
---

{
  preguntas.length > 0 && (
    <section class="quiz no-print mt-10" data-quiz={gondolaId} data-aprueba={APRUEBA} aria-labelledby={`quiz-${gondolaId}`}>
      <script type="application/json" set:html={JSON.stringify(preguntas)} />

      <div class="quiz-cabeza">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
          <Icon name="exam" class="size-7" />
        </span>
        <div class="min-w-0">
          <h2 id={`quiz-${gondolaId}`} class="text-xl font-bold text-profundo">Repaso de {titulo}</h2>
          <p class="text-sm text-texto-2" data-quiz-estado>
            {preguntas.length} preguntas cortas. Con {APRUEBA} bien, la góndola queda completada.
          </p>
        </div>
      </div>

      <!-- Inicio -->
      <div data-paso="inicio">
        <button type="button" class="boton boton-principal mt-4 w-full" data-quiz-empezar>
          <Icon name="exam" class="size-5" /> <span data-quiz-empezar-texto>Hacer el repaso</span>
        </button>
      </div>

      <!-- Pregunta -->
      <div class="hidden" data-paso="pregunta">
        <div class="mt-4 flex items-center gap-1.5" data-quiz-puntos aria-hidden="true"></div>
        <p class="mt-3 text-xs font-bold tracking-wide text-marca-texto uppercase" data-quiz-contador></p>
        <p class="mt-1 text-lg leading-snug font-bold text-profundo" data-quiz-pregunta></p>
        <div class="mt-3 flex flex-col gap-2" data-quiz-opciones></div>
        <p class="mt-3 hidden rounded-2xl p-3 text-[0.95rem] leading-relaxed" data-quiz-devolucion aria-live="polite"></p>
        <button type="button" class="boton boton-principal mt-3 hidden w-full" data-quiz-siguiente>Siguiente</button>
      </div>

      <!-- Resultado -->
      <div class="hidden text-center" data-paso="resultado">
        <p class="mt-4 text-4xl font-bold text-profundo tabular-nums" data-quiz-nota></p>
        <p class="mt-1 font-semibold" data-quiz-mensaje></p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <button type="button" class="boton boton-secundario" data-quiz-otra>
            <Icon name="arrows-clockwise" class="size-5" /> Hacerlo de nuevo
          </button>
          {
            siguiente && (
              <a href={siguiente.url} class="boton boton-principal">
                {siguiente.titulo} <Icon name="arrow-right" class="size-5" />
              </a>
            )
          }
        </div>
      </div>
    </section>
  )
}

<style>
  .quiz {
    scroll-margin-top: 80px;
    border-radius: 28px;
    background: #fff;
    padding: 20px;
    box-shadow: 0 0 0 2px var(--color-menta), 0 24px 48px -36px rgb(33 76 59 / 0.5);
  }
  .quiz-cabeza {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .quiz.completada {
    box-shadow: 0 0 0 2px var(--color-marca), 0 24px 48px -36px rgb(33 76 59 / 0.5);
  }
  .quiz :global(.op) {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 10px;
    border-radius: 16px;
    background: var(--color-crema);
    padding: 13px 14px;
    text-align: left;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.12);
  }
  .quiz :global(.op:not(:disabled):active) {
    transform: scale(0.99);
  }
  .quiz :global(.op.bien) {
    background: var(--color-menta);
    box-shadow: inset 0 0 0 2px var(--color-marca);
    font-weight: 600;
  }
  .quiz :global(.op.mal) {
    background: var(--color-peligro-suave);
    box-shadow: inset 0 0 0 2px var(--color-peligro);
  }
  .quiz :global(.op:disabled:not(.bien):not(.mal)) {
    opacity: 0.55;
  }
  .quiz :global(.vf) {
    justify-content: center;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .quiz :global(.punto) {
    height: 6px;
    flex: 1;
    border-radius: 9999px;
    background: var(--color-menta-suave);
  }
  .quiz :global(.punto.ok) {
    background: var(--color-marca);
  }
  .quiz :global(.punto.no) {
    background: var(--color-peligro);
  }
  .quiz :global(.punto.actual) {
    background: var(--color-profundo);
  }
</style>

<script>
  import { app } from '../scripts/app';

  interface P {
    id: string;
    tipo: 'opcion' | 'vf';
    pregunta: string;
    opciones?: string[];
    correcta: number | boolean;
    explicacion: string;
  }

  const mezclar = <T,>(a: T[]) => a.map((v) => [Math.random(), v] as const).sort((x, y) => x[0] - y[0]).map(([, v]) => v);

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((caja) => {
    const id = caja.dataset.quiz!;
    const aprueba = Number(caja.dataset.aprueba);
    const banco: P[] = JSON.parse(caja.querySelector('script[type="application/json"]')!.textContent!);
    const $ = <T extends HTMLElement>(s: string) => caja.querySelector<T>(s)!;
    const pasos = [...caja.querySelectorAll<HTMLElement>('[data-paso]')];
    const ver = (n: string) => pasos.forEach((p) => p.classList.toggle('hidden', p.dataset.paso !== n));

    let orden: P[] = [];
    let i = 0;
    let resultados: boolean[] = [];

    const pintarEstado = () => {
      const q = app.quiz(id);
      if (!q) return;
      caja.classList.toggle('completada', !!q.completadaEl);
      $('[data-quiz-estado]').textContent = q.completadaEl
        ? `Góndola completada. Tu mejor resultado: ${q.mejor} de ${q.total}.`
        : `Tu mejor resultado: ${q.mejor} de ${q.total}. Con ${aprueba} bien, queda completada.`;
      $('[data-quiz-empezar-texto]').textContent = q.completadaEl ? 'Repasar de nuevo' : 'Volver a intentar';
    };

    const pintarPuntos = () => {
      $('[data-quiz-puntos]').replaceChildren(
        ...orden.map((_, k) => {
          const s = document.createElement('span');
          s.className = `punto ${k < i ? (resultados[k] ? 'ok' : 'no') : k === i ? 'actual' : ''}`;
          return s;
        }),
      );
    };

    function responder(acerto: boolean, botones: HTMLButtonElement[], elegido: HTMLButtonElement, correcto: HTMLButtonElement) {
      resultados[i] = acerto;
      botones.forEach((b) => (b.disabled = true));
      correcto.classList.add('bien');
      if (!acerto) elegido.classList.add('mal');
      const dev = $('[data-quiz-devolucion]');
      dev.className = `mt-3 rounded-2xl p-3 text-[0.95rem] leading-relaxed ${acerto ? 'bg-menta-suave text-profundo' : 'bg-peligro-suave text-texto'}`;
      dev.textContent = `${acerto ? '¡Bien! ' : 'No. '}${orden[i].explicacion}`;
      const sig = $('[data-quiz-siguiente]');
      sig.textContent = i + 1 < orden.length ? 'Siguiente' : 'Ver cómo me fue';
      sig.classList.remove('hidden');
      sig.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function pintar() {
      const p = orden[i];
      pintarPuntos();
      $('[data-quiz-contador]').textContent = `Pregunta ${i + 1} de ${orden.length}${p.tipo === 'vf' ? ' · Verdadero o falso' : ''}`;
      $('[data-quiz-pregunta]').textContent = p.pregunta;
      $('[data-quiz-devolucion]').classList.add('hidden');
      $('[data-quiz-siguiente]').classList.add('hidden');
      const cont = $('[data-quiz-opciones]');
      let botones: HTMLButtonElement[];
      if (p.tipo === 'vf') {
        cont.className = 'mt-3 grid grid-cols-2 gap-2';
        botones = [true, false].map((v) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'op vf';
          b.textContent = v ? 'Verdadero' : 'Falso';
          b.addEventListener('click', () => responder(v === p.correcta, botones, b, botones[p.correcta ? 0 : 1]));
          return b;
        });
      } else {
        cont.className = 'mt-3 flex flex-col gap-2';
        const ops = mezclar(p.opciones!.map((texto, k) => ({ texto, k })));
        botones = ops.map((o) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'op';
          b.textContent = o.texto;
          b.dataset.k = String(o.k);
          b.addEventListener('click', () =>
            responder(o.k === p.correcta, botones, b, botones.find((x) => Number(x.dataset.k) === p.correcta)!),
          );
          return b;
        });
      }
      cont.replaceChildren(...botones);
    }

    function terminar() {
      const bien = resultados.filter(Boolean).length;
      const aprobado = bien >= aprueba;
      const antes = app.quiz(id)?.completadaEl;
      app.registrarQuiz(id, bien, orden.length, aprobado);
      $('[data-quiz-nota]').textContent = `${bien} de ${orden.length}`;
      const msj = $('[data-quiz-mensaje]');
      msj.className = `mt-1 font-semibold ${aprobado ? 'text-marca-texto' : 'text-texto-2'}`;
      msj.textContent = aprobado
        ? antes
          ? '¡Muy bien! Seguís sabiéndolo.'
          : '¡Góndola completada!'
        : bien >= aprueba - 1
          ? `Te faltó poco: necesitás ${aprueba} bien. Probá de nuevo.`
          : `Necesitás ${aprueba} bien. Repasá la góndola y probá de nuevo.`;
      pintarEstado();
      ver('resultado');
    }

    function empezar() {
      orden = mezclar(banco);
      i = 0;
      resultados = [];
      pintar();
      ver('pregunta');
      caja.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    $('[data-quiz-empezar]').addEventListener('click', empezar);
    $('[data-quiz-otra]').addEventListener('click', empezar);
    $('[data-quiz-siguiente]').addEventListener('click', () => {
      i++;
      if (i < orden.length) pintar();
      else terminar();
    });
    pintarEstado();
  });
</script>
