---
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import { getGuia } from '../data/guia';

const gondolas = await getGuia();
---

<Manual title="Estudiar">
  <main id="contenido" class="px-5 pt-6 pb-16 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[560px]">
      <h1 class="titulo-degrade text-4xl font-bold tracking-tight">Estudiar</h1>
      <p class="mt-1 text-base text-texto-2">Mirá el producto, pensá qué es y tocá la tarjeta para ver la respuesta.</p>

      <div class="-mx-5 mt-5 overflow-x-auto px-5 pb-1 [scrollbar-width:none]">
        <div class="flex w-max gap-2" data-filtros role="tablist" aria-label="Elegí qué estudiar">
          <button type="button" data-gondola="" class="filtro">Todas</button>
          {gondolas.map((g) => <button type="button" data-gondola={g.id} class="filtro">{g.data.titulo}</button>)}
        </div>
      </div>

      <div class="mt-5">
        <div class="flex items-center justify-between text-sm">
          <span class="font-semibold text-profundo" data-progreso-texto>Cargando…</span>
          <button type="button" data-reiniciar class="hidden items-center gap-1 font-semibold text-marca">
            <Icon name="arrows-clockwise" class="size-4" /> Empezar de nuevo
          </button>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-menta-suave">
          <div class="h-full w-0 rounded-full bg-marca transition-[width] duration-500 ease-fluid" data-progreso-barra></div>
        </div>
      </div>

      <div class="escena mt-6" data-escena>
        <button type="button" class="tarjeta" data-tarjeta aria-live="polite">
          <span class="cara frente">
            <span class="flex items-center gap-2 text-sm font-semibold text-marca" data-gondola-nombre></span>
            <span class="mt-6 text-3xl leading-tight font-bold text-profundo sm:text-4xl" data-titulo></span>
            <span class="mt-auto flex items-center gap-2 text-sm text-texto-2">
              <Icon name="arrows-clockwise" class="size-4" /> Tocá para ver la respuesta
            </span>
          </span>
          <span class="cara dorso">
            <span class="text-sm font-semibold text-menta" data-titulo-dorso></span>
            <span class="mt-3 flex flex-col gap-3 text-left" data-lineas></span>
          </span>
        </button>

        <div class="mt-5 grid grid-cols-2 gap-3" data-respuestas>
          <button type="button" data-repasar class="boton boton-secundario">A repasar</button>
          <button type="button" data-sabia class="boton boton-principal">
            <Icon name="check" class="size-5" /> Lo sabía
          </button>
          <a class="col-span-2 text-center text-sm font-semibold text-marca underline underline-offset-4" data-ver-ficha>Ver la ficha completa</a>
        </div>
      </div>

      <div class="mt-6 hidden rounded-3xl bg-profundo p-6 text-center text-white" data-terminado>
        <Icon name="check-circle" class="mx-auto size-12 text-menta" />
        <p class="mt-3 text-2xl font-bold">¡Sabés todas!</p>
        <p class="mt-1 text-white/80" data-terminado-texto></p>
        <button type="button" data-reiniciar-fin class="boton mt-5 bg-white text-profundo hover:bg-menta">
          <Icon name="arrows-clockwise" class="size-5" /> Repasar de nuevo
        </button>
      </div>
    </div>
  </main>
</Manual>

<style>
  .filtro {
    border-radius: 9999px;
    background: #fff;
    padding: 8px 14px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-profundo);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.12);
    white-space: nowrap;
  }
  .filtro[aria-selected='true'] {
    background: var(--color-profundo);
    color: #fff;
  }
  .escena {
    perspective: 1400px;
  }
  .tarjeta {
    position: relative;
    display: block;
    width: 100%;
    min-height: 440px;
    transform-style: preserve-3d;
    transition: transform 600ms var(--ease-fluid);
    text-align: left;
  }
  .tarjeta.volteada {
    transform: rotateY(180deg);
  }
  .cara {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 28px;
    padding: 24px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .frente {
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(33 76 59 / 0.1), 0 24px 48px -28px rgb(33 76 59 / 0.4);
  }
  .frente::after {
    content: '';
    position: absolute;
    right: -70px;
    bottom: -70px;
    width: 220px;
    height: 220px;
    border-radius: 9999px;
    background: var(--color-menta-suave);
    z-index: -1;
  }
  .dorso {
    transform: rotateY(180deg);
    background: var(--color-profundo);
    color: #fff;
    overflow-y: auto;
  }
  .dorso :global(.linea strong) {
    display: block;
    font-size: 0.8rem;
    color: var(--color-menta);
  }
  .dorso :global(.linea span) {
    font-size: 0.975rem;
    line-height: 1.55;
  }
  .dorso :global(.linea.destacada) {
    border-radius: 14px;
    background: rgb(255 255 255 / 0.09);
    padding: 8px 12px;
  }
  .dorso :global(.linea.ojo strong) {
    color: #f3d58a;
  }
  [data-respuestas] {
    visibility: hidden;
  }
  .mostrar-respuestas [data-respuestas] {
    visibility: visible;
  }
</style>

<script>
  import { app, cargarFichas, type Ficha } from '../scripts/app';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const escena = $('[data-escena]');
  const tarjeta = $<HTMLButtonElement>('[data-tarjeta]');
  const filtros = [...document.querySelectorAll<HTMLButtonElement>('[data-filtros] button')];

  let todas: Ficha[] = [];
  let mazo: Ficha[] = [];
  let actual: Ficha | undefined;
  let gondola = new URLSearchParams(location.search).get('gondola') ?? '';

  const mezclar = <T,>(a: T[]) => a.map((v) => [Math.random(), v] as const).sort((x, y) => x[0] - y[0]).map(([, v]) => v);
  const delFiltro = () => todas.filter((f) => !gondola || f.gondolaId === gondola);

  function pintarProgreso() {
    const lista = delFiltro();
    const sabidas = new Set(app.estado().sabidas);
    const n = lista.filter((f) => sabidas.has(f.id)).length;
    $('[data-progreso-texto]').textContent = `Sabés ${n} de ${lista.length} fichas`;
    $('[data-progreso-barra]').style.width = lista.length ? `${(n / lista.length) * 100}%` : '0';
    const reiniciar = $('[data-reiniciar]');
    reiniciar.classList.toggle('hidden', n === 0);
    reiniciar.classList.toggle('inline-flex', n > 0);
  }

  function armarMazo() {
    const sabidas = new Set(app.estado().sabidas);
    mazo = mezclar(delFiltro().filter((f) => !sabidas.has(f.id)));
    filtros.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.gondola === gondola)));
    pintarProgreso();
    siguiente();
  }

  function siguiente() {
    actual = mazo.shift();
    tarjeta.classList.remove('volteada');
    escena.classList.remove('mostrar-respuestas');
    const terminado = !actual;
    escena.classList.toggle('hidden', terminado);
    $('[data-terminado]').classList.toggle('hidden', !terminado);
    if (!actual) {
      const nombre = gondola ? filtros.find((b) => b.dataset.gondola === gondola)?.textContent : 'la guía';
      $('[data-terminado-texto]').textContent = `Repasaste todas las fichas de ${nombre}.`;
      return;
    }
    $('[data-gondola-nombre]').textContent = actual.gondola;
    $('[data-titulo]').textContent = actual.titulo;
    $('[data-titulo-dorso]').textContent = actual.titulo;
    const lineas = $('[data-lineas]');
    lineas.replaceChildren(
      ...actual.lineas.map((l) => {
        const div = document.createElement('span');
        div.className = l.etiqueta ? `linea destacada ${l.etiqueta === 'Ojo' ? 'ojo' : ''}` : 'linea';
        const t = document.createElement('span');
        t.textContent = l.texto;
        if (l.etiqueta) {
          const s = document.createElement('strong');
          s.textContent = l.etiqueta;
          div.append(s);
        }
        div.append(t);
        return div;
      }),
    );
    $<HTMLAnchorElement>('[data-ver-ficha]').href = actual.url;
  }

  tarjeta.addEventListener('click', () => {
    tarjeta.classList.toggle('volteada');
    escena.classList.add('mostrar-respuestas');
  });
  $('[data-sabia]').addEventListener('click', () => {
    if (actual) app.marcarSabida(actual.id, true);
    pintarProgreso();
    siguiente();
  });
  $('[data-repasar]').addEventListener('click', () => {
    // Vuelve al mazo, un poco más adelante.
    if (actual) mazo.splice(Math.min(mazo.length, 3), 0, actual);
    siguiente();
  });
  const reiniciar = () => {
    const ids = new Set(delFiltro().map((f) => f.id));
    app.estado().sabidas.filter((id) => ids.has(id)).forEach((id) => app.marcarSabida(id, false));
    armarMazo();
  };
  $('[data-reiniciar]').addEventListener('click', reiniciar);
  $('[data-reiniciar-fin]').addEventListener('click', reiniciar);
  filtros.forEach((b) =>
    b.addEventListener('click', () => {
      gondola = b.dataset.gondola ?? '';
      history.replaceState(null, '', gondola ? `?gondola=${gondola}` : location.pathname);
      armarMazo();
    }),
  );

  cargarFichas().then((f) => {
    todas = f;
    armarMazo();
    filtros.find((b) => b.dataset.gondola === gondola)?.scrollIntoView({ inline: 'center', block: 'nearest' });
  });
</script>
