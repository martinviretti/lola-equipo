---
import { url } from '../lib/url';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import Alerta from '../components/Alerta.astro';
import Tabla from '../components/Tabla.astro';
import logo from '../assets/logo-lola-circulo.png';
import { getModulos, PARTES, numeroModulo } from '../data/modulos';
import { existsSync } from 'node:fs';

const modulos = await getModulos();
const renderizados = await Promise.all(modulos.map(async (m) => ({ m, ...(await render(m)) })));
const letras = ['A', 'B', 'C', 'D'];
const conQuiz = modulos.filter((m) => m.data.quiz.length > 0);
const fecha = new Intl.DateTimeFormat('es-AR', { month: 'long', year: 'numeric' }).format(new Date());
// El PDF lo genera `npm run pdf` y queda en public/.
const hayPdf = existsSync('public/manual-el-almacen-de-lola.pdf');
---

<Manual title="Versión para imprimir" impresion>
  <div class="no-print sticky top-0 z-40 border-b border-profundo/10 bg-crema/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-[860px] flex-wrap items-center gap-3 px-5 py-3">
      <a href={url('/manual')} class="inline-flex items-center gap-2 text-sm font-semibold text-marca hover:underline">
        <Icon name="arrow-left" class="size-4" /> Volver al manual
      </a>
      <div class="ml-auto flex flex-wrap gap-2">
        {
          hayPdf && (
            <a href={url('/manual-el-almacen-de-lola.pdf')} download class="boton boton-secundario !py-2 !text-sm">
              <Icon name="file-pdf" class="size-5" /> Descargar PDF
            </a>
          )
        }
        <button type="button" onclick="window.print()" class="boton boton-principal !py-2 !text-sm">
          <Icon name="printer" class="size-5" /> Imprimir o guardar en PDF
        </button>
      </div>
    </div>
    <p class="mx-auto max-w-[860px] px-5 pb-3 text-xs text-texto-2">
      En la ventana de impresión elegí "Guardar como PDF" para tenerlo en el celular. Activá "Gráficos de fondo" para que salgan los colores.
    </p>
  </div>

  <main id="contenido" class="hoja-contenedor mx-auto max-w-[860px] px-5 pb-24 print:max-w-none print:px-0 print:pb-0">
    <!-- Portada -->
    <section class="portada fondo-hojas mt-8 flex flex-col justify-between rounded-3xl p-10 print:mt-0 print:rounded-none">
      <div>
        <Image src={logo} alt="Logo de Lola" width={150} height={150} class="size-28 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.15)]" loading="eager" />
        <p class="mt-10 text-lg font-semibold text-marca">El Almacén de Lola</p>
        <h1 class="titulo-degrade mt-2 text-6xl font-bold tracking-tight">Manual <br />del equipo</h1>
        <p class="mt-6 max-w-[460px] text-lg text-texto-2">
          Todo lo que necesitás para atender bien desde tu primera semana.
        </p>
      </div>
      <div class="rounded-2xl bg-white/90 p-6 ring-1 ring-profundo/10">
        <dl class="grid gap-5 text-sm">
          <div class="flex items-end gap-3"><dt class="w-32 shrink-0 font-semibold text-profundo">Nombre</dt><dd class="flex-1 border-b border-texto-2/40">&nbsp;</dd></div>
          <div class="flex items-end gap-3"><dt class="w-32 shrink-0 font-semibold text-profundo">Fecha de ingreso</dt><dd class="flex-1 border-b border-texto-2/40">&nbsp;</dd></div>
          <div class="flex items-end gap-3"><dt class="w-32 shrink-0 font-semibold text-profundo">Te acompaña</dt><dd class="flex-1 border-b border-texto-2/40">&nbsp;</dd></div>
        </dl>
        <p class="mt-6 text-xs text-texto-2">Av. Presidente Perón 3099, Victoria · @lolasaludable · Versión de {fecha}</p>
      </div>
    </section>

    <!-- Índice -->
    <section class="hoja mt-12">
      <h2 class="text-3xl font-bold tracking-tight text-profundo">Índice</h2>
      <p class="mt-2 text-base text-texto-2">
        La primera semana leé los módulos en orden. Al final de cada uno hay una autoevaluación: las respuestas
        están al final del manual. Los recuadros punteados "Completar en el local" son para que la encargada te
        cuente cómo se hace en este local.
      </p>
      <div class="mt-8 flex flex-col gap-6">
        {
          PARTES.map((parte) => {
            const lista = modulos.filter((m) => m.data.parte === parte.nombre);
            if (!lista.length) return null;
            return (
              <div class="break-inside-avoid">
                <p class="text-sm font-bold tracking-wide text-marca uppercase">{parte.nombre}</p>
                <ol class="mt-2 divide-y divide-profundo/10">
                  {lista.map((m) => (
                    <li class="flex items-baseline gap-3 py-2">
                      <span class="w-8 shrink-0 font-bold text-marca tabular-nums">{numeroModulo(m)}</span>
                      <a href={`#m-${m.id}`} class="flex-1 font-semibold text-profundo">{m.data.titulo}</a>
                      <span class="text-xs text-texto-2">{m.data.minutos} min</span>
                    </li>
                  ))}
                </ol>
              </div>
            );
          })
        }
        <div class="break-inside-avoid">
          <p class="text-sm font-bold tracking-wide text-marca uppercase">Al final</p>
          <ol class="mt-2 divide-y divide-profundo/10">
            <li class="flex gap-3 py-2"><span class="w-8"></span><a href="#respuestas" class="font-semibold text-profundo">Respuestas de las autoevaluaciones</a></li>
            <li class="flex gap-3 py-2"><span class="w-8"></span><a href="#registro" class="font-semibold text-profundo">Registro de avance</a></li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Módulos -->
    {
      renderizados.map(({ m, Content }) => (
        <section id={`m-${m.id}`} class="hoja modulo mt-16">
          <p class="flex items-center gap-2 text-sm font-semibold text-marca">
            <Icon name={m.data.icono} class="size-5" />
            Módulo {numeroModulo(m)} · {m.data.parte}
          </p>
          <h2 class="titulo-degrade mt-2 text-4xl font-bold tracking-tight">{m.data.titulo}</h2>
          <p class="mt-3 text-base text-texto-2">{m.data.resumen}</p>
          {m.data.objetivos.length > 0 && (
            <div class="mt-5 rounded-2xl bg-menta-suave p-4 break-inside-avoid">
              <p class="text-sm font-bold text-profundo">Cuando termines este módulo vas a poder:</p>
              <ul class="mt-2 flex flex-col gap-1 text-sm">
                {m.data.objetivos.map((o) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-marca" />
                    {o}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="prosa mt-8">
            <Content components={{ Alerta, table: Tabla }} />
          </div>

          {m.data.quiz.length > 0 && (
            <div class="mt-10">
              <div class="break-inside-avoid break-after-avoid rounded-2xl bg-profundo px-5 py-4 text-white">
                <p class="text-lg font-bold">Ponete a prueba</p>
                <p class="text-sm text-white/80">Marcá una opción por pregunta. Las respuestas están al final del manual.</p>
              </div>
              <ol class="mt-4 flex flex-col gap-4">
                {m.data.quiz.map((q, i) => (
                  <li class="pregunta-impresa rounded-2xl p-4 ring-1 ring-profundo/12">
                    <p class="font-semibold text-profundo">
                      {i + 1}. {q.pregunta}
                    </p>
                    <ul class="mt-2 flex flex-col gap-1.5 text-[0.95rem]">
                      {q.opciones.map((op, j) => (
                        <li class="flex gap-2">
                          <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded border border-marca text-[0.7rem] font-bold text-marca">
                            {letras[j]}
                          </span>
                          {op}
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>
      ))
    }

    <!-- Respuestas -->
    <section id="respuestas" class="hoja mt-16">
      <h2 class="text-3xl font-bold tracking-tight text-profundo">Respuestas de las autoevaluaciones</h2>
      <p class="mt-2 text-base text-texto-2">Corregite vos. Si te equivocaste, leé la explicación y volvé a esa parte del módulo.</p>
      <div class="mt-8 flex flex-col gap-8">
        {
          conQuiz.map((m) => (
            <div>
              <p class="break-after-avoid text-base font-bold text-profundo">
                {numeroModulo(m)} · {m.data.titulo}
              </p>
              <ol class="mt-2 flex flex-col gap-2 text-sm">
                {m.data.quiz.map((q, i) => (
                  <li class="flex gap-3 break-inside-avoid">
                    <span class="w-12 shrink-0 font-bold text-marca tabular-nums">
                      {i + 1}. {letras[q.correcta]}
                    </span>
                    <span class="text-texto-2">{q.explicacion}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Registro -->
    <section id="registro" class="hoja mt-16">
      <h2 class="text-3xl font-bold tracking-tight text-profundo">Registro de avance</h2>
      <p class="mt-2 text-base text-texto-2">Completalo a medida que avanzás. La encargada firma cuando repasaron juntos el módulo.</p>
      <table class="registro mt-6 w-full text-sm">
        <thead>
          <tr>
            <th class="w-10">N.º</th>
            <th>Módulo</th>
            <th class="w-24">Leído el</th>
            <th class="w-20">Quiz</th>
            <th class="w-32">Firma</th>
          </tr>
        </thead>
        <tbody>
          {
            modulos.map((m) => (
              <tr>
                <td class="font-bold text-marca tabular-nums">{numeroModulo(m)}</td>
                <td class="font-semibold text-profundo">{m.data.titulo}</td>
                <td></td>
                <td>{m.data.quiz.length ? `__ / ${m.data.quiz.length}` : '—'}</td>
                <td></td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="mt-12 break-inside-avoid">
        <p class="text-lg font-bold text-profundo">Notas</p>
        <div class="mt-3 flex flex-col">
          {Array.from({ length: 12 }).map(() => <span class="h-9 border-b border-texto-2/30"></span>)}
        </div>
      </div>
    </section>
  </main>
</Manual>

<style>
  .portada {
    min-height: 900px;
  }
  .registro th {
    text-align: left;
    padding: 8px 10px;
    background: var(--color-menta-suave);
    color: var(--color-profundo);
    font-weight: 700;
  }
  .registro td {
    padding: 10px;
    border-bottom: 1px solid rgb(33 76 59 / 0.15);
    height: 34px;
  }

  @media screen {
    .hoja {
      border-radius: 24px;
      background: #fff;
      padding: 40px;
      box-shadow: 0 0 0 1px rgb(33 76 59 / 0.08);
    }
  }
  @media screen and (max-width: 640px) {
    .hoja {
      padding: 22px;
    }
    .portada {
      min-height: 640px;
      padding: 28px;
    }
  }

  @media print {
    .portada {
      page: portada;
      height: 297mm;
      min-height: 0;
      padding: 22mm 20mm;
      break-after: page;
    }
    .hoja {
      break-before: page;
      margin-top: 0;
    }
    .modulo h2.titulo-degrade {
      font-size: 24pt;
    }
    .registro tr {
      break-inside: avoid;
    }
  }
</style>
