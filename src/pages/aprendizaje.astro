---
// Panel de admin → Aprendizaje: cómo viene el equipo con la guía y los exámenes. Los números, los
// gráficos y "cómo va cada una" (se abre para ver el detalle de cada persona).
// Los accesos están en Gestión de equipo (equipo.astro) y el Excel, en "Descargar todo" de Inicio.
// Solo lo ven las admins (rol 'admin' en la tabla autorizados); la base lo controla con RLS.
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import PestanasAdmin from '../components/PestanasAdmin.astro';
import DatosGuia from '../components/DatosGuia.astro';
import ErrorCarga from '../components/ErrorCarga.astro';
---

<Manual title="Panel de admin · Aprendizaje">
  <main id="contenido" class="px-5 pt-6 pb-24 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[1040px]">
      <PestanasAdmin activa="aprendizaje" />

      <div class="mt-8 hidden rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" data-sin-permiso>
        <Icon name="lock-key" class="mx-auto size-10 text-marca-texto" />
        <p class="mt-3 text-lg font-semibold text-profundo">Esta sección es solo para administradoras</p>
        <a href={import.meta.env.BASE_URL} class="boton boton-principal mt-5">Volver al inicio</a>
      </div>

      <p class="mt-8 flex items-center gap-2 font-semibold text-profundo" data-cargando>
        <span class="size-4 animate-spin rounded-full border-2 border-marca border-t-transparent"></span> Cargando el avance…
      </p>
      <ErrorCarga />

      <div class="hidden" data-panel>
        <!-- Números principales -->
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" data-resumen></div>
        <p class="mt-2 text-xs text-texto-2" data-base-texto></p>

        <!-- Tablero general -->
        <div class="mt-6 grid gap-4 lg:grid-cols-2">
          <section class="tarjeta">
            <h2 class="tarjeta-titulo">Actividad de los últimos 14 días</h2>
            <p class="tarjeta-sub">Lecturas, repasos, exámenes y temas de Bienvenida, sumados por día.</p>
            <div class="mt-4" data-grafico-actividad></div>
          </section>

          <section class="tarjeta">
            <h2 class="tarjeta-titulo">Examen por nivel</h2>
            <p class="tarjeta-sub">Cuántas aprobaron cada nivel.</p>
            <div class="mt-4 flex flex-col gap-4" data-grafico-niveles></div>
          </section>

          <section class="tarjeta lg:col-span-2">
            <h2 class="tarjeta-titulo">Góndolas completadas</h2>
            <p class="tarjeta-sub">Cuántas personas aprobaron el repaso de cada góndola. Las que menos se completaron, arriba.</p>
            <div class="mt-4" data-grafico-gondolas></div>
          </section>
        </div>

        <!-- Cómo va cada una -->
        <section class="mt-8">
          <h2 class="text-xl font-bold text-profundo">Cómo va cada una</h2>
          <p class="mt-1 text-sm text-texto-2">Tocá a una persona para ver su avance: cada góndola, los exámenes y lo último que hizo.</p>
          <p class="mt-1 text-xs font-semibold text-texto-2">Exámenes: <span data-niveles-leyenda></span></p>
          <ul class="mt-4 flex flex-col gap-3" data-equipo></ul>
        </section>

        <button type="button" class="boton boton-secundario mt-6 !text-sm" data-recargar>Actualizar datos</button>
      </div>
    </div>
  </main>
</Manual>

<DatosGuia />

<style>
  .campo {
    min-height: 44px;
    width: 100%;
    border-radius: 14px;
    background: var(--color-crema);
    padding: 12px 14px;
    font-size: 1rem;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.18);
    outline: none;
  }
  .campo:focus {
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  .tarjeta {
    border-radius: 24px;
    background: #fff;
    padding: 20px;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  .tarjeta-titulo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .tarjeta-sub {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--color-texto-2);
  }
  :global(.persona summary::-webkit-details-marker) {
    display: none;
  }
  /* Cabecera de cada persona: en celular, el avance y los niveles van debajo; en compu, en columnas
     fijas para que todas queden alineadas. */
  :global(.persona-cabeza) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'avatar quien flecha' 'avance avance avance' 'niveles niveles niveles';
    align-items: center;
    gap: 10px 12px;
  }
  :global(.persona-cabeza > :nth-child(1)) {
    grid-area: avatar;
  }
  :global(.persona-cabeza > :nth-child(2)) {
    grid-area: quien;
  }
  :global(.persona-avance) {
    grid-area: avance;
  }
  :global(.persona-niveles) {
    grid-area: niveles;
    display: flex;
    gap: 6px;
  }
  :global(.persona-flecha) {
    grid-area: flecha;
    color: var(--color-texto-2);
    transition: transform 160ms;
  }
  :global(.persona[open] .persona-flecha) {
    transform: rotate(180deg);
  }
  @media (min-width: 768px) {
    :global(.persona-cabeza) {
      grid-template-columns: auto minmax(0, 1fr) 13rem 9.5rem auto;
      grid-template-areas: 'avatar quien avance niveles flecha';
    }
  }
  :global(.chip-nivel) {
    display: inline-flex;
    width: 2.9rem;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-menta-suave);
    padding: 4px 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-texto-2);
  }
  :global(.chip-nivel.ok) {
    background: var(--color-marca);
    color: #fff;
  }

  /* ---------- Gráficos (una sola serie por gráfico, color de marca) ---------- */
  /* Medidor: barra fina con el valor en texto al lado */
  :global(.medidor) {
    height: 8px;
    border-radius: 9999px;
    background: var(--color-menta-suave);
  }
  :global(.medidor > span) {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: var(--color-marca);
  }
  /* Columnas por día */
  :global(.columnas) {
    position: relative;
  }
  :global(.columnas-area) {
    display: flex;
    height: 140px;
    padding-top: 20px;
    align-items: flex-end;
    gap: 2px;
    border-bottom: 1px solid rgb(33 76 59 / 0.14);
  }
  :global(.columnas-area.chica) {
    height: 64px;
    padding-top: 4px;
  }
  :global(.col) {
    position: relative;
    display: flex;
    height: 100%;
    flex: 1;
    align-items: flex-end;
    justify-content: center;
    outline: none;
  }
  :global(.col > i) {
    display: block;
    width: min(18px, 70%);
    border-radius: 4px 4px 0 0;
    background: var(--color-marca);
    transition: opacity 150ms;
  }
  :global(.col.cero > i) {
    height: 2px !important;
    border-radius: 0;
    background: rgb(33 76 59 / 0.1);
  }
  :global(.columnas-area:hover .col > i) {
    opacity: 0.55;
  }
  :global(.columnas-area .col:hover > i),
  :global(.columnas-area .col:focus-visible > i) {
    opacity: 1;
  }
  :global(.col:focus-visible) {
    box-shadow: inset 0 0 0 2px var(--color-marca);
    border-radius: 6px;
  }
  :global(.col-valor) {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -100%);
    padding-bottom: 2px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-texto);
  }
  :global(.columnas-ejes) {
    display: flex;
    gap: 2px;
    margin-top: 4px;
    font-size: 0.75rem;
    color: var(--color-texto-2);
  }
  :global(.columnas-ejes span) {
    flex: 1;
    text-align: center;
    white-space: nowrap;
  }
  :global(.globo) {
    pointer-events: none;
    position: absolute;
    z-index: 5;
    min-width: 150px;
    transform: translate(-50%, calc(-100% - 8px));
    border-radius: 12px;
    background: var(--color-profundo);
    padding: 8px 10px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #fff;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
  }
  /* Barras horizontales por góndola */
  :global(.barras) {
    display: grid;
    gap: 10px 28px;
  }
  @media (min-width: 640px) {
    :global(.barras) {
      grid-template-columns: 1fr 1fr;
    }
  }
  :global(.barras .etq) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    color: var(--color-texto);
  }
  :global(.barras .pista) {
    margin-top: 3px;
    height: 8px;
    border-radius: 9999px;
    background: rgb(33 76 59 / 0.06);
  }
  :global(.barras .pista > span) {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: var(--color-marca);
  }
  :global(.barras .val) {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-texto);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { cargarAprendizaje, eventos as todosLosEventos, leerInfoGuia, porUsuario, type DatosAprendizaje, type Evento } from '../scripts/admin/aprendizaje-datos';
  import { hace, nombreDe, type Persona } from '../scripts/admin/comun';
  import { arrancarPanel } from '../scripts/admin/arranque';

  type Autorizado = Persona;
  type Datos = DatosAprendizaje;

  const info = leerInfoGuia();
  const nombreNivel = (n: number) => info.niveles.find((v) => v.numero === n)?.nombre ?? '';
  const eventos = (d: Datos) => todosLosEventos(d, info);

  // ---------- Utilidades ----------
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto = '') => {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  };
  const fecha = (iso: string | null) =>
    iso ? new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(iso)) : 'Nunca';
  const diaLocal = (d: Date) => `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;

  // ---------- Gráficos ----------
  const medidor = (parte: number, total: number) => {
    const b = el('div', 'medidor');
    b.setAttribute('role', 'img');
    b.setAttribute('aria-label', `${parte} de ${total}`);
    const s = el('span');
    s.style.width = `${total ? Math.min(100, (parte / total) * 100) : 0}%`;
    b.append(s);
    return b;
  };

  /** Fila de medidor con título y valor en texto. */
  const filaMedidor = (titulo: string, parte: number, total: number, extra = '') => {
    const caja = el('div');
    const cab = el('p', 'mb-1.5 flex items-baseline justify-between gap-3 text-sm');
    cab.append(el('span', 'font-semibold text-profundo', titulo), el('span', 'font-bold text-texto tabular-nums', `${parte} de ${total}${extra}`));
    caja.append(cab, medidor(parte, total));
    return caja;
  };

  /** Columnas de los últimos 14 días (una sola serie), con globo al pasar o tocar. */
  function columnasActividad(evs: Evento[], chica = false) {
    const hoy = new Date();
    const dias = Array.from({ length: 14 }, (_, k) => {
      const d = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - (13 - k));
      return { d, clave: diaLocal(d), evs: [] as Evento[] };
    });
    for (const e of evs) dias.find((x) => x.clave === diaLocal(new Date(e.fecha)))?.evs.push(e);
    const max = Math.max(1, ...dias.map((x) => x.evs.length));
    const kMax = dias.reduce((m, x, k) => (x.evs.length > dias[m].evs.length ? k : m), 0);

    const raiz = el('div', 'columnas');
    const area = el('div', `columnas-area${chica ? ' chica' : ''}`);
    const globo = el('div', 'globo hidden');
    const fmtDia = new Intl.DateTimeFormat('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });

    dias.forEach((x, k) => {
      const n = x.evs.length;
      const col = el('div', `col${n ? '' : ' cero'}`);
      col.tabIndex = 0;
      const resumen = (['Góndola leída', 'Repaso', 'Góndola completada', 'Examen', 'Bienvenida'] as const)
        .map((t) => [t, x.evs.filter((e) => e.tipo === t).length] as const)
        .filter(([, c]) => c);
      col.setAttribute('aria-label', `${fmtDia.format(x.d)}: ${n} ${n === 1 ? 'actividad' : 'actividades'}`);
      const barra = el('i');
      barra.style.height = `${(n / max) * 100}%`;
      col.append(barra);
      if (!chica && n && k === kMax) {
        const v = el('span', 'col-valor', String(n));
        v.style.bottom = `${(n / max) * 100}%`;
        col.append(v);
      }
      const mostrar = () => {
        globo.replaceChildren(
          el('strong', 'block', fmtDia.format(x.d)),
          el('span', 'block', n ? `${n} ${n === 1 ? 'actividad' : 'actividades'}` : 'Sin actividad'),
          ...resumen.map(([t, c]) => el('span', 'block text-white/80', `${t}: ${c}`)),
        );
        globo.classList.remove('hidden');
        const r = col.getBoundingClientRect();
        const base = raiz.getBoundingClientRect();
        const x0 = r.left - base.left + r.width / 2;
        globo.style.left = `${Math.min(Math.max(x0, 80), base.width - 80)}px`;
        globo.style.top = `${area.offsetTop + area.offsetHeight * (1 - Math.max(n / max, 0.05))}px`;
      };
      col.addEventListener('pointerenter', mostrar);
      col.addEventListener('focus', mostrar);
      col.addEventListener('click', mostrar);
      col.addEventListener('pointerleave', () => globo.classList.add('hidden'));
      col.addEventListener('blur', () => globo.classList.add('hidden'));
      area.append(col);
    });

    const ejes = el('div', 'columnas-ejes');
    const fmtCorto = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'numeric' });
    dias.forEach((x, k) => ejes.append(el('span', '', k === 13 ? 'Hoy' : k % 3 === 1 ? fmtCorto.format(x.d) : '')));
    raiz.append(area, ejes, globo);
    if (!evs.length) raiz.append(el('p', 'mt-2 text-sm text-texto-2', 'Todavía no hay actividad registrada.'));
    return raiz;
  }

  /** Barras horizontales: personas que completaron cada góndola (una sola serie). */
  function barrasGondolas(d: Datos, base: Set<string>) {
    const total = base.size;
    const filas = info.gondolas
      .map((g) => {
        const filasG = d.gondolas.filter((x) => x.gondola === g.id && base.has(x.user_id));
        const completas = filasG.filter((x) => x.completada_el).length;
        const conRepaso = filasG.filter((x) => x.quiz_intentos > 0);
        const promedio = conRepaso.length ? conRepaso.reduce((s, x) => s + x.quiz_mejor / (x.quiz_total || 5), 0) / conRepaso.length : null;
        return { g, completas, leidas: filasG.filter((x) => x.vista_el).length, promedio };
      })
      .sort((a, b) => a.completas - b.completas || a.leidas - b.leidas);
    // Primero se ven las 5 menos completadas (las que hay que reforzar); el resto, con "Ver las 25".
    const VISIBLES = 5;
    const grilla = el('div', 'barras');
    filas.forEach((f, i) => {
      const fila = el('div', 'barra-fila');
      if (i >= VISIBLES) fila.hidden = true;
      fila.title = `${f.g.titulo}: completada por ${f.completas} de ${total} · leída por ${f.leidas}${
        f.promedio !== null ? ` · promedio del repaso ${Math.round(f.promedio * 100)}%` : ''
      }`;
      const cab = el('p', 'flex items-baseline justify-between gap-3');
      cab.append(el('span', 'etq', f.g.titulo), el('span', 'val', `${f.completas} de ${total}`));
      const pista = el('div', 'pista');
      const barra = el('span');
      barra.style.width = `${total ? (f.completas / total) * 100 : 0}%`;
      pista.append(barra);
      fila.append(cab, pista);
      grilla.append(fila);
    });
    if (filas.length <= VISIBLES) return grilla;
    const caja = el('div');
    const ver = el('button', 'boton boton-secundario mt-4 tap !py-2 !text-sm', `Ver las ${filas.length}`);
    ver.type = 'button';
    ver.setAttribute('aria-expanded', 'false');
    ver.addEventListener('click', () => {
      const abrir = ver.getAttribute('aria-expanded') !== 'true';
      grilla.querySelectorAll<HTMLElement>('.barra-fila').forEach((x, i) => (x.hidden = !abrir && i >= VISIBLES));
      ver.setAttribute('aria-expanded', String(abrir));
      ver.textContent = abrir ? 'Ver solo las 5 menos completadas' : `Ver las ${filas.length}`;
    });
    caja.append(grilla, ver);
    return caja;
  }

  // ---------- Pintar ----------
  function pintar(d: Datos) {
    const total = info.gondolas.length;
    const evs = eventos(d);

    // Sobre quiénes se calcula: las empleadas que ya entraron; si todavía no entró ninguna, todas las que entraron.
    const empleadasQueEntraron = d.equipo.filter((p) => p.rol === 'empleada' && p.user_id);
    const baseLista = empleadasQueEntraron.length ? empleadasQueEntraron : d.equipo.filter((p) => p.user_id);
    const base = new Set(baseLista.map((p) => p.user_id!));
    $('[data-base-texto]').textContent = empleadasQueEntraron.length
      ? `Los gráficos cuentan a las ${base.size} empleadas que ya entraron a la app.`
      : base.size
        ? 'Todavía no entró ninguna empleada: por ahora los gráficos cuentan a las admins que entraron.'
        : 'Todavía no entró nadie.';
    const evsBase = evs.filter((e) => base.has(e.user_id));

    // Números principales
    const activas7 = baseLista.filter((p) => p.ultimo_ingreso && Date.now() - new Date(p.ultimo_ingreso).getTime() < 7 * 86400000).length;
    const completasTotales = d.gondolas.filter((x) => base.has(x.user_id) && x.completada_el).length;
    const posibles = base.size * total;
    const tarjeta = (valor: string, texto: string) => {
      const c = el('div', 'rounded-2xl bg-white p-4 ring-1 ring-profundo/10');
      c.append(el('span', 'block text-3xl font-bold text-profundo tabular-nums', valor), el('span', 'block text-sm text-texto-2', texto));
      return c;
    };
    const empleadas = d.equipo.filter((p) => p.rol === 'empleada').length;
    const aprobados = d.intentos.filter((x) => base.has(x.user_id) && x.aprobado).length;
    $('[data-resumen]').replaceChildren(
      tarjeta(String(empleadas), empleadas === 1 ? 'empleada con acceso' : 'empleadas con acceso'),
      tarjeta(`${activas7} de ${base.size}`, 'entraron en los últimos 7 días'),
      tarjeta(posibles ? `${Math.round((completasTotales / posibles) * 100)}%` : '0%', 'de la guía completada en promedio'),
      tarjeta(String(aprobados), aprobados === 1 ? 'examen aprobado' : 'exámenes aprobados'),
    );

    // Tablero general
    $('[data-grafico-actividad]').replaceChildren(columnasActividad(evsBase));
    $('[data-grafico-niveles]').replaceChildren(
      ...info.niveles.map((n) => {
        const aprobaron = new Set(d.intentos.filter((x) => x.nivel === n.numero && x.aprobado && base.has(x.user_id)).map((x) => x.user_id)).size;
        return filaMedidor(`Nivel ${n.numero} · ${n.nombre}`, aprobaron, base.size);
      }),
    );
    $('[data-grafico-gondolas]').replaceChildren(base.size ? barrasGondolas(d, base) : el('p', 'text-sm text-texto-2', 'Todavía no entró nadie.'));

    // Cómo va cada una, con el tablero de cada persona (las que estaban abiertas siguen abiertas)
    const abiertas = new Set([...document.querySelectorAll<HTMLElement>('[data-equipo] > li')].filter((li) => li.querySelector('details')?.open).map((li) => li.dataset.email));
    $('[data-equipo]').replaceChildren(...d.equipo.map((p) => persona(p, d, evs, total)));
    for (const li of document.querySelectorAll<HTMLElement>('[data-equipo] > li')) if (abiertas.has(li.dataset.email)) li.querySelector('details')!.open = true;
    $('[data-niveles-leyenda]').textContent = [...info.niveles.map((n) => `N${n.numero} ${n.nombre}`), '✓ aprobado'].join(' · ');
  }

  function persona(p: Autorizado, d: Datos, evs: Evento[], total: number) {
    const gs = porUsuario(d.gondolas, p.user_id);
    const completas = gs.filter((x) => x.completada_el).length;
    const vistas = gs.filter((x) => x.vista_el).length;
    const its = porUsuario(d.intentos, p.user_id);
    const leidas = new Set(porUsuario(d.leidas, p.user_id).map((x) => x.seccion));
    const misEvs = p.user_id ? evs.filter((e) => e.user_id === p.user_id) : [];

    const li = el('li');
    li.dataset.email = p.email;
    const det = el('details', 'persona rounded-3xl bg-white ring-1 ring-profundo/10');
    const sum = el('summary', 'persona-cabeza cursor-pointer list-none p-4');
    const avatar = el('span', 'flex size-11 shrink-0 items-center justify-center rounded-full bg-menta font-bold text-profundo', nombreDe(p)[0].toUpperCase());
    const quien = el('span', 'min-w-0 flex-1');
    const nombre = el('span', 'block truncate font-semibold text-profundo', nombreDe(p));
    if (p.rol === 'admin') nombre.append(el('span', 'ml-2 rounded-full bg-profundo px-2 py-0.5 text-xs font-bold text-white uppercase', 'Admin'));
    if (d.conCara.has(p.email)) nombre.append(el('span', 'ml-2 rounded-full bg-menta-suave px-2 py-0.5 text-xs font-bold text-profundo', 'Cara ✓'));
    quien.append(nombre, el('span', 'block truncate text-sm text-texto-2', `${p.email} · ${hace(p.ultimo_ingreso)}`));
    const avance = el('span', 'persona-avance');
    const cab = el('span', 'mb-1 flex justify-between text-xs font-semibold text-texto-2');
    cab.append(el('span', '', 'Góndolas completadas'), el('span', 'tabular-nums text-texto', `${completas} de ${total}`));
    avance.append(cab, medidor(completas, total));
    const niveles = el('span', 'persona-niveles');
    for (const n of info.niveles) {
      const ok = its.some((x) => x.nivel === n.numero && x.aprobado);
      const chip = el('span', `chip-nivel ${ok ? 'ok' : ''}`, `N${n.numero}${ok ? ' ✓' : ''}`);
      chip.setAttribute('aria-label', `Nivel ${n.numero}, ${n.nombre}: ${ok ? 'aprobado' : 'sin aprobar'}`);
      chip.title = `Nivel ${n.numero} · ${n.nombre}: ${ok ? 'aprobado' : 'sin aprobar'}`;
      niveles.append(chip);
    }
    sum.append(avatar, quien, avance, niveles, el('span', 'persona-flecha', '▾'));

    // Tablero de la persona
    const cuerpo = el('div', 'border-t border-profundo/8 p-4');
    if (!p.user_id) {
      cuerpo.append(el('p', 'text-sm text-texto-2', `Todavía no entró a la app. Tiene acceso desde ${fecha(p.agregado_el)}.`));
    } else {
      const grid = el('div', 'grid gap-4 md:grid-cols-2');
      const izq = el('div', 'flex flex-col gap-3');
      const promedioRepasos = gs.filter((x) => x.quiz_intentos > 0);
      // "Góndolas completadas" ya está arriba, en la cabecera de la persona.
      izq.append(
        filaMedidor('Góndolas leídas', vistas, total),
        filaMedidor('Temas de Bienvenida', leidas.size, info.secciones.length),
      );
      const datosP = el('div', 'mt-1 text-sm');
      const fila = (t: string, v: string) => {
        const r = el('p', 'flex justify-between gap-3 py-0.5');
        r.append(el('span', 'text-texto-2', t), el('span', 'font-semibold text-profundo', v));
        return r;
      };
      datosP.append(
        fila('Primer ingreso', fecha(p.primer_ingreso)),
        fila('Último ingreso', fecha(p.ultimo_ingreso)),
        fila(
          'Promedio en repasos',
          promedioRepasos.length
            ? `${Math.round((promedioRepasos.reduce((s, x) => s + x.quiz_mejor / (x.quiz_total || 5), 0) / promedioRepasos.length) * 100)}%`
            : 'Sin repasos',
        ),
        fila('Exámenes hechos', String(its.length)),
        fila('Mejor nota de examen', its.length ? `${Math.max(...its.map((x) => x.nota))}%` : '—'),
      );
      izq.append(datosP);

      const der = el('div');
      der.append(el('p', 'text-sm font-semibold text-profundo', 'Su actividad, últimos 14 días'), columnasActividad(misEvs, true));
      der.append(el('p', 'mt-4 text-sm font-semibold text-profundo', 'Lo último que hizo'));
      const ult = el('ul', 'mt-2 flex flex-col gap-1.5');
      for (const e of misEvs.slice(0, 6)) {
        const r = el('li', 'rounded-xl bg-crema px-3 py-2 text-sm');
        r.append(el('span', 'block font-semibold text-profundo', `${e.tipo}: ${e.que}`), el('span', 'block text-xs text-texto-2', [e.resultado, fecha(e.fecha)].filter(Boolean).join(' · ')));
        ult.append(r);
      }
      if (!misEvs.length) ult.append(el('li', 'text-sm text-texto-2', 'Todavía no hizo nada en la app.'));
      der.append(ult);
      grid.append(izq, der);
      cuerpo.append(grid);

      // Detalle por góndola y exámenes, plegados para no alargar
      const plegable = (titulo: string, contenido: HTMLElement) => {
        const dd = el('details', 'mt-4 rounded-2xl bg-crema');
        const s = el('summary', 'cursor-pointer px-4 py-3 text-sm font-semibold text-profundo', titulo);
        const c = el('div', 'px-4 pb-4');
        c.append(contenido);
        dd.append(s, c);
        return dd;
      };
      const listaG = el('ul', 'grid gap-1.5 sm:grid-cols-2');
      for (const gd of info.gondolas) {
        const x = gs.find((y) => y.gondola === gd.id);
        const estado = x?.completada_el ? `Completada · ${x.quiz_mejor}/${x.quiz_total}` : x?.quiz_intentos ? `Repaso ${x.quiz_mejor}/${x.quiz_total}` : x?.vista_el ? 'Leída' : 'Sin abrir';
        const r = el('li', `flex justify-between gap-2 rounded-xl bg-white px-3 py-2 text-sm`);
        r.append(el('span', 'truncate', gd.titulo), el('span', `shrink-0 font-semibold ${x?.completada_el ? 'text-marca-texto' : 'text-texto-2'}`, estado));
        listaG.append(r);
      }
      cuerpo.append(plegable('Cada góndola', listaG));
      const listaEx = el('ul', 'flex flex-col gap-1.5');
      for (const x of its.slice(0, 30)) {
        const r = el('li', 'flex justify-between gap-3 rounded-xl bg-white px-3 py-2 text-sm');
        r.append(el('span', '', `Nivel ${x.nivel} · ${nombreNivel(x.nivel)} · ${fecha(x.hecho_el)}`), el('span', 'font-bold tabular-nums', `${x.nota}% ${x.aprobado ? '✓' : ''}`));
        listaEx.append(r);
      }
      if (!its.length) listaEx.append(el('li', 'text-sm text-texto-2', 'Todavía no hizo ningún examen.'));
      cuerpo.append(plegable(`Exámenes (${its.length})`, listaEx));
    }


    det.append(sum, cuerpo);
    li.append(det);
    return li;
  }

  // ---------- Arranque ----------
  /** Desde la ficha de una persona (Gestión de equipo): #persona/mail abre su avance. */
  function abrirPersona() {
    const [que, email] = location.hash.slice(1).split('/').map(decodeURIComponent);
    if (que !== 'persona' || !email) return;
    const det = document.querySelector<HTMLDetailsElement>(`[data-equipo] [data-email="${CSS.escape(email)}"] details`);
    if (!det) return;
    det.open = true;
    requestAnimationFrame(() => det.scrollIntoView({ block: 'start' }));
  }

  arrancarPanel({ cargar: async () => pintar(await cargarAprendizaje()), alMostrar: abrirPersona });
</script>
