---
// Panel de admin → Horarios y fichajes (solo admins), en tres partes que se ven de a una:
//  · Hoy y semana: los números del día, la línea de tiempo de hoy y la planilla de la semana contra
//    la carga horaria.
//  · Día a día: lo que hay que revisar y cada día persona por persona, para corregir o agregar.
//    Se puede abrir en un día y una persona: #dia/AAAA-MM-DD/mail (lo usan los pendientes de Inicio).
//  · Aparatos y ajustes: cómo funciona, los aparatos que fichan y los ajustes del reconocimiento.
// La cara, la carga horaria y el horario de cada persona están en su ficha (Gestión de equipo).
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import PestanasAdmin from '../components/PestanasAdmin.astro';
import VistasPanel from '../components/VistasPanel.astro';
import { url } from '../lib/url';

const linkFichador = `https://martinviretti.github.io${url('/fichador')}`;
---

<Manual title="Panel de admin · Horarios y fichajes">
  <main id="contenido" class="px-5 pt-6 pb-24 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[1040px]">
      <PestanasAdmin activa="fichaje" />
      <VistasPanel
        opciones={[
          { id: 'resumen', texto: 'Hoy y semana', icono: 'chart-bar' },
          { id: 'dia', texto: 'Día a día', icono: 'calendar-blank' },
          { id: 'config', texto: 'Aparatos y ajustes', icono: 'desktop' },
        ]}
      />

      <div class="mt-8 hidden rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" data-sin-permiso>
        <Icon name="lock-key" class="mx-auto size-10 text-marca" />
        <p class="mt-3 text-lg font-semibold text-profundo">Esta sección es solo para administradoras</p>
        <a href={import.meta.env.BASE_URL} class="boton boton-principal mt-5">Volver al inicio</a>
      </div>

      <p class="mt-8 flex items-center gap-2 font-semibold text-profundo" data-cargando>
        <span class="size-4 animate-spin rounded-full border-2 border-marca border-t-transparent"></span> Cargando las fichadas…
      </p>

      <div class="hidden" data-panel>
        <!-- ==================== RESUMEN: para mirar rápido ==================== -->
        <section data-vista="resumen">
          <div data-arranque hidden>
          <div class="tarjeta mt-6 flex flex-wrap items-center gap-3 !bg-ambar-suave">
            <Icon name="lightbulb" class="size-7 shrink-0 text-ambar" />
            <p class="min-w-0 flex-1 text-sm text-texto">
              <strong>Para empezar:</strong> activá la compu y el celular del local (en <strong>Aparatos y ajustes</strong>) y registrá las caras y la carga horaria de cada una (en
              <strong>Gestión de equipo</strong>).
            </p>
            <button type="button" class="boton boton-secundario !py-2 !text-sm" data-ir-config>Aparatos y ajustes</button>
            <a href={url('/equipo')} class="boton boton-secundario !py-2 !text-sm">Gestión de equipo</a>
          </div>
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4" data-metricas></div>

          <section class="tarjeta mt-5">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="seccion-titulo"><Icon name="clock" class="size-6 text-marca" /> Hoy</h2>
              <span class="text-sm font-semibold text-texto-2 first-letter:uppercase" data-hoy-fecha></span>
              <span class="ml-auto flex items-center gap-3 text-xs text-texto-2">
                <span class="flex items-center gap-1.5"><i class="leyenda-tramo"></i> Trabajó</span>
                <span class="flex items-center gap-1.5"><i class="leyenda-tramo abierto"></i> Adentro ahora</span>
              </span>
            </div>
            <div class="mt-3" data-linea-hoy></div>
          </section>

          <section class="tarjeta mt-5">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="seccion-titulo mr-auto"><Icon name="calendar-blank" class="size-6 text-marca" /> Semana</h2>
              <button type="button" class="boton-icono" aria-label="Semana anterior" data-semana="-1"><Icon name="caret-left" class="size-5" /></button>
              <span class="min-w-[10rem] text-center text-sm font-semibold text-profundo" data-semana-texto></span>
              <button type="button" class="boton-icono" aria-label="Semana siguiente" data-semana="1"><Icon name="caret-right" class="size-5" /></button>
              <button type="button" class="boton boton-secundario !px-3 !py-1.5 !text-sm" data-semana="0">Esta semana</button>
            </div>
            <p class="mt-1 text-sm text-texto-2">Horas de cada día y el total contra la carga horaria. Tocá un día para verlo y corregirlo en <strong>Día a día</strong>.</p>
            <div class="planilla-caja mt-4" data-planilla></div>
            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-texto-2">
              <span class="flex items-center gap-1.5"><i class="leyenda ok"></i> Completo</span>
              <span class="flex items-center gap-1.5"><i class="leyenda alerta"></i> Para mirar (falta una fichada, llegó tarde…)</span>
              <span class="flex items-center gap-1.5"><i class="leyenda adentro"></i> Adentro ahora</span>
            </p>
          </section>

        </section>

        <!-- ==================== DÍA A DÍA: revisar y corregir ==================== -->
        <section data-vista="dia" hidden>
          <!-- Para revisar (de cualquier día) -->
          <section class="tarjeta mt-6 hidden !ring-ambar/40" data-revisar-seccion>
            <h2 class="seccion-titulo"><Icon name="seal-warning" class="size-6 text-ambar" /> Para revisar <span class="contador" data-revisar-cuantas></span></h2>
            <p class="mt-1 text-sm text-texto-2">Fichadas guardadas sin internet o que llegaron desde otra conexión de internet. Mirá la foto: si está bien, marcala.</p>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2" data-revisar></ul>
          </section>

          <div class="mt-6 flex flex-wrap items-center gap-2">
            <button type="button" class="boton-icono" aria-label="Día anterior" data-dia-mover="-1"><Icon name="caret-left" class="size-5" /></button>
            <h2 class="min-w-[13rem] text-center text-xl font-bold text-profundo first-letter:uppercase" data-dia-texto></h2>
            <button type="button" class="boton-icono" aria-label="Día siguiente" data-dia-mover="1"><Icon name="caret-right" class="size-5" /></button>
            <button type="button" class="boton boton-secundario !px-3 !py-1.5 !text-sm" data-dia-hoy>Hoy</button>
            <label class="ml-auto flex items-center gap-2 text-sm font-semibold text-texto-2"
              >Ir a
              <input type="date" class="campo !w-auto !py-1.5 !text-sm" data-dia-fecha />
            </label>
          </div>
          <div class="tira-dias mt-3" data-dias-tira></div>

          <section class="tarjeta mt-4 !p-2 sm:!p-3">
            <ul class="flex flex-col" data-dia-lista></ul>
          </section>
          <p class="mt-2 text-sm text-texto-2">Tocá <strong>Ver y corregir</strong> para ver las fotos, corregir una hora, cambiar entrada por salida o anular. Nada se borra: queda quién lo cambió y por qué.</p>
        </section>

        <!-- ==================== CONFIGURACIÓN ==================== -->
        <section data-vista="config" hidden>
          <details class="tarjeta mt-6" data-como open>
            <summary class="flex cursor-pointer list-none items-center gap-2">
              <Icon name="lightbulb" class="size-6 text-marca" />
              <span class="tarjeta-titulo flex-1">Cómo funciona el fichaje</span>
              <Icon name="caret-down" class="size-5 text-texto-2" />
            </summary>
            <ol class="pasos mt-4">
              <li>
                <strong>Se ficha solo en el local</strong>, en la compu o en el celular del local (la app <strong>Lola · Fichador</strong>): mirando a la cámara, o mostrándole el código de
                <strong>Fichar</strong> desde el celular propio. Desde otro lado no se puede.
              </li>
              <li><strong>Cada día, como mucho 2 entradas y 2 salidas</strong> (para el horario cortado). Si es entrada o salida, lo decide solo.</li>
              <li>
                <strong>Una sola vez:</strong> activá los aparatos (acá abajo). La cara, la carga horaria y el horario de cada una se cargan en su ficha, en <strong>Gestión de equipo</strong>.
              </li>
              <li><strong>Todos los días:</strong> en <strong>Hoy y semana</strong> ves quién vino y cómo va la semana; en <strong>Día a día</strong> revisás y corregís.</li>
              <li><strong>A fin de mes:</strong> en <strong>Inicio</strong>, abajo, <strong>Descargar todo</strong> baja un Excel con las horas y todo lo demás.</li>
            </ol>
            <p class="mt-3 text-sm text-texto-2">
              Para sumar a alguien o darlo de baja: <a class="enlace" href={url('/equipo')}>Gestión de equipo</a>.
            </p>
          </details>


          <section class="tarjeta mt-5">
            <h2 class="tarjeta-titulo flex items-center gap-2"><Icon name="desktop" class="size-6 text-marca" /> Aparatos que fichan</h2>
            <p class="tarjeta-sub">
              La compu y el celular del local. Para sumar uno: en ese aparato abrí <a class="enlace" href={linkFichador} target="_blank" rel="noopener">{linkFichador.replace('https://', '')}</a>, instalalo como app y
              tocá <strong>Activar con mi cuenta de admin</strong>.
            </p>
            <ul class="mt-3 flex flex-col gap-2" data-compus></ul>
          </section>


          <section class="tarjeta mt-5">
            <h2 class="tarjeta-titulo flex items-center gap-2"><Icon name="gear-six" class="size-6 text-marca" /> Ajustes del reconocimiento</h2>
            <form class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_auto]" data-ajustes>
              <label class="text-sm font-semibold text-profundo"
                >Exigencia del reconocimiento
                <select class="campo mt-1" name="similitud_min">
                  <option value="0.45">Suave</option>
                  <option value="0.5">Normal (recomendada)</option>
                  <option value="0.55">Estricta</option>
                </select>
              </label>
              <label class="text-sm font-semibold text-profundo"
                >Contra fotos
                <span class="campo mt-1 flex items-center gap-2 !py-2.5 font-normal">
                  <input type="checkbox" name="parpadeo" class="size-5 accent-[var(--color-marca)]" /> Pedir un parpadeo
                </span>
              </label>
              <label class="text-sm font-semibold text-profundo"
                >Tolerancia para el horario fijo (minutos)
                <input class="campo mt-1" name="tolerancia_min" type="number" min="0" max="60" step="1" />
              </label>
              <button type="submit" class="boton boton-principal self-end">Guardar</button>
            </form>
            <p class="mt-2 text-xs text-texto-2">
              Si el fichador confunde personas, subí la exigencia. Si a alguien le cuesta que la reconozca, volvé a registrar su cara con buena luz. "Pedir un parpadeo" frena a quien quiera fichar
              con una foto impresa, a cambio de un segundo más. Para ver los números con la cámara del local, abrí el fichador con <strong>?calibrar</strong> al final de la dirección.
            </p>
          </section>
        </section>

        <button type="button" class="mt-6 text-sm font-semibold text-marca underline underline-offset-4" data-recargar>Actualizar datos</button>
      </div>
    </div>
  </main>

  <dialog class="detalle" data-detalle>
    <div class="detalle-caja">
      <div class="flex items-start gap-3">
        <div class="min-w-0 flex-1">
          <p class="text-xl font-bold text-profundo" data-detalle-titulo></p>
          <p class="text-sm text-texto-2 first-letter:uppercase" data-detalle-sub></p>
        </div>
        <button type="button" class="boton-icono" aria-label="Cerrar" data-detalle-cerrar><Icon name="x" class="size-6" /></button>
      </div>
      <ul class="mt-4 flex flex-col gap-3" data-detalle-lista></ul>
      <form class="mt-5 rounded-2xl bg-crema p-4" data-agregar-fichada>
        <p class="font-semibold text-profundo">Agregar una fichada que faltó</p>
        <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-[auto_auto_1fr_auto]">
          <select class="campo" name="tipo" aria-label="Tipo">
            <option value="entrada">Entrada</option>
            <option value="salida">Salida</option>
          </select>
          <input class="campo" type="time" name="hora" required aria-label="Hora" />
          <input class="campo col-span-2 sm:col-span-1" name="nota" required placeholder="Por qué (ej.: se olvidó de fichar)" aria-label="Motivo" />
          <button type="submit" class="boton boton-principal col-span-2 !py-2 sm:col-span-1">Agregar</button>
        </div>
      </form>
    </div>
  </dialog>
</Manual>

<style>
  .seccion-titulo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .sub-titulo {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .contador {
    border-radius: 9999px;
    background: var(--color-ambar-suave);
    padding: 2px 10px;
    font-size: 0.875rem;
    color: var(--color-ambar);
  }
  /* :global porque también los usan las tarjetas y campos que se arman desde el script. */
  :global(.tarjeta) {
    border-radius: 24px;
    background: #fff;
    padding: 20px;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  .tarjeta summary::-webkit-details-marker {
    display: none;
  }
  .tarjeta[open] summary :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .tarjeta-titulo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .tarjeta-sub {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--color-texto-2);
  }
  .enlace {
    font-weight: 600;
    color: var(--color-profundo);
    text-decoration: underline;
    text-decoration-color: var(--color-marca);
    text-underline-offset: 3px;
    word-break: break-all;
  }
  :global(.campo) {
    width: 100%;
    border-radius: 14px;
    background: var(--color-crema);
    padding: 10px 12px;
    font-size: 1rem;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.18);
    outline: none;
  }
  :global(.campo:focus) {
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  .boton-icono {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-profundo);
  }
  .boton-icono:hover {
    background: var(--color-menta-suave);
  }
  .detalle {
    width: min(620px, calc(100% - 24px));
    max-height: calc(100svh - 32px);
    margin: auto;
    border-radius: 28px;
    padding: 0;
    background: #fff;
    box-shadow: 0 40px 100px -30px rgb(33 76 59 / 0.6);
  }
  .detalle::backdrop {
    background: rgb(33 76 59 / 0.35);
    backdrop-filter: blur(4px);
  }
  .detalle-caja {
    padding: 22px;
  }
  :global(.marca) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 9999px;
    padding: 2px 8px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  /* Los estilos de la página ganan sobre la clase hidden de Tailwind: se repite acá. */
  :global(.marca.hidden) {
    display: none;
  }
  :global(.marca-ambar) {
    background: var(--color-ambar-suave);
    color: var(--color-ambar);
  }
  :global(.marca-gris) {
    background: var(--color-arena-suave);
    color: var(--color-texto-2);
  }
  :global(.marca-verde) {
    background: var(--color-menta-suave);
    color: var(--color-profundo);
  }
  :global(.dia-fila) {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 10px;
    border-radius: 14px;
    padding: 8px 10px;
    text-align: left;
  }
  :global(.dia-fila:hover) {
    background: var(--color-menta-suave);
  }
  :global(.foto-fichada) {
    width: 88px;
    height: 66px;
    flex: none;
    border-radius: 12px;
    background: var(--color-menta-suave);
    object-fit: cover;
    transform: scaleX(-1);
  }
  .pasos {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 1.25rem;
    list-style: decimal;
    font-size: 0.9375rem;
    color: var(--color-texto);
  }
  .pasos li::marker {
    font-weight: 700;
    color: var(--color-marca);
  }
  :global(.barra-carga) {
    height: 8px;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-menta-suave);
  }
  :global(.barra-carga span) {
    display: block;
    height: 100%;
    border-radius: 9999px;
    background: var(--color-marca);
  }
  /* ---------- Resumen: números de arriba ---------- */
  :global(.metrica) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 20px;
    background: #fff;
    padding: 14px 16px;
    text-align: left;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  :global(button.metrica:hover) {
    box-shadow: inset 0 0 0 2px var(--color-ambar);
  }
  :global(.metrica.aviso) {
    background: var(--color-ambar-suave);
  }
  :global(.metrica-titulo) {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-texto-2);
  }
  :global(.metrica-valor) {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 800;
    color: var(--color-profundo);
    font-variant-numeric: tabular-nums;
  }
  :global(.metrica.aviso .metrica-valor) {
    color: var(--color-ambar);
  }
  :global(.metrica-sub) {
    font-size: 0.75rem;
    color: var(--color-texto-2);
  }

  /* ---------- Resumen: línea de tiempo de hoy ---------- */
  :global(.linea-fila),
  :global(.linea-eje) {
    display: grid;
    width: 100%;
    grid-template-columns: 76px minmax(0, 1fr);
    gap: 2px 10px;
  }
  :global(.linea-fila) {
    grid-template-areas: 'nombre pista' '. texto';
    align-items: center;
    border-radius: 12px;
    padding: 6px 8px;
    text-align: left;
  }
  :global(.linea-fila:hover) {
    background: var(--color-menta-suave);
  }
  :global(.linea-eje) {
    padding: 2px 8px 0;
  }
  @media (min-width: 640px) {
    :global(.linea-fila),
    :global(.linea-eje) {
      grid-template-columns: 110px minmax(0, 1fr) 220px;
    }
    :global(.linea-fila) {
      grid-template-areas: 'nombre pista texto';
    }
  }
  :global(.linea-nombre) {
    grid-area: nombre;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  :global(.linea-pista) {
    position: relative;
    grid-area: pista;
    height: 18px;
    border-radius: 6px;
    background: var(--color-crema);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.06);
  }
  :global(.linea-tramo) {
    position: absolute;
    top: 2px;
    bottom: 2px;
    border-radius: 5px;
    background: var(--color-marca);
  }
  :global(.linea-tramo.abierto),
  .leyenda-tramo.abierto {
    background: var(--color-menta);
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  :global(.linea-suelta) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-ambar);
  }
  :global(.linea-ahora) {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: var(--color-peligro);
    opacity: 0.7;
  }
  :global(.linea-texto) {
    grid-area: texto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--color-texto-2);
    font-variant-numeric: tabular-nums;
  }
  :global(.linea-texto.adentro) {
    font-weight: 700;
    color: var(--color-marca);
  }
  :global(.linea-apagado) {
    font-weight: 500;
    color: var(--color-texto-2) !important;
  }
  :global(.linea-reglas) {
    position: relative;
    height: 16px;
    font-size: 0.6875rem;
    color: var(--color-texto-2);
  }
  :global(.linea-reglas span) {
    position: absolute;
    transform: translateX(-50%);
  }
  .leyenda-tramo {
    display: inline-block;
    width: 18px;
    height: 10px;
    border-radius: 4px;
    background: var(--color-marca);
  }

  /* ---------- Resumen: planilla de la semana ---------- */
  .planilla-caja {
    margin: 0 -8px;
    overflow-x: auto;
    padding: 0 8px;
  }
  :global(.planilla) {
    width: 100%;
    min-width: 660px;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 4px;
  }
  :global(.planilla th) {
    padding: 2px;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-texto-2);
  }
  :global(.planilla th.es-hoy) {
    color: var(--color-marca);
  }
  :global(.planilla thead .col-nombre) {
    width: 120px;
  }
  :global(.planilla thead .col-total) {
    width: 118px;
  }
  :global(.planilla .col-nombre) {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 96px;
    max-width: 140px;
    overflow: hidden;
    background: #fff;
    text-align: left;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    color: var(--color-profundo);
  }
  :global(.planilla .col-total) {
    min-width: 108px;
    padding-left: 8px;
    text-align: left;
    font-size: 0.875rem;
  }
  :global(.planilla td) {
    padding: 0;
  }
  :global(.celda) {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 50px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    padding: 4px;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    transition: transform 120ms;
  }
  :global(.celda:hover) {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -10px rgb(33 76 59 / 0.6);
  }
  :global(.celda.ok),
  .leyenda.ok {
    background: var(--color-menta-suave);
    color: var(--color-profundo);
  }
  :global(.celda.alerta),
  .leyenda.alerta {
    background: var(--color-ambar-suave);
    color: var(--color-ambar);
  }
  :global(.celda.adentro),
  .leyenda.adentro {
    background: var(--color-marca);
    color: #fff;
  }
  :global(.celda.vacia) {
    background: var(--color-crema);
    font-weight: 500;
    color: rgb(33 76 59 / 0.35);
  }
  :global(td.es-hoy .celda) {
    outline: 2px solid rgb(33 76 59 / 0.25);
    outline-offset: 1px;
  }
  :global(.celda-sub) {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  :global(.celda-punto) {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-ambar);
    box-shadow: 0 0 0 2px #fff;
  }
  .leyenda {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }

  /* ---------- Día a día ---------- */
  .tira-dias {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
  }
  :global(.dia-tira) {
    position: relative;
    border-radius: 14px;
    background: #fff;
    padding: 8px 4px;
    text-align: center;
    color: var(--color-texto-2);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  :global(.dia-tira:hover) {
    background: var(--color-menta-suave);
  }
  :global(.dia-tira.es-hoy) {
    color: var(--color-marca);
  }
  :global(.dia-tira.elegido) {
    background: var(--color-profundo);
    color: #fff;
    box-shadow: none;
  }
  :global(.fila-dia) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    border-radius: 16px;
    padding: 12px;
    transition: background 300ms;
  }
  :global(.fila-dia + .fila-dia) {
    box-shadow: 0 -1px 0 rgb(33 76 59 / 0.08);
  }
  :global(.fila-dia.resaltada) {
    background: var(--color-menta-suave);
  }
  :global(.chip-fichada) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 10px;
    background: var(--color-crema);
    padding: 4px 10px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-profundo);
    font-variant-numeric: tabular-nums;
  }
  :global(.chip-fichada.salida) {
    background: var(--color-menta-suave);
  }
  :global(.chip-extra) {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-texto-2);
  }
  :global(.grilla-horario) {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    gap: 6px 8px;
    align-items: center;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { sesionLista } from '../scripts/sesion';
  import { irAVista, parametrosVista } from '../scripts/vistas';
  import { hora, diaClave, diaLargo, duracion, tramos, type Fichada, type Tramo } from '../lib/fichador';

  // ---------- Tipos ----------
  interface Persona {
    email: string;
    nombre: string | null;
    rol: 'empleada' | 'admin';
    activo: boolean;
    horario_fijo: boolean;
    /** Carga horaria: horas por semana (null = sin cargar). */
    horas_semana: number | null;
  }
  interface FichadaCompleta extends Fichada {
    similitud: number | null;
    revisada_por: string | null;
    anulada_por: string | null;
    anulada_motivo: string | null;
    motivo: string | null;
    nota: string | null;
    corregida_por: string | null;
  }
  interface Cara {
    id: number;
    email: string;
    foto: string | null;
    creada_el: string;
    /** Si al registrarla se parecía a otra persona y la admin confirmó que era otra (por ejemplo, un familiar). */
    parecida_a: string | null;
  }
  interface Compu {
    id: string;
    nombre: string;
    activo: boolean;
    creado_por: string;
    creado_el: string;
    ultimo_uso: string | null;
  }
  interface Horario {
    email: string;
    dia: number;
    entrada: string;
    salida: string;
  }
  interface SinReconocer {
    id: number;
    hora: string;
    foto: string | null;
  }
  interface Ajustes {
    similitud_min: number;
    tolerancia_min: number;
    horas_max_turno: number;
    parpadeo: boolean;
  }

  const COLUMNAS = 'id,email,tipo,hora,metodo,similitud,sin_conexion,revisar,revisada_el,revisada_por,anulada,anulada_por,anulada_motivo,motivo,creada_por,nota,hora_original,corregida_por';
  const DIAS = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

  // ---------- Utilidades ----------
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto = '') => {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  };
  const boton = (texto: string, clase: string, accion: () => void) => {
    const b = el('button', `boton !py-1.5 !px-3 !text-sm ${clase}`, texto);
    b.type = 'button';
    b.addEventListener('click', accion);
    return b;
  };
  const nombreDe = (email: string) => {
    const p = personas.find((x) => x.email === email);
    return p?.nombre || email.split('@')[0];
  };
  /** Medianoche de un día de Argentina, como ISO. */
  const inicioDia = (dia: string) => `${dia}T00:00:00-03:00`;
  const sumarDias = (dia: string, n: number) => diaClave(new Date(new Date(`${dia}T12:00:00-03:00`).getTime() + n * 86400000));
  const diaSemana = (dia: string) => new Date(`${dia}T12:00:00-03:00`).getUTCDay();
  const lunesDe = (dia: string) => sumarDias(dia, -((diaSemana(dia) + 6) % 7));
  const minutos = (hhmm: string) => {
    const [h, m] = hhmm.split(':').map(Number);
    return h * 60 + m;
  };
  const minutosDe = (iso: string) => minutos(hora(iso));

  // ---------- Estado ----------
  let personas: Persona[] = [];
  let ajustes: Ajustes = { similitud_min: 0.5, tolerancia_min: 15, horas_max_turno: 16, parpadeo: false };
  let horarios: Horario[] = [];
  let conCara = new Set<string>();
  let lunes = lunesDe(diaClave(new Date()));
  let semana: FichadaCompleta[] = [];

  async function q<T>(p: PromiseLike<{ data: T | null; error: unknown }>): Promise<T> {
    const { data, error } = await p;
    if (error) throw error;
    return data as T;
  }

  /** Supabase devuelve como mucho 1000 filas por pedido: se piden de a 1000 hasta traer todo. */
  async function todas<T>(armar: (desde: number, hasta: number) => PromiseLike<{ data: T[] | null; error: unknown }>): Promise<T[]> {
    const filas: T[] = [];
    for (let desde = 0; ; desde += 1000) {
      const parte = await q<T[]>(armar(desde, desde + 999));
      filas.push(...parte);
      if (parte.length < 1000) return filas;
    }
  }

  const LIMITE_DIA = 'Ese día ya tiene 2 entradas y 2 salidas, que es el máximo (horario cortado). Si una está mal, anulala primero.';
  const esLimite = (error: unknown) => /limite_dia/.test((error as { message?: string } | null)?.message ?? '');

  /** Ejecuta un cambio y avisa si falló (nada falla en silencio). */
  async function accion(p: PromiseLike<{ error: unknown }>, texto = 'No se pudo guardar. Revisá la conexión y probá de nuevo.') {
    const { error } = await p;
    if (error) alert(esLimite(error) ? LIMITE_DIA : texto);
    return !error;
  }

  // ---------- Carga ----------
  /** Las que fichan: activas, empleadas o con cara registrada (la encargada también puede fichar). */
  const quienesFichan = () => personas.filter((p) => p.activo && (p.rol === 'empleada' || conCara.has(p.email) || p.horas_semana));

  /** Fichadas entre dos días de Argentina (desde incluido, hasta excluido), de a 1000. */
  const fichadasEntre = (desde: string, hasta: string) =>
    todas<FichadaCompleta>((a, b) => supabase!.from('fichadas').select(COLUMNAS).gte('hora', inicioDia(desde)).lt('hora', inicioDia(hasta)).order('hora').order('id').range(a, b));

  async function cargarTodo() {
    const db = supabase!;
    const [ps, aj, hs, cs] = await Promise.all([
      q<Persona[]>(db.from('autorizados').select('email,nombre,rol,activo,horario_fijo,horas_semana').order('nombre')),
      q<Ajustes[]>(db.from('ajustes_fichador').select('similitud_min,tolerancia_min,horas_max_turno,parpadeo')),
      q<Horario[]>(db.from('horarios').select('email,dia,entrada,salida')),
      q<{ email: string }[]>(db.from('caras').select('email')),
    ]);
    conCara = new Set(cs.map((c) => c.email));
    personas = ps;
    if (aj[0]) ajustes = aj[0];
    horarios = hs;
    await Promise.all([pintarHoy(), pintarRevisar(), cargarSemana(), cargarDia(), pintarConfig()]);
  }

  // ---------- Resumen: los números de arriba ----------
  let hoyTramos: Tramo[] = [];
  let semanaActualMs = 0;
  let cuantasRevisar = 0;

  function pintarMetricas() {
    const fichan = quienesFichan();
    const adentro = new Set(hoyTramos.filter((t) => t.entrada && !t.salida).map((t) => t.email)).size;
    const vinieron = new Set(hoyTramos.map((t) => t.email)).size;
    const carga = fichan.reduce((s, p) => s + Number(p.horas_semana ?? 0), 0);
    const horas = Math.floor(semanaActualMs / 3600000);
    const tarjeta = (titulo: string, valor: string, sub: string, aviso = false, alTocar?: () => void) => {
      const c = el(alTocar ? 'button' : 'div', `metrica${aviso ? ' aviso' : ''}`);
      if (alTocar) {
        (c as HTMLButtonElement).type = 'button';
        c.addEventListener('click', alTocar);
      }
      c.append(el('span', 'metrica-titulo', titulo), el('span', 'metrica-valor', valor), el('span', 'metrica-sub', sub));
      return c;
    };
    $('[data-metricas]').replaceChildren(
      tarjeta('Ahora en el local', String(adentro), adentro === 1 ? 'persona adentro' : 'personas adentro'),
      tarjeta('Hoy ficharon', `${vinieron} de ${fichan.length}`, 'del equipo'),
      tarjeta('Para revisar', String(cuantasRevisar), cuantasRevisar ? 'Tocá para verlas' : 'Todo en orden', cuantasRevisar > 0, cuantasRevisar ? () => {
        irAVista('dia');
        $('[data-revisar-seccion]').scrollIntoView({ block: 'start', behavior: 'smooth' });
      } : undefined),
      tarjeta('Horas de esta semana', `${horas} h`, carga ? `de ${Math.round(carga)} h de carga horaria` : 'entre todas'),
    );
  }

  // ---------- Resumen: hoy, en una línea de tiempo ----------
  async function pintarHoy() {
    const hoy = diaClave(new Date());
    const l = lunesDe(hoy);
    // La semana actual entera: sirve para hoy y para las horas de la semana.
    const fs = (await fichadasEntre(l, sumarDias(l, 7))).filter((f) => !f.anulada);
    const ts = tramosPorPersona(fs);
    hoyTramos = ts.filter((t) => t.dia === hoy);
    semanaActualMs = ts.reduce((s, t) => s + t.ms, 0);
    $('[data-hoy-fecha]').textContent = diaLargo(new Date());
    pintarLineaHoy();
    pintarMetricas();
  }

  function pintarLineaHoy() {
    const hoy = diaClave(new Date());
    const ahora = minutosDe(new Date().toISOString());
    const conFichadas = [...new Set(hoyTramos.map((t) => t.email))];
    const primera = (email: string) => Math.min(...hoyTramos.filter((t) => t.email === email).map((t) => minutosDe((t.entrada ?? t.salida)!.hora)));
    conFichadas.sort((a, b) => primera(a) - primera(b));
    const emails = [...conFichadas, ...quienesFichan().map((p) => p.email).filter((e) => !conFichadas.includes(e))];
    const caja = $('[data-linea-hoy]');
    if (!emails.length) {
      caja.replaceChildren(el('p', 'text-sm text-texto-2', 'Todavía no hay nadie en el equipo.'));
      return;
    }
    // El eje: de 8 a 21 h, o más si alguien fichó antes o después.
    const marcas = hoyTramos.flatMap((t) => [t.entrada, t.salida].filter(Boolean).map((f) => minutosDe(f!.hora)));
    const desde = Math.min(8 * 60, ...marcas.map((m) => Math.floor(m / 60) * 60));
    const hasta = Math.min(24 * 60, Math.max(21 * 60, ahora + 30, ...marcas.map((m) => Math.ceil(m / 60) * 60)));
    const pos = (m: number) => `${((Math.max(desde, Math.min(hasta, m)) - desde) / (hasta - desde)) * 100}%`;

    const filas = emails.map((email) => {
      const mios = hoyTramos.filter((t) => t.email === email);
      const fila = el('button', 'linea-fila');
      fila.type = 'button';
      fila.title = 'Ver y corregir';
      fila.addEventListener('click', () => void abrirDetalle(email, hoy));
      const pista = el('span', 'linea-pista');
      for (const t of mios) {
        if (!t.entrada) {
          const suelta = el('i', 'linea-suelta');
          suelta.style.left = pos(minutosDe(t.salida!.hora));
          pista.append(suelta);
          continue;
        }
        const ini = minutosDe(t.entrada.hora);
        const fin = t.salida ? minutosDe(t.salida.hora) : ahora;
        const b = el('i', `linea-tramo${t.salida ? '' : ' abierto'}`);
        b.style.left = pos(ini);
        b.style.width = `max(6px, calc(${pos(fin)} - ${pos(ini)}))`;
        pista.append(b);
      }
      if (ahora >= desde && ahora <= hasta) {
        const ya = el('i', 'linea-ahora');
        ya.style.left = pos(ahora);
        pista.append(ya);
      }
      const total = mios.reduce((s, t) => s + t.ms, 0);
      const abierto = mios.find((t) => t.entrada && !t.salida);
      const texto = abierto
        ? `Adentro desde las ${hora(abierto.entrada!.hora)}`
        : mios.length
          ? `${mios.map((t) => `${t.entrada ? hora(t.entrada.hora) : '¿?'}–${t.salida ? hora(t.salida.hora) : '¿?'}`).join(' y ')} · ${duracion(total)}`
          : 'Todavía no fichó';
      fila.append(
        el('span', `linea-nombre${mios.length ? '' : ' linea-apagado'}`, nombreDe(email)),
        pista,
        el('span', `linea-texto${abierto ? ' adentro' : mios.length ? '' : ' linea-apagado'}`, texto),
      );
      return fila;
    });
    const eje = el('div', 'linea-eje');
    eje.append(el('span'));
    const reglas = el('span', 'linea-reglas');
    for (let h = Math.ceil(desde / 60); h <= Math.floor(hasta / 60); h += 2) {
      const r = el('span', '', `${h} h`);
      r.style.left = pos(h * 60);
      reglas.append(r);
    }
    eje.append(reglas);
    caja.replaceChildren(...filas, eje);
  }

  // ---------- Para revisar ----------
  async function pintarRevisar() {
    const fs = await q<FichadaCompleta[]>(
      supabase!
        .from('fichadas')
        .select(COLUMNAS)
        .not('revisar', 'is', null)
        .is('revisada_el', null)
        .eq('anulada', false)
        .gte('hora', new Date(Date.now() - 30 * 86400000).toISOString())
        .order('hora', { ascending: false }),
    );
    const sin = await q<SinReconocer[]>(
      supabase!.from('fichadas_sin_reconocer').select('id,hora,foto').is('resuelta_el', null).order('hora', { ascending: false }),
    );
    $('[data-revisar-seccion]').classList.toggle('hidden', !fs.length && !sin.length);
    $('[data-revisar-cuantas]').textContent = String(fs.length + sin.length);
    cuantasRevisar = fs.length + sin.length;
    pintarMetricas();
    $('[data-revisar]').replaceChildren(
      ...sin.map((x) => filaSinReconocer(x)),
      ...fs.map((f) => {
        const li = el('li', 'flex gap-3 rounded-2xl bg-white p-3 ring-1 ring-ambar/30');
        const img = el('img', 'foto-fichada');
        img.alt = `Foto de la fichada de ${nombreDe(f.email)}`;
        const txt = el('div', 'min-w-0 flex-1');
        txt.append(
          el('p', 'font-bold text-profundo', nombreDe(f.email)),
          el('p', 'text-sm text-texto-2 tabular-nums first-letter:uppercase', `${diaLargo(f.hora)} · ${f.tipo} ${hora(f.hora)}`),
          el('p', 'mt-1 text-xs font-semibold text-ambar', f.revisar ?? ''),
        );
        const acciones = el('div', 'mt-2 flex flex-wrap gap-2');
        acciones.append(
          boton('Está bien', 'boton-principal', async () => {
            if (await accion(supabase!.rpc('marcar_revisada', { p_id: f.id }))) void refrescar();
          }),
          boton('Anular', 'bg-peligro-suave text-peligro hover:bg-peligro hover:text-white', () => void anular(f)),
        );
        txt.append(acciones);
        li.append(img, txt);
        void ponerFoto(img, f.id);
        return li;
      }),
    );
  }

  /** Guardada sin internet y la cara no se reconoció: la admin mira la foto y dice de quién es. */
  function filaSinReconocer(x: SinReconocer) {
    const li = el('li', 'flex gap-3 rounded-2xl bg-white p-3 ring-1 ring-ambar/30');
    if (x.foto) {
      const img = el('img', 'foto-fichada');
      img.src = x.foto;
      img.alt = 'Foto de la fichada sin reconocer';
      li.append(img);
    } else li.append(el('span', 'foto-fichada flex items-center justify-center text-center text-[0.7rem] text-texto-2', 'Sin foto'));
    const txt = el('div', 'min-w-0 flex-1');
    txt.append(
      el('p', 'font-bold text-profundo', '¿Quién es?'),
      el('p', 'text-sm text-texto-2 tabular-nums first-letter:uppercase', `${diaLargo(x.hora)} · ${hora(x.hora)}`),
      el('p', 'mt-1 text-xs font-semibold text-ambar', 'Se guardó sin internet y la cara no se reconoció al mandarla'),
    );
    const form = el('form', 'mt-2 flex flex-wrap gap-2');
    const quien = el('select', 'campo !w-auto !py-1.5 !text-sm');
    quien.setAttribute('aria-label', 'Persona');
    for (const p of personas.filter((p) => p.activo)) quien.append(Object.assign(el('option', '', p.nombre || p.email.split('@')[0]), { value: p.email }));
    const tipo = el('select', 'campo !w-auto !py-1.5 !text-sm');
    tipo.setAttribute('aria-label', 'Entrada o salida');
    tipo.append(Object.assign(el('option', '', 'Entrada'), { value: 'entrada' }), Object.assign(el('option', '', 'Salida'), { value: 'salida' }));
    const asignar = el('button', 'boton boton-principal !py-1.5 !px-3 !text-sm', 'Asignar');
    asignar.type = 'submit';
    form.append(
      quien,
      tipo,
      asignar,
      boton('Descartar', 'bg-peligro-suave text-peligro hover:bg-peligro hover:text-white', async () => {
        if (!confirm('¿Descartarla? No se va a contar para nadie.')) return;
        if (await accion(supabase!.rpc('descartar_sin_reconocer', { p_id: x.id }))) void refrescar();
      }),
    );
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (await accion(supabase!.rpc('asignar_sin_reconocer', { p_id: x.id, p_email: quien.value, p_tipo: tipo.value }))) void refrescar();
    });
    txt.append(form);
    li.append(txt);
    return li;
  }

  const fotos = new Map<number, string | null>();
  async function ponerFoto(img: HTMLImageElement, id: number) {
    if (!fotos.has(id)) {
      const { data } = await supabase!.from('fotos_fichada').select('foto').eq('fichada_id', id).maybeSingle();
      fotos.set(id, (data?.foto as string) ?? null);
    }
    const f = fotos.get(id);
    if (f) img.src = f;
    else img.replaceWith(el('span', 'foto-fichada flex items-center justify-center text-center text-[0.7rem] text-texto-2', 'Sin foto'));
  }

  // ---------- Semana ----------
  function tramosPorPersona(fs: Fichada[]) {
    const por = new Map<string, Fichada[]>();
    for (const f of fs) por.set(f.email, [...(por.get(f.email) ?? []), f]);
    return [...por.values()].flatMap((lista) => tramos(lista, ajustes.horas_max_turno));
  }

  /** Marcas de horario fijo (solo si la persona lo tiene prendido): el texto largo y uno corto para la planilla. */
  function marcasHorario(email: string, dia: string, ts: Tramo[]): { texto: string; corto: string }[] {
    const p = personas.find((x) => x.email === email);
    if (!p?.horario_fijo) return [];
    const h = horarios.find((x) => x.email === email && x.dia === diaSemana(dia));
    if (!h) return ts.length ? [{ texto: 'Día fuera de su horario', corto: 'Fuera de horario' }] : [];
    const marcas: { texto: string; corto: string }[] = [];
    const tol = ajustes.tolerancia_min;
    const primera = ts.find((t) => t.entrada)?.entrada;
    const ultima = [...ts].reverse().find((t) => t.salida)?.salida;
    if (primera) {
      const tarde = minutosDe(primera.hora) - minutos(h.entrada);
      if (tarde > tol) marcas.push({ texto: `Llegó ${tarde} min tarde`, corto: `Tarde ${tarde}′` });
    }
    if (ultima) {
      const antes = minutos(h.salida) - minutosDe(ultima.hora);
      if (antes > tol) marcas.push({ texto: `Se fue ${antes} min antes`, corto: `Antes ${antes}′` });
    }
    return marcas;
  }

  /** Horas de la carga horaria como texto: 30 → "30 h", 22.5 → "22 h 30". */
  const horasTexto = (h: number) => (Number.isInteger(h) ? `${h} h` : duracion(h * 3600000));

  /** Cuánto lleva contra su carga horaria de la semana. */
  function avanceCarga(ms: number, horas: number, semanaActual: boolean) {
    const falta = horas * 3600000 - ms;
    if (Math.abs(falta) < 5 * 60000) return { texto: 'Cumplió', clase: 'text-marca' };
    if (falta > 0) return { texto: `${semanaActual ? 'Faltan' : 'Faltaron'} ${duracion(falta)}`, clase: semanaActual ? 'text-texto-2' : 'text-ambar' };
    return { texto: `${duracion(-falta)} de más`, clase: 'text-marca' };
  }

  /** Cómo está un día de una persona: para la celda de la planilla y la fila del Día a día. */
  function estadoDia(email: string, dia: string, ts: Tramo[], fs: FichadaCompleta[]) {
    const hoy = diaClave(new Date());
    const abierto = ts.some((t) => t.entrada && !t.salida);
    const faltaSalida = abierto && dia !== hoy;
    const faltaEntrada = ts.some((t) => !t.entrada);
    const marcas = marcasHorario(email, dia, ts);
    const revisar = fs.some((f) => !f.anulada && f.revisar && !f.revisada_el);
    const ms = ts.reduce((s, t) => s + t.ms, 0);
    return { abierto: abierto && !faltaSalida, faltaSalida, faltaEntrada, marcas, revisar, ms };
  }

  async function cargarSemana() {
    semana = await fichadasEntre(lunes, sumarDias(lunes, 7));
    pintarPlanilla();
  }

  /** La planilla: una fila por persona, una columna por día y el total contra la carga horaria. */
  function pintarPlanilla() {
    const dias = Array.from({ length: 7 }, (_, i) => sumarDias(lunes, i));
    const hoy = diaClave(new Date());
    const actual = lunes === lunesDe(hoy);
    const fmt = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', timeZone: 'America/Argentina/Buenos_Aires' });
    $('[data-semana-texto]').textContent = `${fmt.format(new Date(`${dias[0]}T12:00:00-03:00`))} al ${fmt.format(new Date(`${dias[6]}T12:00:00-03:00`))}`;
    const validas = semana.filter((f) => !f.anulada);
    const ts = tramosPorPersona(validas).filter((t) => dias.includes(t.dia));
    const quienes = personas.filter((p) => quienesFichan().includes(p) || ts.some((t) => t.email === p.email));

    const tabla = el('table', 'planilla');
    const cab = el('tr');
    cab.append(el('th', 'col-nombre', ''));
    for (const d of dias) {
      const th = el('th', d === hoy ? 'es-hoy' : '');
      th.append(el('span', 'block', DIAS[diaSemana(d)].slice(0, 3)), el('span', 'block text-xs font-normal', String(Number(d.slice(8)))));
      cab.append(th);
    }
    cab.append(el('th', 'col-total', 'Total'));
    const thead = el('thead');
    thead.append(cab);
    const cuerpo = el('tbody');
    for (const p of quienes) {
      const tr = el('tr');
      tr.append(el('th', 'col-nombre', p.nombre || p.email.split('@')[0]));
      let total = 0;
      for (const d of dias) {
        const delDia = ts.filter((t) => t.email === p.email && t.dia === d);
        const fsDia = semana.filter((f) => f.email === p.email && diaClave(f.hora) === d);
        const td = el('td', d === hoy ? 'es-hoy' : '');
        const b = el('button', 'celda');
        b.type = 'button';
        b.addEventListener('click', () => void irADia(d, p.email));
        const e = estadoDia(p.email, d, delDia, fsDia);
        total += e.ms;
        let texto: string;
        let clase: string;
        if (!delDia.length) {
          texto = d > hoy ? '' : '—';
          clase = 'vacia';
        } else if (e.faltaSalida) {
          texto = 'Falta salida';
          clase = 'alerta';
        } else if (e.faltaEntrada) {
          texto = 'Falta entrada';
          clase = 'alerta';
        } else if (e.abierto) {
          texto = 'Adentro';
          clase = 'adentro';
        } else {
          texto = duracion(e.ms);
          clase = e.marcas.length ? 'alerta' : 'ok';
        }
        b.classList.add(clase);
        b.append(el('span', 'block', texto));
        if (e.marcas.length) b.append(el('span', 'celda-sub', e.marcas.map((m) => m.corto).join(' · ')));
        if (e.revisar) b.append(el('i', 'celda-punto'));
        b.title = [`${p.nombre || p.email.split('@')[0]}, ${diaLargo(`${d}T12:00:00-03:00`)}`, texto, ...e.marcas.map((m) => m.texto), e.revisar ? 'Hay algo para revisar' : '']
          .filter(Boolean)
          .join(' · ');
        td.append(b);
        tr.append(td);
      }
      const tdTotal = el('td', 'col-total');
      tdTotal.append(el('span', 'block font-bold text-profundo tabular-nums', duracion(total)));
      if (p.horas_semana) {
        const horas = Number(p.horas_semana);
        const a = avanceCarga(total, horas, actual);
        const barra = el('span', 'barra-carga mt-1 block');
        const lleno = el('span');
        lleno.style.width = `${Math.min(100, (total / (horas * 3600000)) * 100)}%`;
        barra.append(lleno);
        tdTotal.append(el('span', 'block text-xs text-texto-2', `de ${horasTexto(horas)}`), barra, el('span', `block text-xs font-semibold ${a.clase}`, a.texto));
      }
      tr.append(tdTotal);
      cuerpo.append(tr);
    }
    tabla.append(thead, cuerpo);
    $('[data-planilla]').replaceChildren(quienes.length ? tabla : el('p', 'text-sm text-texto-2', 'Todavía no hay nadie en el equipo.'));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-semana]').forEach((b) =>
    b.addEventListener('click', () => {
      const n = Number(b.dataset.semana);
      lunes = n === 0 ? lunesDe(diaClave(new Date())) : sumarDias(lunes, n * 7);
      void cargarSemana();
    }),
  );

  // ---------- Día a día ----------
  let diaVista = diaClave(new Date());
  let semanaDia: FichadaCompleta[] = [];
  let lunesDia = '';

  /** Trae la semana del día elegido (si hace falta) y lo pinta. */
  async function cargarDia(forzar = true) {
    const l = lunesDe(diaVista);
    if (forzar || l !== lunesDia) {
      semanaDia = await fichadasEntre(l, sumarDias(l, 7));
      lunesDia = l;
    }
    pintarDia();
  }

  /** Desde la planilla (o la línea de hoy): abre el día y marca a la persona. */
  async function irADia(dia: string, email?: string) {
    diaVista = dia;
    await cargarDia(false);
    irAVista('dia');
    if (!email) return;
    const fila = document.querySelector<HTMLElement>(`[data-dia-lista] [data-email="${CSS.escape(email)}"]`);
    if (!fila) return;
    requestAnimationFrame(() => fila.scrollIntoView({ block: 'center' }));
    fila.classList.add('resaltada');
    setTimeout(() => fila.classList.remove('resaltada'), 1800);
  }

  function pintarDia() {
    const hoy = diaClave(new Date());
    $('[data-dia-texto]').textContent = diaVista === hoy ? `Hoy, ${diaLargo(`${diaVista}T12:00:00-03:00`)}` : diaLargo(`${diaVista}T12:00:00-03:00`);
    $<HTMLInputElement>('[data-dia-fecha]').value = diaVista;
    const validas = semanaDia.filter((f) => !f.anulada);
    const ts = tramosPorPersona(validas);

    // La tira de la semana: un botón por día, con un punto si hay algo para mirar.
    const l = lunesDe(diaVista);
    $('[data-dias-tira]').replaceChildren(
      ...Array.from({ length: 7 }, (_, i) => {
        const d = sumarDias(l, i);
        const b = el('button', `dia-tira${d === diaVista ? ' elegido' : ''}${d === hoy ? ' es-hoy' : ''}`);
        b.type = 'button';
        b.append(el('span', 'block text-xs', DIAS[diaSemana(d)].slice(0, 3)), el('span', 'block text-lg font-bold', String(Number(d.slice(8)))));
        const alerta = personas.some((p) => {
          const e = estadoDia(p.email, d, ts.filter((t) => t.email === p.email && t.dia === d), semanaDia.filter((f) => f.email === p.email && diaClave(f.hora) === d));
          return e.faltaSalida || e.faltaEntrada || e.marcas.length || e.revisar;
        });
        if (alerta) b.append(el('i', 'celda-punto'));
        b.addEventListener('click', () => {
          diaVista = d;
          pintarDia();
        });
        return b;
      }),
    );

    // Una fila por persona: primero las que ficharon ese día, después las demás.
    const delDia = ts.filter((t) => t.dia === diaVista);
    const fsDia = semanaDia.filter((f) => diaClave(f.hora) === diaVista);
    const ficharon = personas.filter((p) => fsDia.some((f) => f.email === p.email));
    const resto = quienesFichan().filter((p) => !ficharon.includes(p));
    const lista = $('[data-dia-lista]');
    lista.replaceChildren(
      ...[...ficharon, ...resto].map((p) => filaDia(p, delDia.filter((t) => t.email === p.email), fsDia.filter((f) => f.email === p.email))),
    );
    if (!lista.children.length) lista.append(el('li', 'p-3 text-sm text-texto-2', 'Todavía no hay nadie en el equipo.'));
  }

  function filaDia(p: Persona, ts: Tramo[], fs: FichadaCompleta[]) {
    const hoy = diaClave(new Date());
    const li = el('li', 'fila-dia');
    li.dataset.email = p.email;
    const cuerpo = el('div', 'flex min-w-0 flex-1 flex-wrap items-center gap-2');
    cuerpo.append(el('span', 'w-32 shrink-0 truncate font-bold text-profundo', p.nombre || p.email.split('@')[0]));
    const validas = fs.filter((f) => !f.anulada);
    const anuladas = fs.length - validas.length;
    const e = estadoDia(p.email, diaVista, ts, fs);
    if (!validas.length) {
      const noTrabaja = p.horario_fijo && !horarios.some((h) => h.email === p.email && h.dia === diaSemana(diaVista));
      cuerpo.append(el('span', 'marca marca-gris', diaVista > hoy ? 'Todavía no llegó el día' : noTrabaja ? 'No trabaja este día' : 'No fichó'));
    } else {
      for (const f of validas) {
        const chip = el('span', `chip-fichada ${f.tipo}`, `${f.tipo === 'entrada' ? 'Entrada' : 'Salida'} ${hora(f.hora)}`);
        if (f.metodo === 'manual') chip.append(el('span', 'chip-extra', 'a mano'));
        if (f.hora_original) chip.append(el('span', 'chip-extra', 'corregida'));
        cuerpo.append(chip);
      }
      if (e.ms) cuerpo.append(el('span', 'text-sm font-semibold tabular-nums text-texto-2', duracion(e.ms)));
      if (e.abierto) cuerpo.append(el('span', 'marca marca-verde', 'Adentro'));
      if (e.faltaSalida) cuerpo.append(el('span', 'marca marca-ambar', 'Falta la salida'));
      if (e.faltaEntrada) cuerpo.append(el('span', 'marca marca-ambar', 'Falta la entrada'));
      for (const m of e.marcas) cuerpo.append(el('span', 'marca marca-ambar', m.texto));
      if (e.revisar) cuerpo.append(el('span', 'marca marca-ambar', 'Para revisar'));
    }
    if (anuladas) cuerpo.append(el('span', 'marca marca-gris', anuladas === 1 ? '1 anulada' : `${anuladas} anuladas`));

    const acciones = el('div', 'flex shrink-0 flex-wrap gap-2');
    if (e.faltaSalida) acciones.append(boton('Agregar la salida', 'boton-principal', () => void abrirDetalle(p.email, diaVista, 'salida')));
    if (validas.length || anuladas) acciones.append(boton('Ver y corregir', 'boton-secundario', () => void abrirDetalle(p.email, diaVista)));
    else if (diaVista <= hoy) acciones.append(boton('Agregar fichada', 'boton-secundario', () => void abrirDetalle(p.email, diaVista, 'entrada')));
    li.append(cuerpo, acciones);
    return li;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-dia-mover]').forEach((b) =>
    b.addEventListener('click', () => {
      diaVista = sumarDias(diaVista, Number(b.dataset.diaMover));
      void cargarDia(false);
    }),
  );
  $('[data-dia-hoy]').addEventListener('click', () => {
    diaVista = diaClave(new Date());
    void cargarDia(false);
  });
  $<HTMLInputElement>('[data-dia-fecha]').addEventListener('change', (e) => {
    const v = (e.target as HTMLInputElement).value;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
    diaVista = v;
    void cargarDia(false);
  });
  $('[data-ir-config]').addEventListener('click', () => irAVista('config'));

  // ---------- Detalle de un día ----------
  const dialogo = $<HTMLDialogElement>('[data-detalle]');
  let detalle: { email: string; dia: string } | null = null;
  $('[data-detalle-cerrar]').addEventListener('click', () => dialogo.close());
  dialogo.addEventListener('click', (e) => e.target === dialogo && dialogo.close());

  const METODO: Record<string, string> = { cara: 'Con la cara', codigo: 'Con el código del celular', manual: 'Cargada a mano' };

  async function abrirDetalle(email: string, dia: string, tipo?: 'entrada' | 'salida') {
    detalle = { email, dia };
    let fs: FichadaCompleta[];
    try {
      fs = await q<FichadaCompleta[]>(
        supabase!.from('fichadas').select(COLUMNAS).eq('email', email).gte('hora', inicioDia(dia)).lt('hora', inicioDia(sumarDias(dia, 1))).order('hora').order('id'),
      );
    } catch {
      return alert('No se pudieron cargar las fichadas. Revisá la conexión.');
    }
    $('[data-detalle-titulo]').textContent = nombreDe(email);
    $('[data-detalle-sub]').textContent = diaLargo(`${dia}T12:00:00-03:00`);
    const lista = $('[data-detalle-lista]');
    lista.replaceChildren(
      ...fs.map((f) => {
        const li = el('li', `flex gap-3 rounded-2xl p-3 ring-1 ring-profundo/10 ${f.anulada ? 'opacity-60' : ''}`);
        const img = el('img', 'foto-fichada');
        img.alt = 'Foto de la fichada';
        const txt = el('div', 'min-w-0 flex-1');
        const titulo = el('p', `font-bold text-profundo tabular-nums ${f.anulada ? 'line-through' : ''}`, `${f.tipo === 'entrada' ? 'Entrada' : 'Salida'} · ${hora(f.hora)}`);
        txt.append(titulo);
        const datos: string[] = [METODO[f.metodo]];
        if (f.similitud != null) datos.push(`parecido ${Math.round(f.similitud * 100)}%`);
        txt.append(el('p', 'text-xs text-texto-2', datos.join(' · ')));
        if (f.revisar) txt.append(el('p', 'mt-1 text-xs font-semibold text-ambar', f.revisada_el ? `${f.revisar} (revisada)` : f.revisar));
        if (f.creada_por) txt.append(el('p', 'text-xs text-texto-2', `La cargó ${f.creada_por}${f.nota ? `: ${f.nota}` : ''}`));
        if (f.hora_original) txt.append(el('p', 'text-xs text-texto-2', `Antes decía ${hora(f.hora_original)}. La corrigió ${f.corregida_por}${f.motivo ? `: ${f.motivo}` : ''}`));
        else if (f.corregida_por) txt.append(el('p', 'text-xs text-texto-2', `La corrigió ${f.corregida_por}${f.motivo ? `: ${f.motivo}` : ''}`));
        if (f.anulada) txt.append(el('p', 'text-xs font-semibold text-peligro', `Anulada por ${f.anulada_por}${f.anulada_motivo ? `: ${f.anulada_motivo}` : ''}`));

        if (!f.anulada) {
          const acciones = el('div', 'mt-2 flex flex-wrap items-center gap-2');
          const corregir = el('form', 'flex items-center gap-1.5');
          const input = el('input', 'campo !w-28 !py-1.5');
          input.type = 'time';
          input.value = hora(f.hora);
          input.setAttribute('aria-label', 'Hora corregida');
          const guardar = el('button', 'boton boton-secundario !py-1.5 !px-3 !text-sm', 'Corregir hora');
          guardar.type = 'submit';
          corregir.append(input, guardar);
          corregir.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!input.value || input.value === hora(f.hora)) return;
            const motivo = prompt('¿Por qué se corrige? (queda registrado)');
            if (motivo === null) return;
            if (!(await accion(supabase!.rpc('corregir_fichada', { p_id: f.id, p_hora: new Date(`${dia}T${input.value}:00-03:00`).toISOString(), p_motivo: motivo })))) return;
            await refrescar();
            abrirDetalle(email, dia);
          });
          const otro = f.tipo === 'entrada' ? 'salida' : 'entrada';
          acciones.append(
            corregir,
            boton(`Es ${otro}`, 'boton-secundario', async () => {
              const motivo = prompt(`¿Cambiar esta ${f.tipo} por ${otro}? Contá por qué (queda registrado):`);
              if (motivo === null) return;
              if (!(await accion(supabase!.rpc('cambiar_tipo', { p_id: f.id, p_motivo: motivo })))) return;
              await refrescar();
              abrirDetalle(email, dia);
            }),
            boton('Anular', 'bg-peligro-suave text-peligro hover:bg-peligro hover:text-white', () => void anular(f, true)),
          );
          if (f.revisar && !f.revisada_el)
            acciones.append(
              boton('Está bien', 'boton-principal', async () => {
                if (!(await accion(supabase!.rpc('marcar_revisada', { p_id: f.id })))) return;
                await refrescar();
                abrirDetalle(email, dia);
              }),
            );
          txt.append(acciones);
        }
        li.append(img, txt);
        void ponerFoto(img, f.id);
        return li;
      }),
    );
    if (!fs.length) lista.replaceChildren(el('li', 'text-sm text-texto-2', 'Sin fichadas este día.'));
    const form = $<HTMLFormElement>('[data-agregar-fichada]');
    if (tipo) (form.elements.namedItem('tipo') as HTMLSelectElement).value = tipo;
    if (!dialogo.open) dialogo.showModal();
    if (tipo) (form.elements.namedItem('hora') as HTMLInputElement).focus();
  }

  async function anular(f: Fichada, reabrir = false) {
    const motivo = prompt(`¿Anular la ${f.tipo} de ${nombreDe(f.email)} de las ${hora(f.hora)}? Contá por qué (queda registrado):`);
    if (motivo === null) return;
    if (!(await accion(supabase!.rpc('anular_fichada', { p_id: f.id, p_motivo: motivo })))) return;
    await refrescar();
    if (reabrir && detalle) abrirDetalle(detalle.email, detalle.dia);
  }

  $<HTMLFormElement>('[data-agregar-fichada]').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!detalle) return;
    const f = e.target as HTMLFormElement;
    const d = new FormData(f);
    const { error } = await supabase!.rpc('fichada_manual', {
      p_email: detalle.email,
      p_tipo: String(d.get('tipo')),
      p_hora: new Date(`${detalle.dia}T${d.get('hora')}:00-03:00`).toISOString(),
      p_nota: String(d.get('nota') ?? ''),
    });
    if (error) return alert(esLimite(error) ? LIMITE_DIA : 'No se pudo agregar. Revisá la conexión.');
    f.reset();
    await refrescar();
    abrirDetalle(detalle.email, detalle.dia);
  });

  // ---------- Configuración ----------
  async function pintarConfig() {
    const db = supabase!;
    const compus = await q<Compu[]>(db.from('dispositivos').select('id,nombre,activo,creado_por,creado_el,ultimo_uso').order('creado_el'));

    // Si falta lo básico, arriba se avisa
    $('[data-arranque]').hidden = compus.some((c) => c.activo) && conCara.size > 0;

    // Compus
    const fmt = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' });
    $('[data-compus]').replaceChildren(
      ...(compus.length
        ? compus.map((c) => {
            const li = el('li', `flex flex-wrap items-center gap-3 rounded-2xl bg-crema px-4 py-3 ${c.activo ? '' : 'opacity-60'}`);
            const txt = el('div', 'min-w-0 flex-1');
            txt.append(
              el('p', 'font-semibold text-profundo', c.nombre),
              el('p', 'text-xs text-texto-2', `${c.activo ? 'Activa' : 'Desactivada'} · último uso: ${c.ultimo_uso ? fmt.format(new Date(c.ultimo_uso)) : 'nunca'} · la activó ${c.creado_por}`),
            );
            li.append(
              txt,
              boton(c.activo ? 'Desactivar' : 'Reactivar', c.activo ? 'bg-peligro-suave text-peligro hover:bg-peligro hover:text-white' : 'boton-secundario', async () => {
                if (c.activo && !confirm(`¿Desactivar "${c.nombre}"? Deja de fichar al instante.`)) return;
                if (await accion(db.from('dispositivos').update({ activo: !c.activo }).eq('id', c.id))) void pintarConfig();
              }),
            );
            return li;
          })
        : [el('li', 'text-sm text-texto-2', 'Todavía no hay ningún aparato activado.')]),
    );

    // Ajustes
    const f = $<HTMLFormElement>('[data-ajustes]');
    const exigencia = f.elements.namedItem('similitud_min') as HTMLSelectElement;
    exigencia.value = [...exigencia.options].reduce((m, o) => (Math.abs(Number(o.value) - ajustes.similitud_min) < Math.abs(Number(m) - ajustes.similitud_min) ? o.value : m), '0.5');
    (f.elements.namedItem('tolerancia_min') as HTMLInputElement).value = String(ajustes.tolerancia_min);
    (f.elements.namedItem('parpadeo') as HTMLInputElement).checked = ajustes.parpadeo;
  }

  $<HTMLFormElement>('[data-ajustes]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(e.target as HTMLFormElement);
    const nuevos = { similitud_min: Number(d.get('similitud_min')), parpadeo: d.get('parpadeo') === 'on', tolerancia_min: Math.max(0, Math.min(60, Number(d.get('tolerancia_min')) || 0)) };
    const { error } = await supabase!.from('ajustes_fichador').update(nuevos).eq('id', 1);
    if (error) return alert('No se pudieron guardar los ajustes.');
    ajustes = { ...ajustes, ...nuevos };
    pintarPlanilla();
    pintarDia();
    alert('Ajustes guardados.');
  });

  // ---------- Cómo funciona: abierto hasta que la admin lo cierra ----------
  const como = $<HTMLDetailsElement>('[data-como]');
  const CLAVE_COMO = 'lola-fichaje-como:v1';
  if (localStorage.getItem(CLAVE_COMO) === 'cerrado') como.open = false;
  como.addEventListener('toggle', () => localStorage.setItem(CLAVE_COMO, como.open ? 'abierto' : 'cerrado'));

  // ---------- Arranque ----------
  async function refrescar() {
    try {
      await cargarTodo();
    } catch {
      alert('No se pudieron cargar los datos. Revisá la conexión.');
    }
  }
  $('[data-recargar]').addEventListener('click', () => void refrescar());

  sesionLista.then(async (acceso) => {
    if (!acceso || acceso.rol !== 'admin' || !supabase) {
      $('[data-cargando]').classList.add('hidden');
      $('[data-sin-permiso]').classList.remove('hidden');
      return;
    }
    await refrescar();
    $('[data-cargando]').classList.add('hidden');
    $('[data-panel]').classList.remove('hidden');
    // Desde un pendiente de Inicio: #dia/AAAA-MM-DD/mail abre ese día con la persona marcada.
    const [dia, email] = parametrosVista();
    if (location.hash.startsWith('#dia/') && /^\d{4}-\d{2}-\d{2}$/.test(dia ?? '')) void irADia(dia, email);
    setInterval(() => {
      if (document.visibilityState !== 'visible' || dialogo.open) return;
      void pintarHoy();
      if (diaVista === diaClave(new Date())) void cargarDia();
    }, 60000);
  });
</script>
