---
// Página para direcciones que no existen. GitHub Pages la muestra sola (404.html) para cualquier ruta
// desconocida dentro de /lola-equipo. No pide login: solo lleva de vuelta al inicio.
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-lola-circulo.png';
---

<Manual title="Página no encontrada" publica>
  <main id="contenido" class="fondo-hojas flex min-h-svh items-center justify-center px-5 py-10">
    <div class="w-full max-w-[420px] rounded-[32px] bg-white p-7 text-center shadow-[0_30px_80px_-40px_rgb(33_76_59/0.55)] ring-1 ring-profundo/8">
      <Image src={logo} alt="Logo de Lola" width={112} height={112} class="mx-auto size-24 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.15)]" loading="eager" />
      <p class="mt-5 text-sm font-semibold text-marca-texto">La Almacén de Lola</p>
      <h1 class="titulo-degrade mt-1 text-3xl font-bold tracking-tight">No encontramos esta página</h1>
      <p class="mt-3 text-texto-2">Puede que el enlace esté mal escrito o que la página ya no exista. Desde el inicio llegás a toda la guía.</p>
      <a href={url('/')} class="boton boton-principal mt-6 w-full">
        <Icon name="house" class="size-5" /> Volver al inicio
      </a>
    </div>
  </main>
</Manual>
