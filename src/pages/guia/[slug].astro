---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import Manual from '../../layouts/Manual.astro';
import Icon from '../../components/Icon.astro';
import Tabla from '../../components/Tabla.astro';
import { getGuia, urlCategoria, type Categoria } from '../../data/guia';
import { getModulos, urlModulo } from '../../data/modulos';

export async function getStaticPaths() {
  const lista = await getGuia();
  return lista.map((categoria, i) => ({
    params: { slug: categoria.id },
    props: { categoria, anterior: lista[i - 1], siguiente: lista[i + 1] },
  }));
}

interface Props {
  categoria: Categoria;
  anterior?: Categoria;
  siguiente?: Categoria;
}

const { categoria, anterior, siguiente } = Astro.props;
const { Content, headings } = await render(categoria);
const d = categoria.data;
const productos = headings.filter((h) => h.depth === 3);
const modulo = d.modulo ? (await getModulos()).find((m) => m.data.numero === d.modulo) : undefined;
---

<Manual title={d.titulo}>
  <main id="contenido" class="px-5 pt-6 pb-24 lg:px-8 lg:pt-10">
    <article class="mx-auto max-w-[760px]">
      <a href={url('/')} class="no-print inline-flex items-center gap-2 text-sm font-semibold text-marca hover:underline">
        <Icon name="arrow-left" class="size-4" /> Todas las góndolas
      </a>

      <header class="mt-5 flex items-start gap-4">
        <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
          <Icon name={d.icono} class="size-8" />
        </span>
        <div>
          <h1 class="titulo-degrade text-4xl font-bold tracking-tight sm:text-5xl">{d.titulo}</h1>
          <p class="mt-2 text-lg text-texto-2">{d.bajada}</p>
        </div>
      </header>

      <section class="mt-6 rounded-3xl bg-menta-suave p-5 sm:p-6" aria-label="Lo que tenés que saber">
        <p class="text-sm font-bold tracking-wide text-profundo uppercase">Lo que tenés que saber</p>
        <ul class="mt-3 flex flex-col gap-3">
          {
            d.claves.map((c) => (
              <li class="flex gap-3 text-base leading-relaxed sm:text-[1.0625rem]">
                <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-marca" />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <a
        href={url(`/estudiar?gondola=${categoria.id}`)}
        class="no-print mt-4 flex items-center gap-3 rounded-2xl bg-profundo px-4 py-3 text-white hover:bg-profundo-2"
      >
        <Icon name="cards" class="size-6 text-menta" />
        <span class="flex-1">
          <span class="block font-semibold">Estudiar esta góndola</span>
          <span class="block text-sm text-white/75">Tarjetas para repasar cada producto</span>
        </span>
        <Icon name="arrow-right" class="size-5" />
      </a>

      {
        productos.length > 3 && (
          <nav class="no-print mt-6" aria-label="Productos de esta góndola">
            <p class="text-sm font-semibold text-texto-2">Ir a:</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              {productos.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="inline-block rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-profundo ring-1 ring-profundo/10 hover:bg-menta-suave">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="prosa guia mt-8" data-gondola-id={categoria.id}>
        <Content components={{ table: Tabla }} />
      </div>

      {
        modulo && (
          <a href={urlModulo(modulo)} class="no-print mt-10 flex items-center gap-4 rounded-3xl bg-white p-5 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="book-open-text" class="size-7 shrink-0 text-marca" />
            <span>
              <span class="block text-sm text-texto-2">¿Querés saber más?</span>
              <span class="block font-semibold text-profundo">Manual completo · {modulo.data.titulo}</span>
            </span>
            <Icon name="arrow-right" class="ml-auto size-5 text-marca" />
          </a>
        )
      }

      <nav class="no-print mt-8 grid gap-3 sm:grid-cols-2" aria-label="Otras góndolas">
        {
          anterior ? (
            <a href={urlCategoria(anterior)} class="rounded-2xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
              <span class="flex items-center gap-1 text-sm font-semibold text-marca">
                <Icon name="arrow-left" class="size-4" /> Anterior
              </span>
              <span class="mt-1 block font-semibold text-profundo">{anterior.data.titulo}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          siguiente && (
            <a href={urlCategoria(siguiente)} class="rounded-2xl bg-profundo p-4 text-right text-white hover:bg-profundo-2">
              <span class="flex items-center justify-end gap-1 text-sm font-semibold text-menta">
                Siguiente <Icon name="arrow-right" class="size-4" />
              </span>
              <span class="mt-1 block font-semibold">{siguiente.data.titulo}</span>
            </a>
          )
        }
      </nav>
    </article>
  </main>
</Manual>

<style>
  :global(.prosa.guia h3) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  :global(.boton-guardar) {
    margin-left: auto;
    display: inline-flex;
    width: 36px;
    height: 36px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-marca);
    transition: transform 300ms var(--ease-fluid), background-color 300ms;
  }
  :global(.boton-guardar:active) {
    transform: scale(0.85);
  }
  :global(.boton-guardar svg) {
    width: 22px;
    height: 22px;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 14;
    stroke-linejoin: round;
  }
  :global(.boton-guardar[aria-pressed='true']) {
    color: #c9922e;
  }
  :global(.boton-guardar[aria-pressed='true'] svg) {
    fill: currentColor;
  }
  @media print {
    :global(.boton-guardar) {
      display: none;
    }
  }
</style>

<script>
  import { app } from '../../scripts/app';

  const ESTRELLA =
    '<svg viewBox="0 0 256 256" aria-hidden="true"><path d="M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z"/></svg>';

  const contenedor = document.querySelector<HTMLElement>('[data-gondola-id]');
  const gondolaId = contenedor?.dataset.gondolaId;
  if (contenedor && gondolaId) {
    app.marcarVista(gondolaId);
    contenedor.querySelectorAll<HTMLHeadingElement>('h3[id]').forEach((h3) => {
      // Solo las fichas de producto (las que tienen viñetas abajo).
      if (h3.nextElementSibling?.tagName !== 'UL') return;
      const id = `${gondolaId}#${h3.id}`;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'boton-guardar';
      b.innerHTML = ESTRELLA;
      const pintar = () => {
        const on = app.estaGuardada(id);
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', on ? `Quitar ${h3.textContent} de guardados` : `Guardar ${h3.textContent}`);
      };
      b.addEventListener('click', () => {
        app.guardarFicha(id, !app.estaGuardada(id));
        pintar();
      });
      pintar();
      h3.append(b);
    });
  }
</script>
