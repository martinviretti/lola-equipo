---
// Página de una góndola, pensada para el celular: pestañas Productos / Lo básico / Preguntas /
// Repaso. Cada producto es una tarjeta que se abre con un toque (ver ContenidoGuia modo "app").
import { url } from '../../lib/url';
import { render } from 'astro:content';
import Manual from '../../layouts/Manual.astro';
import Icon from '../../components/Icon.astro';
import Tabla from '../../components/Tabla.astro';
import ContenidoGuia from '../../components/ContenidoGuia.astro';
import QuizGondola from '../../components/QuizGondola.astro';
import { getGuia, urlCategoria, type Categoria } from '../../data/guia';

export async function getStaticPaths() {
  const lista = await getGuia();
  return lista.map((categoria, i) => ({
    params: { slug: categoria.id },
    props: { categoria, anterior: lista[i - 1], siguiente: lista[i + 1] },
  }));
}

interface Props {
  categoria: Categoria;
  anterior?: Categoria;
  siguiente?: Categoria;
}

const { categoria, anterior, siguiente } = Astro.props;
const { Content, headings } = await render(categoria);
const d = categoria.data;
const productos = headings.filter((h) => h.depth === 3);
const cantidadPreguntas = ((categoria.body ?? '').split(/^## Lo que más te van a preguntar/m)[1] ?? '').match(/^\*\*/gm)?.length ?? 0;
const quizzes = import.meta.glob('../../data/quiz/*.json');
const hayRepaso = `../../data/quiz/${categoria.id}.json` in quizzes;

const pestanas = [
  { id: 'productos', label: 'Productos', cuenta: productos.length },
  { id: 'basico', label: 'Lo básico' },
  { id: 'preguntas', label: 'Preguntas', cuenta: cantidadPreguntas },
  ...(hayRepaso ? [{ id: 'repaso', label: 'Repaso' }] : []),
];
---

<Manual title={d.titulo}>
  <main id="contenido" class="px-4 pt-4 pb-24 sm:px-5 lg:px-8 lg:pt-8">
    <article class="mx-auto max-w-[760px]">
      <a href={url('/#gondolas')} class="no-print inline-flex items-center gap-1.5 text-sm font-semibold text-marca hover:underline">
        <Icon name="arrow-left" class="size-4" /> Góndolas
      </a>

      <header class="mt-3 flex items-center gap-3.5">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo sm:size-14">
          <Icon name={d.icono} class="size-7 sm:size-8" />
        </span>
        <div class="min-w-0">
          <h1 class="titulo-degrade text-3xl leading-tight font-bold tracking-tight sm:text-5xl">{d.titulo}</h1>
        </div>
      </header>
      <p class="mt-2 text-[0.975rem] text-texto-2 sm:text-lg">{d.bajada}</p>

      <!-- Pestañas -->
      <div class="pestanas no-print" role="tablist" aria-label={`Secciones de ${d.titulo}`} style={`--cantidad:${pestanas.length}`}>
        {
          pestanas.map((p) => (
            <button type="button" role="tab" class="pestana" data-tab={p.id} aria-selected={p.id === 'productos' ? 'true' : 'false'}>
              {p.label}
              {p.cuenta ? <span class="pestana-cuenta">{p.cuenta}</span> : null}
            </button>
          ))
        }
      </div>

      <!-- Productos: buscador y ayuda -->
      <div data-panel="productos" class="no-print mt-4">
        <div class="relative">
          <label for="filtro-gondola" class="sr-only">Buscar en {d.titulo}</label>
          <span class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-texto-2">
            <Icon name="magnifying-glass" class="size-5" />
          </span>
          <input
            id="filtro-gondola"
            type="search"
            autocomplete="off"
            placeholder={`Buscar en ${d.titulo.toLowerCase()}…`}
            class="w-full rounded-2xl bg-white py-3 pr-4 pl-11 text-base ring-1 ring-profundo/15 outline-none placeholder:text-texto-2/70 focus:ring-2 focus:ring-marca"
            data-filtro
          />
        </div>
        <p class="mt-3 flex items-center gap-2 text-sm text-texto-2" data-filtro-estado>
          <Icon name="info" class="size-4 shrink-0 text-marca" /> Tocá un producto para ver su ficha completa.
        </p>
      </div>

      <!-- Lo básico: lo que tenés que saber -->
      <section data-panel="basico" class="mt-4 rounded-3xl bg-menta-suave p-5 sm:p-6" aria-label="Lo que tenés que saber" hidden>
        <p class="text-sm font-bold tracking-wide text-profundo uppercase">Lo que tenés que saber</p>
        <ul class="mt-3 flex flex-col gap-3">
          {
            d.claves.map((c) => (
              <li class="flex gap-3 text-base leading-relaxed">
                <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-marca" />
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <div data-panel="preguntas" class="no-print mt-4" hidden>
        <p class="flex items-center gap-2 text-sm text-texto-2">
          <Icon name="info" class="size-4 shrink-0 text-marca" /> Pensá qué le dirías al cliente y tocá para ver la respuesta.
        </p>
      </div>

      <div class="prosa guia mt-4" data-gondola-id={categoria.id}>
        <ContenidoGuia modo="app"><Content components={{ table: Tabla }} /></ContenidoGuia>
      </div>

      <p class="mt-4 hidden rounded-2xl bg-white p-4 text-center text-sm text-texto-2 ring-1 ring-profundo/10" data-filtro-vacio>
        No hay productos con esa palabra en esta góndola. Probá con el <a href={url('/buscar')} class="font-semibold text-profundo underline">buscador general</a>.
      </p>

      <!-- Repaso: siempre en el HTML (su script lo busca al cargar) -->
      {
        hayRepaso && (
          <div data-panel="repaso" hidden>
            <QuizGondola
              gondolaId={categoria.id}
              titulo={d.titulo}
              siguiente={siguiente ? { url: urlCategoria(siguiente), titulo: siguiente.data.titulo } : undefined}
            />
          </div>
        )
      }

      <nav class="no-print mt-10 grid grid-cols-2 gap-3" aria-label="Otras góndolas">
        {
          anterior ? (
            <a href={urlCategoria(anterior)} class="rounded-2xl bg-white p-3.5 ring-1 ring-profundo/10 hover:bg-menta-suave">
              <span class="flex items-center gap-1 text-xs font-semibold text-marca">
                <Icon name="arrow-left" class="size-4" /> Anterior
              </span>
              <span class="mt-1 block text-[0.95rem] leading-snug font-semibold text-profundo">{anterior.data.titulo}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          siguiente && (
            <a href={urlCategoria(siguiente)} class="rounded-2xl bg-profundo p-3.5 text-right text-white hover:bg-profundo-2">
              <span class="flex items-center justify-end gap-1 text-xs font-semibold text-menta">
                Siguiente <Icon name="arrow-right" class="size-4" />
              </span>
              <span class="mt-1 block text-[0.95rem] leading-snug font-semibold">{siguiente.data.titulo}</span>
            </a>
          )
        }
      </nav>
    </article>
  </main>
</Manual>

<style>
  .pestanas {
    position: sticky;
    top: 64px;
    z-index: 30;
    margin: 16px -16px 0;
    display: grid;
    grid-template-columns: repeat(var(--cantidad), minmax(0, 1fr));
    gap: 6px;
    background: rgb(251 248 242 / 0.94);
    padding: 10px 16px;
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgb(33 76 59 / 0.08);
  }
  @media (min-width: 640px) {
    .pestanas {
      margin: 20px 0 0;
      padding: 8px;
      border-radius: 18px;
      border-bottom: 0;
      box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
      background: rgb(255 255 255 / 0.9);
    }
  }
  .pestana {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 9999px;
    padding: 9px 4px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-texto-2);
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.12);
    white-space: nowrap;
  }
  .pestana[aria-selected='true'] {
    background: var(--color-profundo);
    color: #fff;
    box-shadow: none;
  }
  .pestana-cuenta {
    display: none;
    border-radius: 9999px;
    background: var(--color-menta-suave);
    padding: 1px 7px;
    font-size: 0.75rem;
    color: var(--color-profundo);
  }
  @media (min-width: 640px) {
    .pestana {
      font-size: 0.9375rem;
      padding: 9px 10px;
    }
    .pestana-cuenta {
      display: inline;
    }
  }
  .pestana[aria-selected='true'] .pestana-cuenta {
    background: rgb(255 255 255 / 0.18);
    color: #fff;
  }
  :global(.boton-guardar) {
    display: inline-flex;
    width: 36px;
    height: 36px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: var(--color-marca);
    transition: transform 300ms var(--ease-fluid), background-color 300ms;
  }
  :global(.boton-guardar:active) {
    transform: scale(0.85);
  }
  :global(.boton-guardar svg) {
    width: 22px;
    height: 22px;
    fill: transparent;
    stroke: currentColor;
    stroke-width: 14;
    stroke-linejoin: round;
  }
  :global(.boton-guardar[aria-pressed='true']) {
    color: #c9922e;
  }
  :global(.boton-guardar[aria-pressed='true'] svg) {
    fill: currentColor;
  }
  @media print {
    :global(.boton-guardar) {
      display: none;
    }
  }
</style>

<script>
  import { app } from '../../scripts/app';

  const ESTRELLA =
    '<svg viewBox="0 0 256 256" aria-hidden="true"><path d="M234.29,114.85l-45,38.83L203,211.75a16.4,16.4,0,0,1-24.5,17.82L128,198.49,77.47,229.57A16.4,16.4,0,0,1,53,211.75l13.76-58.07-45-38.83A16.46,16.46,0,0,1,31.08,86l59-4.76,22.76-55.08a16.36,16.36,0,0,1,30.27,0l22.75,55.08,59,4.76a16.46,16.46,0,0,1,9.37,28.86Z"/></svg>';

  const contenedor = document.querySelector<HTMLElement>('[data-gondola-id]');
  const gondolaId = contenedor?.dataset.gondolaId;
  const fichas = [...document.querySelectorAll<HTMLDetailsElement>('details.ficha')];
  const preguntas = [...document.querySelectorAll<HTMLDetailsElement>('details.pregunta')];

  // ---------- Pestañas ----------
  const pestanas = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  function mostrarPestana(id: string) {
    pestanas.forEach((p) => p.setAttribute('aria-selected', String(p.dataset.tab === id)));
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
    if (id !== 'productos') document.querySelector('[data-filtro-vacio]')?.classList.add('hidden');
    else filtrar();
  }
  pestanas.forEach((p) =>
    p.addEventListener('click', () => {
      mostrarPestana(p.dataset.tab!);
      const tabs = document.querySelector<HTMLElement>('.pestanas')!;
      // Si bajaste mucho, volvé al principio de la sección.
      if (tabs.getBoundingClientRect().top <= 70) scrollTo({ top: scrollY + tabs.getBoundingClientRect().top - 64 - 1 });
    }),
  );

  // ---------- Fichas: de a una abierta ----------
  const ALTO_FIJO = 130; // encabezado + pestañas
  function alAbrir(d: HTMLDetailsElement, lista: HTMLDetailsElement[]) {
    lista.forEach((x) => x !== d && (x.open = false));
    requestAnimationFrame(() => {
      const top = d.getBoundingClientRect().top;
      if (top < ALTO_FIJO || top > innerHeight - 120) scrollTo({ top: scrollY + top - ALTO_FIJO, behavior: 'smooth' });
    });
  }
  fichas.forEach((d) => d.addEventListener('toggle', () => d.open && alAbrir(d, fichas)));
  preguntas.forEach((d) => d.addEventListener('toggle', () => d.open && alAbrir(d, preguntas)));

  // ---------- Buscar dentro de la góndola ----------
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const textos = new Map(fichas.map((d) => [d, norm(d.textContent ?? '')]));
  const titulos = new Map(fichas.map((d) => [d, norm(d.querySelector('h3')?.textContent ?? '')]));
  const filtro = document.querySelector<HTMLInputElement>('[data-filtro]');
  function filtrar() {
    const q = norm(filtro?.value.trim() ?? '');
    let visibles = 0;
    fichas.forEach((d) => {
      const ok = !q || titulos.get(d)!.includes(q) || textos.get(d)!.includes(q);
      d.hidden = !ok;
      if (ok) visibles++;
    });
    document.querySelector('[data-filtro-vacio]')?.classList.toggle('hidden', visibles > 0);
  }
  filtro?.addEventListener('input', filtrar);

  // ---------- Llegar a un producto o sección desde un enlace (#id) ----------
  function irAlHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const destino = document.getElementById(id);
    if (!destino) return;
    const panel = destino.closest<HTMLElement>('[data-panel]')?.dataset.panel ?? 'basico';
    if (filtro && filtro.value) {
      filtro.value = '';
      filtrar();
    }
    mostrarPestana(panel);
    const d = destino.closest<HTMLDetailsElement>('details');
    if (d) d.open = true;
    requestAnimationFrame(() => {
      const el = d ?? destino;
      scrollTo({ top: scrollY + el.getBoundingClientRect().top - ALTO_FIJO });
    });
  }
  addEventListener('hashchange', irAlHash);
  irAlHash();

  // ---------- Estrellas de Guardados y góndola vista ----------
  if (contenedor && gondolaId) {
    app.marcarVista(gondolaId);
    contenedor.querySelectorAll<HTMLHeadingElement>('.ficha h3[id]').forEach((h3) => {
      const id = `${gondolaId}#${h3.id}`;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'boton-guardar';
      b.innerHTML = ESTRELLA;
      const pintar = () => {
        const on = app.estaGuardada(id);
        b.setAttribute('aria-pressed', String(on));
        b.setAttribute('aria-label', on ? `Quitar ${h3.textContent} de guardados` : `Guardar ${h3.textContent}`);
      };
      b.addEventListener('click', (e) => {
        // Está dentro del summary: que no abra ni cierre la ficha.
        e.preventDefault();
        e.stopPropagation();
        app.guardarFicha(id, !app.estaGuardada(id));
        pintar();
      });
      pintar();
      h3.closest('summary')?.querySelector('.ficha-abrir')?.before(b);
    });
  }
</script>
