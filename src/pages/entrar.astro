---
// Pantalla de ingreso: login con Google. Solo entran los mails autorizados (tabla "autorizados").
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-lola-circulo.png';
---

<Manual title="Entrar" publica>
  <main id="contenido" class="fondo-hojas flex min-h-svh items-center justify-center px-5 py-10">
    <div class="w-full max-w-[420px] rounded-[32px] bg-white p-7 text-center shadow-[0_30px_80px_-40px_rgb(33_76_59/0.55)] ring-1 ring-profundo/8">
      <Image src={logo} alt="Logo de Lola" width={112} height={112} class="mx-auto size-24 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.15)]" loading="eager" />
      <p class="mt-5 text-sm font-semibold text-marca">El Almacén de Lola</p>
      <h1 class="titulo-degrade mt-1 text-3xl font-bold tracking-tight">Intranet del equipo</h1>

      <!-- Entrar -->
      <div data-estado="entrar">
        <p class="mt-3 text-texto-2">Entrá con tu cuenta de Google para ver la guía, tu avance y los exámenes.</p>
        <button type="button" class="boton mt-6 w-full bg-white text-profundo ring-1 ring-profundo/15 hover:bg-menta-suave" data-google>
          <svg viewBox="0 0 48 48" class="size-5" aria-hidden="true"
            ><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"
            ></path><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"
            ></path><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"
            ></path><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 38.2 44 33 44 24c0-1.3-.1-2.4-.4-3.5z"></path></svg
          >
          Entrar con Google
        </button>
        <p class="mt-4 text-xs text-texto-2">Solo pueden entrar las personas del equipo que la encargada haya agregado.</p>
        <a href={url('/instalar')} class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-marca underline underline-offset-4">
          <Icon name="download-simple" class="size-4" /> Instalá la app en tu celular
        </a>
      </div>

      <!-- Verificando -->
      <div class="hidden" data-estado="verificando">
        <p class="mt-6 flex items-center justify-center gap-2 font-semibold text-profundo">
          <span class="size-4 animate-spin rounded-full border-2 border-marca border-t-transparent"></span> Entrando…
        </p>
      </div>

      <!-- No autorizada -->
      <div class="hidden" data-estado="no-autorizado">
        <div class="mt-6 rounded-2xl bg-ambar-suave p-4 text-left">
          <p class="flex items-center gap-2 font-bold text-profundo"><Icon name="warning-circle" class="size-5 text-ambar" /> Todavía no tenés acceso</p>
          <p class="mt-1 text-sm text-texto">
            <span data-email-no>Este mail</span> no está en la lista del equipo. Pedile a la encargada que te agregue y volvé a entrar.
          </p>
        </div>
        <button type="button" class="boton boton-secundario mt-4 w-full" data-otra-cuenta>Entrar con otra cuenta</button>
      </div>

      <!-- Sin conexión o error -->
      <div class="hidden" data-estado="error">
        <div class="mt-6 rounded-2xl bg-peligro-suave p-4 text-left">
          <p class="font-bold text-profundo">No pudimos conectarnos</p>
          <p class="mt-1 text-sm text-texto" data-error-texto>Revisá que tengas internet y probá de nuevo.</p>
        </div>
        <button type="button" class="boton boton-principal mt-4 w-full" data-reintentar>Probar de nuevo</button>
      </div>

      <!-- Login no activado todavía -->
      <div class="hidden" data-estado="sin-configurar">
        <p class="mt-4 text-texto-2">El ingreso con Google todavía no está activado.</p>
        <a href={import.meta.env.BASE_URL} class="boton boton-principal mt-5 w-full">Ir a la guía</a>
      </div>
    </div>
  </main>
</Manual>

<script>
  import { url } from '../lib/url';
  import { supabase, configurado } from '../lib/supabase';
  import { verificar } from '../scripts/sesion';

  const VOLVER = 'lola-volver';
  const estados = [...document.querySelectorAll<HTMLElement>('[data-estado]')];
  const ver = (e: string) => estados.forEach((x) => x.classList.toggle('hidden', x.dataset.estado !== e));

  const params = new URLSearchParams(location.search);
  // Solo se vuelve a una página de la propia app.
  const volverParam = params.get('volver');
  if (volverParam && volverParam.startsWith(url('/')) && !volverParam.startsWith('//')) sessionStorage.setItem(VOLVER, volverParam);

  async function entrarALaApp() {
    ver('verificando');
    const a = await verificar();
    if (a) {
      const volver = sessionStorage.getItem(VOLVER);
      sessionStorage.removeItem(VOLVER);
      location.replace(volver && !volver.includes('/entrar') ? volver : url('/'));
    } else if (a === null) {
      const { data } = await supabase!.auth.getSession();
      document.querySelector('[data-email-no]')!.textContent = data.session?.user.email ?? 'Este mail';
      ver('no-autorizado');
    } else {
      ver('error');
    }
  }

  async function iniciar() {
    if (!configurado) return ver('sin-configurar');
    if (params.get('error') === 'no-autorizado') ver('no-autorizado');
    if (params.get('error_description')) {
      document.querySelector('[data-error-texto]')!.textContent = params.get('error_description')!;
      return ver('error');
    }
    // Si vuelve de Google, supabase-js canjea el código acá mismo.
    const { data } = await supabase!.auth.getSession();
    if (data.session) return entrarALaApp();
    if (params.get('error') !== 'no-autorizado') ver('entrar');
  }

  document.querySelector('[data-google]')?.addEventListener('click', async () => {
    ver('verificando');
    const { error } = await supabase!.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${location.origin}${url('/entrar')}`, queryParams: { prompt: 'select_account' } },
    });
    if (error) ver('error');
  });
  document.querySelector('[data-otra-cuenta]')?.addEventListener('click', async () => {
    await supabase?.auth.signOut();
    history.replaceState(null, '', url('/entrar'));
    ver('entrar');
  });
  document.querySelector('[data-reintentar]')?.addEventListener('click', () => void iniciar());

  void iniciar();
</script>
