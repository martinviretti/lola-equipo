---
// Examen del equipo en 3 niveles (diseño en DISENO-EXAMEN.md). Las preguntas están escritas a
// mano en src/data/examen/<tema>.json, cada una con su "nivel" (1, 2 o 3); reglas en
// EXAMEN-BANCO.md. Se aprueba solo por porcentaje (APRUEBA).
import { Image } from 'astro:assets';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-lola-circulo.png';
import { NIVELES, APRUEBA, TEMAS } from '../data/niveles';

const archivos = import.meta.glob<{ default: { tema: string }[] }>('../data/examen/*.json', { eager: true });
const banco = Object.values(archivos)
  .flatMap((m) => m.default)
  .sort((a, b) => TEMAS.indexOf(a.tema) - TEMAS.indexOf(b.tema));
---

<Manual title="Examinarme">
  <main id="contenido" class="px-5 pt-6 pb-16 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[680px]">
      <!-- 1. Los tres niveles -->
      <section data-pantalla="inicio">
        <h1 class="titulo-degrade text-4xl font-bold tracking-tight">Examinarme</h1>
        <p class="mt-2 text-lg text-texto-2">
          Tres niveles para comprobar lo que sabés, de lo indispensable a lo más difícil del mostrador. Cada examen recorre las
          {TEMAS.length} áreas del local. Se aprueba con {APRUEBA}%.
        </p>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-menta-suave px-4 py-2 text-sm font-bold text-profundo" data-resumen>
          <Icon name="trophy" class="size-5 text-marca" /> <span>Aprobaste 0 de 3 niveles</span>
        </p>

        <ol class="mt-6 flex flex-col gap-4">
          {
            NIVELES.map((n) => (
              <li class="tarjeta-nivel" data-nivel={n.numero}>
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-xs font-bold tracking-wide text-marca uppercase">Nivel {n.numero}</p>
                    <h2 class="mt-0.5 text-2xl font-bold text-profundo">{n.nombre}</h2>
                  </div>
                  <span class="estado" data-estado>
                    Sin hacer
                  </span>
                </div>
                <p class="mt-2 text-base text-texto">{n.subtitulo}</p>
                <p class="mt-1 text-sm text-texto-2">
                  {n.preguntas} preguntas · {n.minutos} min · aprobás con {APRUEBA}% · {n.cuando}
                </p>
                <p class="mt-4 text-xs font-bold tracking-wide text-profundo uppercase">Qué entra</p>
                <ul class="mt-2 flex flex-col gap-1.5">
                  {n.entra.map((e) => (
                    <li class="flex gap-2 text-[0.95rem]">
                      <Icon name="check-circle" class="mt-0.5 size-5 shrink-0 text-marca" />
                      <span>{e}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-3 hidden text-sm text-texto-2" data-detalle />
                <div class="mt-4 flex flex-wrap gap-2">
                  <button type="button" class="boton boton-principal flex-1" data-empezar={n.numero}>
                    <Icon name="exam" class="size-5" /> <span data-empezar-texto>Empezar</span>
                  </button>
                  <button type="button" class="boton boton-secundario hidden" data-ver-certificado={n.numero}>
                    Certificado
                  </button>
                </div>
              </li>
            ))
          }
        </ol>

      </section>

      <!-- 2. Pregunta -->
      <section class="hidden" data-pantalla="pregunta">
        <div class="flex items-center justify-between gap-3 text-sm">
          <span class="font-semibold text-profundo" data-contador></span>
          <button type="button" class="font-semibold text-texto-2 underline underline-offset-4" data-abandonar>Salir</button>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-menta-suave">
          <div class="h-full w-0 rounded-full bg-marca transition-[width] duration-500 ease-fluid" data-barra></div>
        </div>

        <div class="mt-6 rounded-3xl bg-white p-5 ring-1 ring-profundo/10 sm:p-6">
          <p class="flex flex-wrap items-center gap-2 text-xs font-bold tracking-wide uppercase">
            <span class="rounded-full bg-profundo px-2.5 py-1 text-white" data-formato></span>
            <span class="text-marca" data-tema></span>
          </p>
          <p class="mt-3 text-xl leading-snug font-bold text-profundo" data-enunciado></p>
        </div>

        <div class="mt-4" data-respuestas></div>

        <div class="mt-4 hidden rounded-2xl p-4" data-devolucion aria-live="polite">
          <p class="font-bold" data-devolucion-titulo></p>
          <p class="mt-1 text-[0.95rem] leading-relaxed" data-devolucion-texto></p>
        </div>

        <button type="button" class="boton boton-principal mt-5 hidden w-full" data-siguiente>
          <span data-siguiente-texto>Siguiente</span> <Icon name="arrow-right" class="size-5" />
        </button>
      </section>

      <!-- 3. Resultado -->
      <section class="hidden" data-pantalla="resultado">
        <div class="rounded-3xl p-6 text-center" data-sello>
          <p class="text-sm font-bold tracking-wide uppercase" data-resultado-nivel></p>
          <p class="mt-2 text-6xl font-bold tabular-nums" data-resultado-nota></p>
          <p class="mt-2 inline-block rounded-full px-4 py-1.5 text-sm font-extrabold tracking-wide" data-resultado-sello></p>
          <p class="mt-3 text-base" data-resultado-detalle></p>
        </div>


        <h2 class="mt-7 text-xl font-bold text-profundo">Cómo te fue en cada tema</h2>
        <ul class="mt-3 flex flex-col gap-2" data-por-tema></ul>

        <div class="mt-7 hidden" data-errores-bloque>
          <h2 class="text-xl font-bold text-profundo">Para repasar</h2>
          <ul class="mt-3 flex flex-col gap-3" data-errores></ul>
        </div>

        <p class="mt-6 text-center text-sm font-semibold text-texto-2" data-mejor></p>

        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button type="button" class="boton boton-principal hidden" data-siguiente-nivel>
            Siguiente nivel <Icon name="arrow-right" class="size-5" />
          </button>
          <button type="button" class="boton boton-secundario hidden" data-certificado-resultado>Ver certificado</button>
          <button type="button" class="boton boton-secundario hidden" data-repasar>Repasar mis errores</button>
          <button type="button" class="boton boton-secundario" data-otra>
            <Icon name="arrows-clockwise" class="size-5" /> Otro examen
          </button>
          <button type="button" class="boton boton-secundario" data-volver-niveles>Ver los niveles</button>
        </div>
      </section>

      <!-- 4. Certificado -->
      <section class="hidden" data-pantalla="certificado">
        <div class="hidden rounded-3xl bg-white p-6 ring-1 ring-profundo/10" data-pedir-nombre>
          <label for="nombre" class="block text-lg font-bold text-profundo">¿Cómo te llamás?</label>
          <p class="mt-1 text-sm text-texto-2">Va en tu certificado. Se guarda solo en este celular.</p>
          <input
            id="nombre"
            type="text"
            autocomplete="name"
            maxlength="60"
            class="mt-3 w-full rounded-2xl bg-crema px-4 py-3 text-base ring-1 ring-profundo/15 outline-none focus:ring-2 focus:ring-marca"
          />
          <button type="button" class="boton boton-principal mt-4 w-full" data-guardar-nombre>Guardar</button>
        </div>

        <div class="certificado hidden" data-certificado>
          <Image src={logo} alt="Logo de Lola" width={88} height={88} class="mx-auto size-20 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.15)]" />
          <p class="mt-4 text-sm font-semibold text-marca">La Almacén de Lola · Equipo</p>
          <p class="mt-1 text-xs font-bold tracking-[0.2em] text-texto-2 uppercase">Certificado</p>
          <p class="mt-5 text-3xl font-bold text-profundo" data-cert-nombre></p>
          <p class="mt-2 text-base text-texto">aprobó el examen</p>
          <p class="mt-1 text-2xl font-bold text-marca" data-cert-nivel></p>
          <dl class="mt-6 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-2xl bg-menta-suave p-3">
              <dt class="text-xs text-texto-2">Nota</dt>
              <dd class="text-lg font-bold text-profundo" data-cert-nota></dd>
            </div>
            <div class="rounded-2xl bg-menta-suave p-3">
              <dt class="text-xs text-texto-2">Fecha</dt>
              <dd class="text-lg font-bold text-profundo" data-cert-fecha></dd>
            </div>
            <div class="rounded-2xl bg-menta-suave p-3">
              <dt class="text-xs text-texto-2">Intentos</dt>
              <dd class="text-lg font-bold text-profundo" data-cert-intentos></dd>
            </div>
          </dl>
          <p class="mt-5 text-sm text-texto-2">Hora actual: <strong class="tabular-nums text-profundo" data-cert-hora></strong></p>
          <p class="mt-1 text-xs text-texto-2">Mostráselo a la encargada en tu celular.</p>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2" data-cert-acciones>
          <a class="boton boton-principal" target="_blank" rel="noopener" data-cert-whatsapp>Mandar por WhatsApp</a>
          <button type="button" class="boton boton-secundario" data-cambiar-nombre>Cambiar el nombre</button>
          <button type="button" class="boton boton-secundario sm:col-span-2" data-volver-niveles>Ver los niveles</button>
        </div>
      </section>
    </div>
  </main>
</Manual>

<script type="application/json" id="banco-examen" set:html={JSON.stringify(banco)} />

<style>
  .tarjeta-nivel {
    border-radius: 28px;
    background: #fff;
    padding: 20px;
    box-shadow: 0 0 0 1px rgb(33 76 59 / 0.1), 0 20px 40px -32px rgb(33 76 59 / 0.5);
  }
  .tarjeta-nivel.bloqueado {
    background: var(--color-arena-suave);
  }
  .tarjeta-nivel.bloqueado h2,
  .tarjeta-nivel.bloqueado ul {
    opacity: 0.6;
  }
  .estado {
    flex: none;
    border-radius: 9999px;
    background: var(--color-crema);
    padding: 6px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-texto-2);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.12);
  }
  .estado.aprobado {
    background: var(--color-menta);
    color: var(--color-profundo);
    box-shadow: none;
  }
  .estado.pendiente {
    background: var(--color-ambar-suave);
    color: var(--color-ambar);
    box-shadow: none;
  }
  .certificado {
    border-radius: 28px;
    background: var(--color-crema);
    padding: 28px 22px;
    text-align: center;
    box-shadow:
      inset 0 0 0 2px var(--color-menta),
      inset 0 0 0 8px var(--color-crema),
      inset 0 0 0 9px var(--color-marca);
  }
  [data-empezar]:disabled {
    opacity: 0.55;
  }
  :global(.respuesta) {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 12px;
    border-radius: 18px;
    background: #fff;
    padding: 14px 16px;
    text-align: left;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.14);
    transition:
      background-color 200ms,
      box-shadow 200ms;
  }
  :global(.respuesta:not(:disabled):hover) {
    background: var(--color-menta-suave);
  }
  :global(.respuesta .letra) {
    display: flex;
    width: 28px;
    height: 28px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-menta-suave);
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-profundo);
  }
  :global(.respuesta.vf) {
    justify-content: center;
    padding: 18px;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  :global(.respuesta.correcta) {
    background: var(--color-menta);
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  :global(.respuesta.correcta .letra) {
    background: var(--color-profundo);
    color: #fff;
  }
  :global(.respuesta.incorrecta) {
    background: var(--color-peligro-suave);
    box-shadow: inset 0 0 0 2px var(--color-peligro);
  }
  :global(.respuesta.incorrecta .letra) {
    background: var(--color-peligro);
    color: #fff;
  }
  :global(.respuesta:disabled) {
    cursor: default;
  }
  :global(.respuesta:disabled:not(.correcta):not(.incorrecta)) {
    opacity: 0.55;
  }
  :global(.par) {
    border-radius: 18px;
    background: #fff;
    padding: 12px 14px;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.14);
  }
  :global(.par label) {
    display: block;
    font-weight: 700;
    color: var(--color-profundo);
  }
  :global(.par select) {
    margin-top: 8px;
    width: 100%;
    border-radius: 12px;
    background: var(--color-crema);
    padding: 10px 12px;
    font-size: 0.975rem;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.18);
  }
  :global(.par.correcta) {
    background: var(--color-menta);
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  :global(.par.incorrecta) {
    background: var(--color-peligro-suave);
    box-shadow: inset 0 0 0 2px var(--color-peligro);
  }
  :global(.par .solucion) {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--color-texto);
  }
</style>

<script>
  import { url } from '../lib/url';
  import { app, type Nivel } from '../scripts/app';
  import { NIVELES, APRUEBA, TEMAS } from '../data/niveles';

  type Tipo = 'opcion' | 'situacion' | 'vf' | 'unir';
  interface Pregunta {
    id: string;
    tema: string;
    nivel: Nivel;
    tipo: Tipo;
    pregunta: string;
    opciones?: string[];
    correcta?: number | boolean;
    pares?: { a: string; b: string }[];
    explicacion: string;
    gondola?: string;
  }

  const FORMATOS: Record<Tipo, string> = {
    opcion: 'Opción múltiple',
    situacion: 'En el mostrador',
    vf: 'Verdadero o falso',
    unir: 'Uní cada uno',
  };

  const banco: Pregunta[] = JSON.parse(document.getElementById('banco-examen')!.textContent!);
  const temas = TEMAS.filter((t) => banco.some((p) => p.tema === t));
  const datosNivel = (n: Nivel) => NIVELES.find((x) => x.numero === n)!;

  const $ = <T extends HTMLElement>(s: string, raiz: ParentNode = document) => raiz.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];
  const pantallas = $$<HTMLElement>('[data-pantalla]');
  const mostrar = (nombre: string) => {
    pantallas.forEach((p) => p.classList.toggle('hidden', p.dataset.pantalla !== nombre));
    scrollTo({ top: 0 });
  };
  const mezclar = <T,>(a: T[]) => a.map((v) => [Math.random(), v] as const).sort((x, y) => x[0] - y[0]).map(([, v]) => v);
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto = '') => {
    const e = document.createElement(tag);
    if (clase) e.className = clase;
    if (texto) e.textContent = texto;
    return e;
  };
  const fecha = (iso: string) => new Date(iso).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  const habilitado = (n: Nivel) => n === 1 || !!app.nivel((n - 1) as Nivel).aprobadoEl;

  // ---------- Armado del examen ----------
  /**
   * Sortea el examen de un nivel: al menos una pregunta de cada tema y el resto respetando la
   * mezcla de formatos. Prioriza las que no salieron en el intento anterior.
   */
  function armarExamen(n: Nivel): Pregunta[] {
    const conf = datosNivel(n);
    const anteriores = new Set(app.nivel(n).ultimas);
    const orden = (lista: Pregunta[]) => mezclar(lista).sort((a, b) => Number(anteriores.has(a.id)) - Number(anteriores.has(b.id)));
    let pool = banco.filter((p) => p.nivel === n);
    const cupos: Record<Tipo, number> = { ...conf.mezcla };
    const elegidas: Pregunta[] = [];
    const tomar = (p: Pregunta) => {
      elegidas.push(p);
      cupos[p.tipo]--;
      pool = pool.filter((x) => x.id !== p.id);
    };
    // Dos preguntas casi iguales (de temas distintos) no van en el mismo examen.
    const palabras = (p: Pregunta) => new Set(p.pregunta.toLowerCase().normalize('NFD').replace(/[^a-z ]/g, '').split(' ').filter((w) => w.length > 3));
    const parecida = (p: Pregunta) => {
      const a = palabras(p);
      return elegidas.some((x) => {
        const b = palabras(x);
        const comunes = [...a].filter((w) => b.has(w)).length;
        return comunes / (a.size + b.size - comunes || 1) > 0.55;
      });
    };
    const conCupo = (lista: Pregunta[]) => {
      const distintas = lista.filter((p) => !parecida(p));
      const base = distintas.length ? distintas : lista;
      return base.find((p) => cupos[p.tipo] > 0) ?? base[0];
    };

    // 1. Al menos una de cada tema.
    for (const t of mezclar(temas)) {
      if (elegidas.length >= conf.preguntas) break;
      if (elegidas.some((p) => p.tema === t)) continue;
      const cand = orden(pool.filter((p) => p.tema === t));
      if (cand.length) tomar(conCupo(cand));
    }
    // 2. El resto, respetando la mezcla de formatos mientras se pueda.
    while (elegidas.length < conf.preguntas && pool.length) tomar(conCupo(orden(pool)));
    return mezclar(elegidas);
  }

  // ---------- Pantalla de niveles ----------
  function pintarNiveles() {
    let aprobados = 0;
    for (const conf of NIVELES) {
      const n = conf.numero as Nivel;
      const v = app.nivel(n);
      const tarjeta = $<HTMLElement>(`[data-nivel="${n}"]`);
      const estado = $('[data-estado]', tarjeta);
      const detalle = $('[data-detalle]', tarjeta);
      const boton = $<HTMLButtonElement>(`[data-empezar="${n}"]`);
      const texto = $('[data-empezar-texto]', boton);
      const abierto = habilitado(n);
      tarjeta.classList.toggle('bloqueado', !abierto);
      boton.disabled = !abierto;
      estado.className = 'estado';
      detalle.classList.add('hidden');
      if (v.aprobadoEl) {
        aprobados++;
        estado.classList.add('aprobado');
        estado.textContent = `Aprobado · ${v.notaAprobado}%`;
        detalle.textContent = `Aprobado el ${fecha(v.aprobadoEl)}. Tu mejor nota: ${v.mejor}%. Podés volver a hacerlo cuando quieras para repasar.`;
        detalle.classList.remove('hidden');
        texto.textContent = 'Hacerlo de nuevo';
      } else if (!abierto) {
        estado.textContent = 'Bloqueado';
        detalle.textContent = `Se habilita cuando aprobás el nivel ${datosNivel((n - 1) as Nivel).nombre}.`;
        detalle.classList.remove('hidden');
        texto.textContent = 'Bloqueado';
      } else if (v.intentos) {
        estado.classList.add('pendiente');
        estado.textContent = 'No aprobado todavía';
        detalle.textContent = `Tu mejor nota: ${v.mejor}%. Necesitás ${APRUEBA}% para aprobar.`;
        detalle.classList.remove('hidden');
        texto.textContent = 'Volver a intentar';
      } else {
        estado.textContent = 'Sin hacer';
        texto.textContent = 'Empezar';
      }
      $(`[data-ver-certificado="${n}"]`).classList.toggle('hidden', !v.aprobadoEl);
    }
    $('[data-resumen] span').textContent = `Aprobaste ${aprobados} de 3 niveles`;
  }

  // ---------- Examen ----------
  let nivel: Nivel = 1;
  let practica = false;
  let examen: Pregunta[] = [];
  let i = 0;
  let resultados: boolean[] = [];

  function devolver(acerto: boolean, p: Pregunta, solucion: string) {
    resultados[i] = acerto;
    const dev = $('[data-devolucion]');
    dev.className = `mt-4 rounded-2xl p-4 ${acerto ? 'bg-menta-suave text-profundo' : 'bg-peligro-suave text-texto'}`;
    $('[data-devolucion-titulo]').textContent = acerto ? '¡Bien!' : `No. ${solucion}`;
    $('[data-devolucion-texto]').textContent = p.explicacion;
    const sig = $('[data-siguiente]');
    sig.classList.remove('hidden');
    $('[data-siguiente-texto]').textContent = i + 1 < examen.length ? 'Siguiente' : 'Ver el resultado';
    sig.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function opciones(p: Pregunta, cont: HTMLElement) {
    const lista = el('ol', 'flex flex-col gap-3');
    const botones = p.opciones!.map((op, k) => {
      const b = el('button', 'respuesta');
      b.type = 'button';
      b.append(el('span', 'letra', 'ABCD'[k]), el('span', '', op));
      b.addEventListener('click', () => {
        botones.forEach((x) => (x.disabled = true));
        const c = p.correcta as number;
        botones[c].classList.add('correcta');
        if (k !== c) b.classList.add('incorrecta');
        devolver(k === c, p, `La correcta es la ${'ABCD'[c]}.`);
      });
      const li = el('li');
      li.append(b);
      lista.append(li);
      return b;
    });
    cont.append(lista);
  }

  function verdaderoFalso(p: Pregunta, cont: HTMLElement) {
    const fila = el('div', 'grid grid-cols-2 gap-3');
    const botones = [true, false].map((valor) => {
      const b = el('button', 'respuesta vf', valor ? 'Verdadero' : 'Falso');
      b.type = 'button';
      b.addEventListener('click', () => {
        botones.forEach((x) => (x.disabled = true));
        const bien = valor === p.correcta;
        botones[p.correcta ? 0 : 1].classList.add('correcta');
        if (!bien) b.classList.add('incorrecta');
        devolver(bien, p, `Es ${p.correcta ? 'verdadero' : 'falso'}.`);
      });
      fila.append(b);
      return b;
    });
    cont.append(fila);
  }

  function unir(p: Pregunta, cont: HTMLElement) {
    const pares = mezclar(p.pares!);
    const respuestas = mezclar(p.pares!.map((x) => x.b));
    const lista = el('div', 'flex flex-col gap-3');
    const selects = pares.map((par, k) => {
      const caja = el('div', 'par');
      const id = `unir-${p.id}-${k}`;
      const label = el('label', '', par.a);
      label.htmlFor = id;
      const s = el('select');
      s.id = id;
      s.append(new Option('Elegí…', ''), ...respuestas.map((r) => new Option(r, r)));
      caja.append(label, s);
      lista.append(caja);
      return s;
    });
    const comprobar = el('button', 'boton boton-secundario mt-4 w-full', 'Comprobar');
    comprobar.type = 'button';
    comprobar.disabled = true;
    selects.forEach((s) => s.addEventListener('change', () => (comprobar.disabled = selects.some((x) => !x.value))));
    comprobar.addEventListener('click', () => {
      let todas = true;
      selects.forEach((s, k) => {
        s.disabled = true;
        const ok = s.value === pares[k].b;
        todas &&= ok;
        const caja = s.parentElement!;
        caja.classList.add(ok ? 'correcta' : 'incorrecta');
        if (!ok) caja.append(el('p', 'solucion', `Era: ${pares[k].b}`));
      });
      comprobar.remove();
      devolver(todas, p, 'Para que cuente, tienen que estar bien las cuatro.');
    });
    cont.append(lista, comprobar);
  }

  function pintarPregunta() {
    const p = examen[i];
    $('[data-contador]').textContent = `${practica ? 'Repaso' : `Nivel ${nivel} · ${datosNivel(nivel).nombre}`} · Pregunta ${i + 1} de ${examen.length}`;
    $('[data-barra]').style.width = `${(i / examen.length) * 100}%`;
    $('[data-formato]').textContent = FORMATOS[p.tipo];
    $('[data-tema]').textContent = p.tema;
    $('[data-enunciado]').textContent = p.pregunta;
    $('[data-devolucion]').classList.add('hidden');
    $('[data-siguiente]').classList.add('hidden');
    const cont = $('[data-respuestas]');
    cont.replaceChildren();
    if (p.tipo === 'vf') verdaderoFalso(p, cont);
    else if (p.tipo === 'unir') unir(p, cont);
    else opciones(p, cont);
  }

  function empezar(n: Nivel, soloErrores = false) {
    nivel = n;
    practica = soloErrores;
    if (soloErrores) {
      const ids = new Set(app.nivel(n).errores);
      examen = mezclar(banco.filter((p) => ids.has(p.id)));
    } else {
      examen = armarExamen(n);
    }
    if (!examen.length) return;
    i = 0;
    resultados = [];
    pintarPregunta();
    mostrar('pregunta');
  }

  function terminar() {
    const total = examen.length;
    const bien = resultados.filter(Boolean).length;
    const nota = Math.round((bien / total) * 100);
    const aprobado = !practica && nota >= APRUEBA;
    const conf = datosNivel(nivel);
    const v = practica
      ? app.nivel(nivel)
      : app.registrarIntento(nivel, {
          nota,
          aprobado,
          ids: examen.map((p) => p.id),
          errores: examen.filter((_, k) => !resultados[k]).map((p) => p.id),
        });

    $('[data-resultado-nivel]').textContent = practica ? `Repaso de errores · ${conf.nombre}` : `Nivel ${nivel} · ${conf.nombre}`;
    $('[data-resultado-nota]').textContent = `${nota}%`;
    const sello = $('[data-resultado-sello]');
    const caja = $('[data-sello]');
    if (practica) {
      caja.className = 'rounded-3xl bg-white p-6 text-center text-profundo ring-1 ring-profundo/10';
      sello.className = 'mt-2 inline-block rounded-full bg-menta-suave px-4 py-1.5 text-sm font-extrabold tracking-wide text-profundo';
      sello.textContent = 'PRÁCTICA, NO CUENTA PARA LA NOTA';
    } else if (aprobado) {
      caja.className = 'rounded-3xl bg-profundo p-6 text-center text-white';
      sello.className = 'mt-2 inline-block rounded-full bg-menta px-4 py-1.5 text-sm font-extrabold tracking-wide text-profundo';
      sello.textContent = 'APROBADO';
    } else {
      caja.className = 'rounded-3xl bg-white p-6 text-center text-profundo ring-1 ring-profundo/10';
      sello.className = 'mt-2 inline-block rounded-full bg-peligro-suave px-4 py-1.5 text-sm font-extrabold tracking-wide text-peligro';
      sello.textContent = 'NO APROBADO';
    }
    $('[data-resultado-detalle]').textContent = `${bien} de ${total} bien.${practica ? '' : ` Se aprueba con ${APRUEBA}%.`}`;


    // Por tema
    $('[data-por-tema]').replaceChildren(
      ...temas
        .map((t) => {
          const idx = examen.map((p, k) => (p.tema === t ? k : -1)).filter((k) => k >= 0);
          return { t, n: idx.length, b: idx.filter((k) => resultados[k]).length };
        })
        .filter((x) => x.n)
        .map(({ t, n, b }) => {
          const pct = Math.round((b / n) * 100);
          const li = el('li', 'rounded-2xl bg-white p-3 ring-1 ring-profundo/10');
          const fila = el('div', 'flex items-center justify-between gap-3 text-sm');
          fila.append(el('span', 'font-semibold text-profundo', t), el('span', `font-bold tabular-nums ${pct === 100 ? 'text-marca' : 'text-texto-2'}`, `${pct}%`));
          const barra = el('div', 'mt-2 h-1.5 overflow-hidden rounded-full bg-menta-suave');
          const relleno = el('div', `h-full rounded-full ${pct >= APRUEBA ? 'bg-marca' : 'bg-ambar'}`);
          relleno.style.width = `${pct}%`;
          barra.append(relleno);
          li.append(fila, barra);
          return li;
        }),
    );

    // Errores con enlace a la guía
    const errores = examen.filter((_, k) => !resultados[k]);
    $('[data-errores-bloque]').classList.toggle('hidden', !errores.length);
    $('[data-errores]').replaceChildren(
      ...errores.map((p) => {
        const li = el('li', 'rounded-2xl bg-white p-4 ring-1 ring-profundo/10');
        li.append(el('span', 'block text-xs font-bold tracking-wide text-marca uppercase', p.tema), el('span', 'mt-1 block font-semibold text-profundo', p.pregunta));
        let respuesta = '';
        if (p.tipo === 'vf') respuesta = p.correcta ? 'Verdadero.' : 'Falso.';
        else if (p.tipo === 'unir') respuesta = p.pares!.map((x) => `${x.a}: ${x.b}`).join(' · ');
        else respuesta = p.opciones![p.correcta as number];
        li.append(el('span', 'mt-2 block text-sm text-texto', `Respuesta: ${respuesta}`), el('span', 'mt-1 block text-sm text-texto-2', p.explicacion));
        if (p.gondola) {
          const a = el('a', 'mt-2 inline-block text-sm font-semibold text-profundo underline underline-offset-4', 'Repasar en la guía');
          a.href = url(`/guia/${p.gondola}`);
          li.append(a);
        }
        return li;
      }),
    );

    $('[data-mejor]').textContent = practica ? '' : `Tu mejor nota en este nivel: ${v.mejor}% · Intentos: ${v.intentos}`;
    $('[data-siguiente-nivel]').classList.toggle('hidden', practica || !v.aprobadoEl || nivel === 3);
    $('[data-certificado-resultado]').classList.toggle('hidden', practica || !v.aprobadoEl);
    $('[data-repasar]').classList.toggle('hidden', practica || !errores.length);
    mostrar('resultado');
  }

  // ---------- Certificado ----------
  let reloj: number | undefined;
  function verCertificado(n: Nivel) {
    nivel = n;
    const { nombre } = app.estado();
    const v = app.nivel(n);
    const pedir = $('[data-pedir-nombre]');
    const cert = $('[data-certificado]');
    const acciones = $('[data-cert-acciones]');
    mostrar('certificado');
    if (!nombre) {
      pedir.classList.remove('hidden');
      cert.classList.add('hidden');
      acciones.classList.add('hidden');
      $<HTMLInputElement>('#nombre').focus();
      return;
    }
    pedir.classList.add('hidden');
    cert.classList.remove('hidden');
    acciones.classList.remove('hidden');
    const conf = datosNivel(n);
    $('[data-cert-nombre]').textContent = nombre;
    $('[data-cert-nivel]').textContent = `Nivel ${n} · ${conf.nombre}`;
    $('[data-cert-nota]').textContent = `${v.notaAprobado}%`;
    $('[data-cert-fecha]').textContent = v.aprobadoEl ? fecha(v.aprobadoEl) : '';
    $('[data-cert-intentos]').textContent = String(v.intentos);
    const texto = `${nombre} aprobó el Nivel ${n} ${conf.nombre} del examen de La Almacén de Lola con ${v.notaAprobado}% el ${v.aprobadoEl ? fecha(v.aprobadoEl) : ''}.`;
    $<HTMLAnchorElement>('[data-cert-whatsapp]').href = `https://wa.me/?text=${encodeURIComponent(texto)}`;
    const hora = () => ($('[data-cert-hora]').textContent = new Date().toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'medium' }));
    clearInterval(reloj);
    hora();
    reloj = window.setInterval(hora, 1000);
  }

  // ---------- Eventos ----------
  $$<HTMLButtonElement>('[data-empezar]').forEach((b) => b.addEventListener('click', () => empezar(Number(b.dataset.empezar) as Nivel)));
  $$<HTMLButtonElement>('[data-ver-certificado]').forEach((b) => b.addEventListener('click', () => verCertificado(Number(b.dataset.verCertificado) as Nivel)));
  $('[data-siguiente]').addEventListener('click', () => {
    i++;
    if (i < examen.length) {
      pintarPregunta();
      scrollTo({ top: 0, behavior: 'smooth' });
    } else terminar();
  });
  const volver = () => {
    clearInterval(reloj);
    pintarNiveles();
    mostrar('inicio');
  };
  $('[data-abandonar]').addEventListener('click', volver);
  $$('[data-volver-niveles]').forEach((b) => b.addEventListener('click', volver));
  $('[data-otra]').addEventListener('click', () => empezar(nivel));
  $('[data-repasar]').addEventListener('click', () => empezar(nivel, true));
  $('[data-siguiente-nivel]').addEventListener('click', () => empezar((nivel + 1) as Nivel));
  $('[data-certificado-resultado]').addEventListener('click', () => verCertificado(nivel));
  $('[data-guardar-nombre]').addEventListener('click', () => {
    const valor = $<HTMLInputElement>('#nombre').value.trim();
    if (!valor) return;
    app.guardarNombre(valor);
    verCertificado(nivel);
  });
  $('[data-cambiar-nombre]').addEventListener('click', () => {
    $<HTMLInputElement>('#nombre').value = app.estado().nombre ?? '';
    $('[data-pedir-nombre]').classList.remove('hidden');
    $('[data-certificado]').classList.add('hidden');
    $('[data-cert-acciones]').classList.add('hidden');
  });
  pintarNiveles();
</script>
