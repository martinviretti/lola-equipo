---
// Panel de admin → Inicio: el tablero principal. Lo que hay que mirar hoy (los números del día y quién
// está en el local), los pendientes con un botón que lleva a resolverlos, un vistazo del aprendizaje,
// atajos y, al final, "Descargar todo" (un Excel con toda la información, en hojas).
// Las otras partes del panel: Horarios y fichajes (fichadas.astro), Gestión de equipo (equipo.astro)
// y Aprendizaje (aprendizaje.astro). Solo lo ven las admins; la base lo controla con RLS.
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import PestanasAdmin from '../components/PestanasAdmin.astro';
import DatosGuia from '../components/DatosGuia.astro';
import ErrorCarga from '../components/ErrorCarga.astro';
import { url } from '../lib/url';
---

<Manual title="Panel de admin">
  <main id="contenido" class="px-5 pt-6 pb-24 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[1040px]">
      <PestanasAdmin activa="inicio" />

      <div class="mt-8 hidden rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" data-sin-permiso>
        <Icon name="lock-key" class="mx-auto size-10 text-marca-texto" />
        <p class="mt-3 text-lg font-semibold text-profundo">Esta sección es solo para administradoras</p>
        <a href={import.meta.env.BASE_URL} class="boton boton-principal mt-5">Volver al inicio</a>
      </div>

      <p class="mt-8 flex items-center gap-2 font-semibold text-profundo" data-cargando>
        <span class="size-4 animate-spin rounded-full border-2 border-marca border-t-transparent"></span> Cargando…
      </p>
      <ErrorCarga />

      <div class="hidden" data-panel>
        <p class="mt-6 text-sm font-semibold text-texto-2 first-letter:uppercase" data-hoy-fecha></p>
        <div class="mt-2 grid grid-cols-2 gap-3 lg:grid-cols-4" data-metricas></div>

        <!-- Pendientes -->
        <section class="tarjeta mt-5">
          <h2 class="tarjeta-titulo flex items-center gap-2"><Icon name="list-checks" class="size-6 text-marca-texto" /> Pendientes</h2>
          <p class="tarjeta-sub">Lo que conviene resolver. Cada uno tiene un botón que te lleva directo.</p>
          <ul class="mt-3 flex flex-col" data-pendientes></ul>
        </section>

        <div class="mt-5 grid gap-5 lg:grid-cols-2">
          <!-- Hoy en el local -->
          <section class="tarjeta">
            <h2 class="tarjeta-titulo flex items-center gap-2"><Icon name="storefront" class="size-6 text-marca-texto" /> Hoy en el local</h2>
            <p class="tarjeta-sub">Quién está ahora y quién ya se fue.</p>
            <ul class="mt-3 flex flex-col gap-2" data-hoy></ul>
            <a href={`${url('/fichadas')}#resumen`} class="mt-3 inline-block tap-area text-sm font-semibold text-marca-texto underline underline-offset-4">Ver el día y la semana</a>
          </section>

          <!-- Aprendizaje -->
          <section class="tarjeta">
            <h2 class="tarjeta-titulo flex items-center gap-2"><Icon name="book-open-text" class="size-6 text-marca-texto" /> Aprendizaje</h2>
            <p class="tarjeta-sub">Cómo viene el equipo con la guía.</p>
            <div class="mt-3 grid grid-cols-3 gap-2" data-aprendizaje></div>
            <a href={url('/aprendizaje')} class="mt-3 inline-block tap-area text-sm font-semibold text-marca-texto underline underline-offset-4">Ver el avance de cada una</a>
          </section>
        </div>

        <!-- Atajos -->
        <section class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
          <a href={`${url('/equipo')}#sumar`} class="atajo"><Icon name="plus-square" class="size-6 text-marca-texto" /> Sumar a alguien</a>
          <a href={`${url('/fichadas')}#resumen`} class="atajo"><Icon name="calendar-blank" class="size-6 text-marca-texto" /> Ver la semana</a>
          <a href={`${url('/fichadas')}#dia`} class="atajo"><Icon name="clock" class="size-6 text-marca-texto" /> Corregir un día</a>
          <a href={url('/equipo')} class="atajo"><Icon name="users-three" class="size-6 text-marca-texto" /> Ver el equipo</a>
        </section>

        <!-- Descargar todo (al final: es para trabajar la información aparte) -->
        <section class="mt-10 rounded-3xl bg-crema p-5 ring-1 ring-profundo/10">
          <h2 class="flex items-center gap-2 font-bold text-profundo"><Icon name="download-simple" class="size-5 text-marca-texto" /> Descargar todo en Excel</h2>
          <p class="mt-1 text-sm text-texto-2">
            Un solo archivo con toda la información, en hojas: las horas y cada fichada del mes que elijas, el equipo, y el avance y la actividad en la guía.
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <label class="sr-only" for="mes">Mes</label>
            <input id="mes" type="month" class="campo !w-auto" data-mes />
            <button type="button" class="boton boton-secundario" data-descargar-todo><Icon name="download-simple" class="size-5" /> Descargar todo</button>
            <span class="text-sm font-semibold text-texto-2" data-descargar-estado></span>
          </div>
        </section>

        <button type="button" class="boton boton-secundario mt-6 !text-sm" data-recargar>Actualizar datos</button>
      </div>
    </div>
  </main>
</Manual>

<DatosGuia />

<style>
  :global(.tarjeta) {
    border-radius: 24px;
    background: #fff;
    padding: 20px;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  .tarjeta-titulo {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-profundo);
  }
  .tarjeta-sub {
    margin-top: 2px;
    font-size: 0.875rem;
    color: var(--color-texto-2);
  }
  .campo {
    min-height: 44px;
    border-radius: 14px;
    background: #fff;
    padding: 9px 12px;
    font-size: 1rem;
    color: var(--color-texto);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.18);
    outline: none;
  }
  .atajo {
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 18px;
    background: #fff;
    padding: 14px 16px;
    font-weight: 700;
    color: var(--color-profundo);
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  .atajo:hover {
    background: var(--color-menta-suave);
  }
  :global(.metrica) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: 20px;
    background: #fff;
    padding: 14px 16px;
    text-align: left;
    box-shadow: inset 0 0 0 1px rgb(33 76 59 / 0.1);
  }
  :global(a.metrica:hover) {
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  :global(.metrica.es-aviso) {
    background: var(--color-ambar-suave);
  }
  :global(.metrica-titulo) {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-texto-2);
  }
  :global(.metrica-valor) {
    font-size: 1.75rem;
    line-height: 1.15;
    font-weight: 800;
    color: var(--color-profundo);
    font-variant-numeric: tabular-nums;
  }
  :global(.metrica.es-aviso .metrica-valor) {
    color: var(--color-ambar);
  }
  :global(.metrica-sub) {
    font-size: 0.75rem;
    color: var(--color-texto-2);
  }
  :global(.pendiente) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 10px 0;
  }
  :global(.pendiente + .pendiente) {
    border-top: 1px solid rgb(33 76 59 / 0.08);
  }
  :global(.pendiente-punto) {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 9999px;
    background: var(--color-ambar);
  }
  :global(.pendiente-punto.suave) {
    background: rgb(33 76 59 / 0.25);
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { arrancarPanel } from '../scripts/admin/arranque';
  import { avisar } from '../scripts/aviso';
  import { diaClave, diaLargo, duracion, hora } from '../lib/fichador';
  import { url } from '../lib/url';
  import { cargarAprendizaje, leerInfoGuia, type DatosAprendizaje } from '../scripts/admin/aprendizaje-datos';
  import { descargarTodo } from '../scripts/admin/descargar-todo';
  import { $, el, fichadasEntre, lunesDe, nombreDe, q, quienesFichan, sumarDias, tramosPorPersona, type FichadaCompleta, type Persona } from '../scripts/admin/comun';

  const info = leerInfoGuia();

  interface Datos {
    apr: DatosAprendizaje;
    fichadas: FichadaCompleta[];
    revisar: number;
    aparatos: number;
    horasMax: number;
  }

  async function cargar(): Promise<Datos> {
    const db = supabase!;
    const hoy = diaClave(new Date());
    // Desde el lunes de la semana pasada: alcanza para esta semana y para las salidas olvidadas recientes.
    const desde = sumarDias(lunesDe(hoy), -7);
    const [apr, fichadas, rev, sin, aparatos, aj] = await Promise.all([
      cargarAprendizaje(),
      fichadasEntre(desde, sumarDias(hoy, 1)),
      db.from('fichadas').select('id').not('revisar', 'is', null).is('revisada_el', null).eq('anulada', false).gte('hora', new Date(Date.now() - 30 * 86400000).toISOString()),
      db.from('fichadas_sin_reconocer').select('id').is('resuelta_el', null),
      db.from('dispositivos').select('id').eq('activo', true),
      q<{ horas_max_turno: number }[]>(db.from('ajustes_fichador').select('horas_max_turno')),
    ]);
    return { apr, fichadas, revisar: (rev.data?.length ?? 0) + (sin.data?.length ?? 0), aparatos: aparatos.data?.length ?? 0, horasMax: aj[0]?.horas_max_turno ?? 16 };
  }

  const nombres = (ps: Persona[]) => {
    const n = ps.map((p) => nombreDe(p));
    return n.length <= 3 ? n.join(', ') : `${n.slice(0, 3).join(', ')} y ${n.length - 3} más`;
  };

  function pintar(d: Datos) {
    const hoy = diaClave(new Date());
    const lunes = lunesDe(hoy);
    const personas = d.apr.equipo;
    const fichan = quienesFichan(personas, d.apr.conCara);
    const ts = tramosPorPersona(
      d.fichadas.filter((f) => !f.anulada),
      d.horasMax,
    );
    const hoyTs = ts.filter((t) => t.dia === hoy);
    const semanaMs = ts.filter((t) => t.dia >= lunes).reduce((s, t) => s + t.ms, 0);
    const carga = fichan.reduce((s, p) => s + Number(p.horas_semana ?? 0), 0);
    const adentro = [...new Set(hoyTs.filter((t) => t.entrada && !t.salida).map((t) => t.email))];
    const vinieron = new Set(hoyTs.map((t) => t.email));
    const nombre = (email: string) => {
      const p = personas.find((x) => x.email === email);
      return p ? nombreDe(p) : email.split('@')[0];
    };

    // ---------- Números del día ----------
    $('[data-hoy-fecha]').textContent = `Hoy, ${diaLargo(new Date())}`;
    const metrica = (titulo: string, valor: string, sub: string, href: string, aviso = false) => {
      const a = el('a', `metrica${aviso ? ' es-aviso' : ''}`);
      a.href = href;
      a.append(el('span', 'metrica-titulo', titulo), el('span', 'metrica-valor', valor), el('span', 'metrica-sub', sub));
      return a;
    };
    const fichajes = url('/fichadas');
    $('[data-metricas]').replaceChildren(
      metrica('Ahora en el local', String(adentro.length), adentro.length === 1 ? 'persona adentro' : 'personas adentro', `${fichajes}#resumen`),
      metrica('Hoy ficharon', `${vinieron.size} de ${fichan.length}`, 'del equipo', `${fichajes}#resumen`),
      metrica('Para revisar', String(d.revisar), d.revisar ? 'Tocá para verlas' : 'Todo en orden', `${fichajes}#dia`, d.revisar > 0),
      metrica('Horas de esta semana', `${Math.floor(semanaMs / 3600000)} h`, carga ? `de ${Math.round(carga)} h de carga horaria` : 'entre todas', `${fichajes}#resumen`),
    );

    // ---------- Pendientes ----------
    const pendientes: { texto: string; boton: string; href: string; suave?: boolean }[] = [];
    if (d.revisar) pendientes.push({ texto: `${d.revisar} ${d.revisar === 1 ? 'fichada para revisar' : 'fichadas para revisar'}`, boton: 'Revisar', href: `${fichajes}#dia` });
    const sinSalida = ts.filter((t) => t.entrada && !t.salida && t.dia < hoy).sort((a, b) => b.dia.localeCompare(a.dia));
    for (const t of sinSalida.slice(0, 5))
      pendientes.push({
        texto: `${nombre(t.email)}: falta la salida del ${diaLargo(`${t.dia}T12:00:00-03:00`)}`,
        boton: 'Arreglar',
        href: `${fichajes}#dia/${t.dia}/${encodeURIComponent(t.email)}`,
      });
    if (sinSalida.length > 5) pendientes.push({ texto: `Y ${sinSalida.length - 5} salidas más que faltan`, boton: 'Ver', href: `${fichajes}#dia` });
    if (!d.aparatos) pendientes.push({ texto: 'Todavía no hay ningún aparato que fiche (la compu o el celular del local)', boton: 'Configurar', href: `${fichajes}#config` });
    const equipo = url('/equipo');
    const enlacePersona = (ps: Persona[]) => (ps.length === 1 ? `${equipo}#persona/${encodeURIComponent(ps[0].email)}` : equipo);
    const sinCara = fichan.filter((p) => !d.apr.conCara.has(p.email));
    if (sinCara.length) pendientes.push({ texto: `Sin la cara registrada: ${nombres(sinCara)}`, boton: 'Ver', href: enlacePersona(sinCara) });
    const sinCarga = personas.filter((p) => p.rol === 'empleada' && !p.horas_semana);
    if (sinCarga.length) pendientes.push({ texto: `Sin carga horaria: ${nombres(sinCarga)}`, boton: 'Cargarla', href: enlacePersona(sinCarga) });
    const empleadas = personas.filter((p) => p.rol === 'empleada');
    const nunca = empleadas.filter((p) => !p.ultimo_ingreso);
    if (nunca.length) pendientes.push({ texto: `Todavía no entraron a la app: ${nombres(nunca)}`, boton: 'Ver', href: enlacePersona(nunca), suave: true });
    const quietas = empleadas.filter((p) => p.ultimo_ingreso && Date.now() - new Date(p.ultimo_ingreso).getTime() > 7 * 86400000);
    if (quietas.length) pendientes.push({ texto: `No entran a la app hace más de una semana: ${nombres(quietas)}`, boton: 'Ver', href: url('/aprendizaje'), suave: true });

    const lista = $('[data-pendientes]');
    lista.replaceChildren(
      ...pendientes.map((x) => {
        const li = el('li', 'pendiente');
        const a = el('a', 'boton boton-secundario tap !py-1.5 !px-3 !text-sm', x.boton);
        a.href = x.href;
        li.append(el('span', `pendiente-punto${x.suave ? ' suave' : ''}`), el('span', 'min-w-0 flex-1 text-sm font-semibold text-profundo first-letter:uppercase', x.texto), a);
        return li;
      }),
    );
    if (!pendientes.length) lista.append(el('li', 'py-2 text-sm font-semibold text-marca-texto', 'Todo en orden: no hay nada pendiente.'));

    // ---------- Hoy en el local ----------
    const porPersona = [...vinieron].map((email) => {
      const mios = hoyTs.filter((t) => t.email === email);
      const abierto = mios.find((t) => t.entrada && !t.salida);
      const ultima = [...mios].reverse().find((t) => t.salida)?.salida;
      return { email, abierto, ultima, ms: mios.reduce((s, t) => s + t.ms, 0) };
    });
    porPersona.sort((a, b) => Number(!!b.abierto) - Number(!!a.abierto));
    $('[data-hoy]').replaceChildren(
      ...porPersona.map((x) => {
        const li = el('li', 'flex items-center gap-3 rounded-2xl bg-crema px-3 py-2');
        li.append(
          el('span', `size-2.5 shrink-0 rounded-full ${x.abierto ? 'bg-marca' : 'bg-profundo/25'}`),
          el('span', 'min-w-0 flex-1 truncate font-semibold text-profundo', nombre(x.email)),
          el(
            'span',
            'text-sm tabular-nums text-texto-2',
            x.abierto ? `Adentro desde las ${hora(x.abierto.entrada!.hora)}` : x.ultima ? `Se fue a las ${hora(x.ultima.hora)} · ${duracion(x.ms)}` : '',
          ),
        );
        return li;
      }),
    );
    if (!porPersona.length) $('[data-hoy]').append(el('li', 'text-sm text-texto-2', 'Hoy todavía no fichó nadie.'));

    // ---------- Aprendizaje ----------
    const entraron = empleadas.filter((p) => p.user_id);
    const base = new Set(entraron.map((p) => p.user_id!));
    const total = info.gondolas.length;
    const completas = d.apr.gondolas.filter((x) => base.has(x.user_id) && x.completada_el).length;
    const activas7 = entraron.filter((p) => p.ultimo_ingreso && Date.now() - new Date(p.ultimo_ingreso).getTime() < 7 * 86400000).length;
    const numero = (valor: string, texto: string) => {
      const c = el('div', 'rounded-2xl bg-crema p-3');
      c.append(el('span', 'block text-2xl font-bold text-profundo tabular-nums', valor), el('span', 'block text-xs text-texto-2', texto));
      return c;
    };
    $('[data-aprendizaje]').replaceChildren(
      numero(`${activas7}/${entraron.length}`, 'entraron esta semana'),
      numero(base.size && total ? `${Math.round((completas / (base.size * total)) * 100)}%` : '0%', 'de la guía completada'),
      numero(String(d.apr.intentos.filter((x) => base.has(x.user_id) && x.aprobado).length), 'exámenes aprobados'),
    );
  }


  // ---------- Descargar todo ----------
  const mes = $<HTMLInputElement>('[data-mes]');
  mes.value = diaClave(new Date()).slice(0, 7);
  $('[data-descargar-todo]').addEventListener('click', async () => {
    const estado = $('[data-descargar-estado]');
    if (!/^\d{4}-\d{2}$/.test(mes.value)) {
      estado.textContent = 'Elegí un mes.';
      return;
    }
    estado.textContent = 'Armando el Excel…';
    try {
      const archivo = await descargarTodo(mes.value, info);
      estado.textContent = 'Listo ✓';
      avisar(`Descargado: ${archivo}. Está en la carpeta Descargas.`, { ms: 6000 });
    } catch {
      estado.textContent = 'No se pudo armar. Revisá la conexión y probá de nuevo.';
    }
  });

  arrancarPanel({
    cargar: async () => pintar(await cargar()),
    // Se actualiza sola cada minuto; si justo se cortó internet, no molesta con un aviso (prueba en el siguiente).
    alMostrar: () => setInterval(() => document.visibilityState === 'visible' && cargar().then(pintar).catch(() => {}), 60000),
  });
</script>
