---
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';

const sugerencias = ['chía', 'nuez pecán', 'leche para café', 'sin TACC', 'stevia', 'boldo', 'harina 0000', 'pan integral', 'creatina', 'matcha'];
---

<Manual title="Buscar">
  <main id="contenido" class="px-5 pt-6 pb-16 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[680px]">
      <h1 class="titulo-degrade text-4xl font-bold tracking-tight">Buscar</h1>
      <p class="mt-1 text-base text-texto-2">Un producto, un tipo o una pregunta de un cliente.</p>

      <div class="relative mt-5">
        <label for="buscador" class="sr-only">Buscar en la guía</label>
        <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-texto-2">
          <Icon name="magnifying-glass" class="size-5" />
        </span>
        <input
          id="buscador"
          type="search"
          enterkeyhint="search"
          autocomplete="off"
          autofocus
          placeholder="Buscá un producto…"
          class="campo-busqueda w-full rounded-2xl bg-white py-4 pr-14 pl-12 text-base text-texto ring-1 ring-profundo/15 outline-none placeholder:text-texto-2 focus:ring-2 focus:ring-marca"
        />
        <button type="button" class="borrar-busqueda" aria-label="Borrar lo que escribiste" data-borrar hidden>
          <span><Icon name="x" class="size-4" /></span>
        </button>
      </div>

      <div class="mt-4" data-sugerencias>
        <p class="text-sm text-texto-2">Probá con:</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            sugerencias.map((s) => (
              <button
                type="button"
                data-sugerencia={s}
                class="inline-flex min-h-11 items-center rounded-full bg-white px-4 text-[0.9375rem] font-semibold text-profundo ring-1 ring-profundo/10 hover:bg-menta-suave"
              >
                {s}
              </button>
            ))
          }
        </div>
      </div>

      <p class="mt-4 hidden text-sm text-texto-2" data-buscador-estado aria-live="polite"></p>
      <ol class="mt-3 flex flex-col gap-2" data-resultados></ol>
    </div>
  </main>
</Manual>

<style>
  /* La "x" propia (44 px y con los colores de la app) en lugar de la azul del navegador */
  .campo-busqueda::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }
  .borrar-busqueda {
    position: absolute;
    top: 50%;
    right: 6px;
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border-radius: 9999px;
    color: var(--color-profundo);
  }
  .borrar-busqueda > span {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-menta-suave);
  }
  @media (hover: hover) {
    .borrar-busqueda:hover > span {
      background: var(--color-menta);
    }
  }
</style>

<script>
  import { initBuscador } from '../scripts/buscador';
  initBuscador();
  const input = document.querySelector<HTMLInputElement>('#buscador')!;
  const borrar = document.querySelector<HTMLButtonElement>('[data-borrar]')!;
  const sugerencias = document.querySelector<HTMLElement>('[data-sugerencias]')!;
  // Con algo escrito, las sugerencias se van (dejan lugar a los resultados) y aparece la "x".
  const actualizar = () => {
    const hay = input.value.trim().length > 0;
    borrar.hidden = !input.value;
    sugerencias.hidden = hay;
  };
  input.addEventListener('input', actualizar);
  borrar.addEventListener('click', () => {
    input.value = '';
    input.dispatchEvent(new Event('input'));
    input.focus();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sugerencia]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.sugerencia!;
      input.dispatchEvent(new Event('input'));
      input.focus();
    }),
  );
  actualizar();
</script>
