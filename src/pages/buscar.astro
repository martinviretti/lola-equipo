---
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';

const sugerencias = ['chía', 'nuez pecán', 'leche para café', 'sin TACC', 'stevia', 'boldo', 'harina 0000', 'pan integral', 'creatina', 'matcha'];
---

<Manual title="Buscar">
  <main id="contenido" class="px-5 pt-6 pb-16 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[680px]">
      <h1 class="titulo-degrade text-4xl font-bold tracking-tight">Buscar</h1>
      <p class="mt-1 text-base text-texto-2">Un producto, un tipo o una pregunta de un cliente.</p>

      <div class="relative mt-5">
        <label for="buscador" class="sr-only">Buscar en la guía</label>
        <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-texto-2">
          <Icon name="magnifying-glass" class="size-5" />
        </span>
        <input
          id="buscador"
          type="search"
          enterkeyhint="search"
          autocomplete="off"
          autofocus
          placeholder="¿Qué te preguntaron?"
          class="w-full rounded-2xl bg-white py-4 pr-4 pl-12 text-base text-texto ring-1 ring-profundo/15 outline-none placeholder:text-texto-2/70 focus:ring-2 focus:ring-marca"
        />
      </div>

      <div class="mt-4 flex flex-wrap gap-2" data-sugerencias>
        {
          sugerencias.map((s) => (
            <button type="button" data-sugerencia={s} class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-profundo ring-1 ring-profundo/10 hover:bg-menta-suave">
              {s}
            </button>
          ))
        }
      </div>

      <p class="mt-4 hidden text-sm text-texto-2" data-buscador-estado aria-live="polite"></p>
      <ol class="mt-3 flex flex-col gap-2" data-resultados></ol>
    </div>
  </main>
</Manual>

<script>
  import { initBuscador } from '../scripts/buscador';
  initBuscador();
  const input = document.querySelector<HTMLInputElement>('#buscador')!;
  document.querySelectorAll<HTMLButtonElement>('[data-sugerencia]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.sugerencia!;
      input.dispatchEvent(new Event('input'));
      input.focus();
    }),
  );
</script>
