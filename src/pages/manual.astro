---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-lola-circulo.png';
import { getModulos, PARTES, urlModulo, numeroModulo } from '../data/modulos';

const modulos = await getModulos();
const primero = modulos[0];
const minutosTotales = modulos.reduce((s, m) => s + m.data.minutos, 0);
const lectura = minutosTotales < 90 ? `${minutosTotales} min de lectura` : `Unas ${Math.round(minutosTotales / 60)} horas de lectura`;
const conQuiz = modulos.filter((m) => m.data.quiz.length > 0).length;
---

<Manual title="Manual completo">
  <main id="contenido">
    <section class="fondo-hojas px-5 pt-12 pb-16 lg:px-8 lg:pt-20 lg:pb-24">
      <div class="mx-auto max-w-[1200px]">
        <Image src={logo} alt="Logo de Lola" width={88} height={88} class="size-20 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.12)]" loading="eager" />
        <p class="mt-6 text-sm font-semibold text-marca">Para profundizar</p>
        <h1 class="titulo-degrade mt-2 text-4xl font-bold tracking-tight sm:text-6xl">
          Manual completo
        </h1>
        <p class="mt-4 max-w-[640px] text-lg text-texto-2">
          La versión larga, para cuando quieras saber más: cada producto en detalle, etiquetas, celiaquía,
          alergias, atención y el día a día del local. Para empezar, con la guía de productos alcanza.
        </p>
        <p class="mt-4 flex flex-wrap gap-2 text-sm font-semibold text-profundo">
          <span class="rounded-full bg-white px-3 py-1 ring-1 ring-profundo/10">{modulos.length} {modulos.length === 1 ? "módulo" : "módulos"}</span>
          <span class="rounded-full bg-white px-3 py-1 ring-1 ring-profundo/10">{lectura}</span>
          <span class="rounded-full bg-white px-3 py-1 ring-1 ring-profundo/10">{conQuiz} {conQuiz === 1 ? "autoevaluación" : "autoevaluaciones"}</span>
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          {
            primero && (
              <a href={urlModulo(primero)} class="boton boton-principal" data-continuar>
                <Icon name="book-open-text" class="size-5" />
                <span data-continuar-texto>Empezar por el módulo 1</span>
              </a>
            )
          }
          <a href={url('/imprimir')} class="boton boton-secundario">
            <Icon name="printer" class="size-5" />
            Imprimir o guardar en PDF
          </a>
        </div>

        <div class="mt-10 max-w-[640px] rounded-3xl bg-white p-5 ring-1 ring-profundo/10" data-panel-progreso>
          <div class="flex items-center justify-between gap-4">
            <p class="text-sm font-bold text-profundo">Tu avance</p>
            <p class="text-sm text-texto-2"><span data-leidos class="font-bold text-profundo">0</span> de {modulos.length} leídos</p>
          </div>
          <div class="mt-3 h-2 overflow-hidden rounded-full bg-menta-suave">
            <div class="h-full w-0 rounded-full bg-marca transition-[width] duration-700 ease-fluid" data-barra-avance></div>
          </div>
          <p class="mt-3 text-xs text-texto-2">Se guarda solo en este celular o computadora.</p>
        </div>
      </div>
    </section>

    <section id="buscar-manual" class="px-5 py-12 lg:px-8">
      <div class="mx-auto max-w-[1200px]">
        <label for="buscador" class="text-2xl font-bold tracking-tight text-profundo">¿Qué necesitás saber?</label>
        <p class="mt-1 text-base text-texto-2">Buscá un producto, una palabra o una situación. Por ejemplo: chía, sin TACC, stevia, vencimientos.</p>
        <div class="relative mt-4 max-w-[720px]">
          <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-texto-2">
            <Icon name="magnifying-glass" class="size-5" />
          </span>
          <input
            id="buscador"
            type="search"
            autocomplete="off"
            placeholder="Buscar en el manual"
            class="w-full rounded-2xl bg-white py-4 pr-4 pl-12 text-base text-texto ring-1 ring-profundo/15 outline-none placeholder:text-texto-2/70 focus:ring-2 focus:ring-marca"
          />
        </div>
        <p class="mt-3 hidden text-sm text-texto-2" data-buscador-estado aria-live="polite"></p>
        <ol class="mt-4 flex max-w-[720px] flex-col gap-2" data-resultados></ol>
      </div>
    </section>

    <section class="px-5 pb-24 lg:px-8">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-16">
        {
          PARTES.map((parte) => {
            const lista = modulos.filter((m) => m.data.parte === parte.nombre);
            if (!lista.length) return null;
            return (
              <div>
                <h2 class="text-2xl font-bold tracking-tight text-profundo sm:text-3xl">{parte.nombre}</h2>
                <p class="mt-1 text-base text-texto-2">{parte.bajada}</p>
                <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {lista.map((m) => (
                    <li>
                      <a
                        href={urlModulo(m)}
                        data-tarjeta={m.id}
                        class="group flex h-full flex-col rounded-3xl bg-white p-5 ring-1 ring-profundo/8 transition-transform duration-500 ease-fluid hover:-translate-y-1"
                      >
                        <span class="flex items-center justify-between">
                          <span class="flex size-11 items-center justify-center rounded-2xl bg-menta-suave text-profundo group-hover:bg-menta">
                            <Icon name={m.data.icono} class="size-6" />
                          </span>
                          <span class="text-sm font-bold text-marca tabular-nums">{numeroModulo(m)}</span>
                        </span>
                        <span class="mt-4 text-lg font-semibold text-profundo">{m.data.titulo}</span>
                        <span class="mt-1 flex-1 text-sm text-texto-2">{m.data.resumen}</span>
                        <span class="mt-4 flex flex-wrap items-center gap-2 text-xs font-semibold text-texto-2">
                          <span class="inline-flex items-center gap-1">
                            <Icon name="clock" class="size-4" /> {m.data.minutos} min
                          </span>
                          <span data-chip-leido class="hidden items-center gap-1 rounded-full bg-menta px-2 py-0.5 text-profundo">
                            <Icon name="check" class="size-3" /> Leído
                          </span>
                          <span data-chip-quiz class="hidden rounded-full bg-arena px-2 py-0.5 text-profundo"></span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }

        <div class="rounded-3xl bg-profundo p-6 text-white sm:p-8">
          <h2 class="text-2xl font-bold tracking-tight">El manual en papel</h2>
          <p class="mt-2 max-w-[640px] text-base text-white/80">
            La versión para imprimir trae todo el manual con portada, índice, las autoevaluaciones con sus
            respuestas al final y una planilla de avance para firmar con la encargada.
          </p>
          <a href={url('/imprimir')} class="boton mt-6 bg-white text-profundo hover:bg-menta">
            <Icon name="printer" class="size-5" />
            Abrir versión para imprimir
          </a>
        </div>
      </div>
    </section>
  </main>
</Manual>

<script>
  import { url } from '../lib/url';
  import { leer } from '../scripts/progreso';

  // ---------- Progreso ----------
  const p = leer();
  const tarjetas = [...document.querySelectorAll<HTMLAnchorElement>('[data-tarjeta]')];
  let leidos = 0;
  let siguiente: HTMLAnchorElement | undefined;
  tarjetas.forEach((t) => {
    const slug = t.dataset.tarjeta!;
    const leido = !!p.leidos[slug];
    if (leido) leidos++;
    else siguiente ??= t;
    const chip = t.querySelector<HTMLElement>('[data-chip-leido]')!;
    chip.classList.toggle('hidden', !leido);
    chip.classList.toggle('inline-flex', leido);
    const q = p.quiz[slug];
    const chipQ = t.querySelector<HTMLElement>('[data-chip-quiz]')!;
    if (q) {
      chipQ.textContent = `Quiz ${q.ok}/${q.total}`;
      chipQ.classList.remove('hidden');
    }
  });
  document.querySelector('[data-leidos]')!.textContent = String(leidos);
  const barra = document.querySelector<HTMLElement>('[data-barra-avance]');
  if (barra && tarjetas.length) barra.style.width = `${(leidos / tarjetas.length) * 100}%`;
  if (leidos > 0 && siguiente) {
    const cont = document.querySelector<HTMLAnchorElement>('[data-continuar]');
    if (cont) {
      cont.href = siguiente.href;
      cont.querySelector('[data-continuar-texto]')!.textContent = 'Seguir donde quedé';
    }
  }

  // ---------- Buscador ----------
  interface Entrada {
    modulo: string;
    titulo: string;
    url: string;
    texto: string;
  }
  const input = document.querySelector<HTMLInputElement>('#buscador')!;
  const lista = document.querySelector<HTMLOListElement>('[data-resultados]')!;
  const estado = document.querySelector<HTMLElement>('[data-buscador-estado]')!;
  let indice: (Entrada & { n: string; nt: string })[] | null = null;

  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const escapar = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function cargar() {
    if (indice) return indice;
    const r = await fetch(url('/buscar.json'));
    const datos: Entrada[] = await r.json();
    indice = datos.map((e) => ({ ...e, n: norm(e.texto), nt: norm(e.titulo) }));
    return indice;
  }

  function fragmento(texto: string, termino: string) {
    const i = norm(texto).indexOf(termino);
    if (i < 0) return escapar(texto.slice(0, 140)) + (texto.length > 140 ? '…' : '');
    const desde = Math.max(0, i - 60);
    const hasta = Math.min(texto.length, i + termino.length + 80);
    const antes = escapar(texto.slice(desde, i));
    const match = escapar(texto.slice(i, i + termino.length));
    const despues = escapar(texto.slice(i + termino.length, hasta));
    return `${desde > 0 ? '…' : ''}${antes}<mark class="rounded bg-menta px-0.5 text-profundo">${match}</mark>${despues}${hasta < texto.length ? '…' : ''}`;
  }

  let temporizador: number | undefined;
  async function buscar() {
    const q = norm(input.value.trim());
    if (q.length < 2) {
      lista.innerHTML = '';
      estado.classList.add('hidden');
      return;
    }
    const datos = await cargar();
    const terminos = q.split(/\s+/).filter(Boolean);
    const res = datos
      .map((e) => {
        if (!terminos.every((t) => e.n.includes(t) || e.nt.includes(t))) return null;
        const puntaje = terminos.reduce((s, t) => s + (e.nt.includes(t) ? 10 : 0) + (e.n.split(t).length - 1), 0);
        return { e, puntaje };
      })
      .filter((x): x is { e: (typeof datos)[number]; puntaje: number } => !!x)
      .sort((a, b) => b.puntaje - a.puntaje)
      .slice(0, 8);

    estado.classList.remove('hidden');
    estado.textContent = res.length ? `${res.length} resultado${res.length > 1 ? 's' : ''}` : 'No encontramos nada. Probá con otra palabra o preguntale a la encargada.';
    lista.innerHTML = res
      .map(
        ({ e }) => `<li><a href="${e.url}" class="block rounded-2xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
          <span class="text-xs font-semibold text-marca">${escapar(e.modulo)}</span>
          <span class="mt-1 block font-semibold text-profundo">${escapar(e.titulo)}</span>
          <span class="mt-1 block text-sm text-texto-2">${fragmento(e.texto, terminos[0])}</span>
        </a></li>`,
      )
      .join('');
  }

  input.addEventListener('focus', () => void cargar(), { once: true });
  input.addEventListener('input', () => {
    clearTimeout(temporizador);
    temporizador = window.setTimeout(buscar, 150);
  });
  if (location.hash === '#buscar') input.focus();
</script>
