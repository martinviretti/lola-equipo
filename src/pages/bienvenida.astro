---
// Bienvenida al equipo: el manual de manejo y orientación del local, ordenado por sección.
import { Image } from 'astro:assets';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-lola-circulo.png';
import { reglas } from '../data/guia';
import { atencion, tareasGenerales, roles, cierre, imagen, horarios, celular, musica, cierreManual, secciones } from '../data/bienvenida';

const titulo = (id: string) => secciones.find((s) => s.id === id)!;
---

<Manual title="Bienvenida">
  <main id="contenido">
    <!-- Portada -->
    <section class="fondo-hojas px-5 pt-10 pb-10 lg:px-8 lg:pt-14">
      <div class="mx-auto max-w-[760px]">
        <Image src={logo} alt="Logo de Lola" width={88} height={88} class="size-16 rounded-full shadow-[0_8px_32px_rgb(33_76_59/0.12)] sm:size-20" loading="eager" />
        <p class="mt-5 text-sm font-semibold text-marca">Manual de manejo y orientación</p>
        <h1 class="titulo-degrade mt-1 text-4xl font-bold tracking-tight sm:text-5xl">Bienvenida al equipo</h1>
        <p class="mt-3 max-w-[560px] text-lg text-texto-2">
          Cómo trabajamos en El Almacén de Lola: cómo atender, qué hace cada una, cómo se cierra el local y las reglas de todos los
          días.
        </p>

        <nav class="mt-7" aria-label="Secciones de la bienvenida">
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
            {
              secciones.map((s, k) => (
                <li>
                  <a href={`#${s.id}`} class="flex h-full items-center gap-2.5 rounded-2xl bg-white px-3 py-2.5 text-sm font-semibold text-profundo ring-1 ring-profundo/10 hover:bg-menta-suave">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-menta-suave text-profundo">
                      <Icon name={s.icono} class="size-4.5" />
                    </span>
                    <span class="leading-tight">
                      <span class="block text-[0.7rem] font-bold text-marca tabular-nums">{String(k + 1).padStart(2, '0')}</span>
                      {s.titulo}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </section>

    <div class="mx-auto flex max-w-[760px] flex-col gap-6 px-5 pt-4 pb-24 lg:px-8">
      <!-- 1. Atención al cliente -->
      <section id="atencion" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('atencion').icono} class="size-6" /></span>
          <span><span class="seccion-numero">01</span><h2>Atención al cliente</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{atencion.objetivo}</p>

        <h3 class="subtitulo">Cada cliente, en 5 pasos</h3>
        <ol class="pasos">
          {
            atencion.pasos.map((p, k) => (
              <li>
                <span class="paso-numero">{k + 1}</span>
                <span class="paso-icono"><Icon name={p.icono} class="size-5" /></span>
                <span>
                  <strong>{p.titulo}</strong>
                  <span class="block text-texto-2">{p.texto}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <h3 class="subtitulo">Clientes frecuentes: beneficios exclusivos</h3>
        <div class="grid grid-cols-2 gap-3">
          {
            atencion.beneficios.map((b) => (
              <div class="rounded-2xl bg-menta-suave p-4 text-center">
                <span class="block text-3xl font-bold text-profundo">{b.valor}</span>
                <span class="mt-1 block text-sm text-texto-2">{b.texto}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 2. Reglas de mostrador -->
      <section id="reglas" class="seccion bg-profundo! text-white">
        <header class="seccion-cabeza">
          <span class="seccion-icono bg-white/12! text-menta!"><Icon name={titulo('reglas').icono} class="size-6" /></span>
          <span><span class="seccion-numero text-menta!">02</span><h2 class="text-white!">Las 5 reglas de mostrador</h2></span>
        </header>
        <p class="mt-2 text-white/75">Lo único que no se negocia con un cliente.</p>
        <ol class="mt-5 flex flex-col gap-3">
          {
            reglas.map((r, k) => (
              <li class="flex gap-3 rounded-2xl bg-white/8 p-4 ring-1 ring-white/10">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-menta font-bold text-profundo">{k + 1}</span>
                <span>
                  <span class="block font-semibold">{r.titulo}</span>
                  <span class="mt-1 block text-sm text-white/80">{r.texto}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- 3. Tareas generales -->
      <section id="tareas" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('tareas').icono} class="size-6" /></span>
          <span><span class="seccion-numero">03</span><h2>Tareas generales</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{tareasGenerales.objetivo}</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            tareasGenerales.grupos.map((g) => (
              <div class="rounded-2xl bg-crema p-4 ring-1 ring-profundo/8">
                <p class="flex items-center gap-2 font-bold text-profundo">
                  <Icon name={g.icono} class="size-5 text-marca" />
                  {g.titulo}
                </p>
                <ul class="mt-3 flex flex-col gap-2">
                  {g.items.map((it) => (
                    <li class="flex items-center gap-3 rounded-xl bg-white px-3 py-2.5 text-[0.95rem]">
                      <Icon name={it.icono} class="size-5 shrink-0 text-marca" />
                      {it.titulo}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 4. Tareas por rol -->
      <section id="roles" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('roles').icono} class="size-6" /></span>
          <span><span class="seccion-numero">04</span><h2>Tareas específicas por rol</h2></span>
        </header>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            roles.map((r) => (
              <div class="overflow-hidden rounded-2xl ring-1 ring-profundo/10">
                <p class="flex items-center gap-2.5 bg-arena-suave px-4 py-3 font-bold text-profundo">
                  <span class="flex size-8 items-center justify-center rounded-full bg-white text-marca">
                    <Icon name={r.icono} class="size-5" />
                  </span>
                  {r.titulo}
                </p>
                <ul class="flex flex-col bg-white px-4 py-2">
                  {r.tareas.map((t) => (
                    <li class="flex items-start gap-2.5 border-b border-profundo/6 py-2 text-[0.95rem] last:border-0">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-marca" />
                      {t}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 5. Cierre del local -->
      <section id="cierre" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('cierre').icono} class="size-6" /></span>
          <span><span class="seccion-numero">05</span><h2>Cierre del local</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{cierre.objetivo}</p>
        <p class="mt-4 text-sm font-semibold text-texto-2">Usalo como lista: tocá cada paso cuando lo terminás.</p>
        <ul class="mt-3 flex flex-col gap-2" data-cierre>
          {
            cierre.pasos.map((p, k) => (
              <li>
                <label class="tarea-cierre">
                  <input type="checkbox" class="sr-only" />
                  <span class="caja" aria-hidden="true">
                    <Icon name="check" class="size-4" />
                  </span>
                  <span class="paso-icono"><Icon name={p.icono} class="size-5" /></span>
                  <span>
                    <strong>{k + 1}. {p.titulo}</strong>
                    <span class="block text-sm text-texto-2">{p.texto}</span>
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-arena-suave px-4 py-3">
          <p class="text-sm text-profundo"><strong>Responsable:</strong> {cierre.responsable}</p>
          <button type="button" class="text-sm font-semibold text-marca underline underline-offset-4" data-cierre-reiniciar>Empezar de nuevo</button>
        </div>
      </section>

      <!-- 6. Imagen y uniforme -->
      <section id="imagen" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('imagen').icono} class="size-6" /></span>
          <span><span class="seccion-numero">06</span><h2>Imagen y uniforme</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{imagen.objetivo}</p>
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {
            imagen.items.map((it) => (
              <li class="rounded-2xl bg-crema p-4 text-center ring-1 ring-profundo/8">
                <span class="mx-auto flex size-11 items-center justify-center rounded-full bg-menta text-profundo">
                  <Icon name={it.icono} class="size-6" />
                </span>
                <span class="mt-2 block font-bold text-profundo">{it.titulo}</span>
                <span class="mt-1 block text-sm text-texto-2">{it.texto}</span>
              </li>
            ))
          }
        </ul>
        <p class="nota">{imagen.nota}</p>
      </section>

      <!-- 7. Horarios y descansos -->
      <section id="horarios" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('horarios').icono} class="size-6" /></span>
          <span><span class="seccion-numero">07</span><h2>Horarios y descansos</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{horarios.objetivo}</p>
        <ol class="linea-tiempo mt-5">
          {
            horarios.momentos.map((m) => (
              <li>
                <span class="punto"><Icon name={m.icono} class="size-5" /></span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-marca uppercase">{m.titulo}</span>
                  <span class="block text-xl font-bold text-profundo">{m.valor}</span>
                  <span class="block text-sm text-texto-2">{m.texto}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="nota">{horarios.nota}</p>
      </section>

      <!-- 8. Uso del celular -->
      <section id="celular" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('celular').icono} class="size-6" /></span>
          <span><span class="seccion-numero">08</span><h2>Uso del celular</h2></span>
        </header>
        <p class="objetivo"><Icon name="target" class="size-5 shrink-0" />{celular.objetivo}</p>
        <div class="mt-5 flex items-center gap-4 rounded-2xl bg-profundo p-4 text-white">
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-menta text-profundo">
            <Icon name="package" class="size-6" />
          </span>
          <p><strong class="block text-menta">Celulares en la caja</strong>{celular.principal}</p>
        </div>
        <ul class="mt-3 grid gap-3 sm:grid-cols-3">
          {
            celular.reglas.map((r) => (
              <li class="rounded-2xl bg-crema p-4 ring-1 ring-profundo/8">
                <span class="flex items-center justify-between">
                  <Icon name={r.icono} class={`size-7 ${r.permitido ? 'text-marca' : 'text-peligro'}`} />
                  <span class={`rounded-full px-2.5 py-1 text-xs font-bold uppercase ${r.permitido ? 'bg-menta text-profundo' : 'bg-peligro-suave text-peligro'}`}>
                    {r.permitido ? 'Permitido' : 'Prohibido'}
                  </span>
                </span>
                <span class="mt-3 block font-bold text-profundo">{r.titulo}</span>
                <span class="mt-1 block text-sm text-texto-2">{r.texto}</span>
              </li>
            ))
          }
        </ul>
        <p class="nota">{celular.nota}</p>
      </section>

      <!-- 9. Música en el local -->
      <section id="musica" class="seccion">
        <header class="seccion-cabeza">
          <span class="seccion-icono"><Icon name={titulo('musica').icono} class="size-6" /></span>
          <span><span class="seccion-numero">09</span><h2>Música en el local</h2></span>
        </header>
        <p class="objetivo"><Icon name="speaker-low" class="size-5 shrink-0" />{musica.objetivo}</p>
        <h3 class="subtitulo">Estilos sugeridos</h3>
        <ul class="grid grid-cols-2 gap-3">
          {
            musica.estilos.map((e) => (
              <li class="rounded-2xl bg-menta-suave p-4">
                <Icon name={e.icono} class="size-6 text-marca" />
                <span class="mt-2 block font-bold text-profundo">{e.titulo}</span>
                <span class="block text-sm text-texto-2">{e.texto}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-crema p-4 ring-1 ring-profundo/8">
            <p class="flex items-center gap-2 font-bold text-profundo"><Icon name="spotify-logo" class="size-5 text-marca" /> Playlists recomendadas</p>
            <ul class="mt-2 flex flex-col gap-1 text-[0.95rem]">{musica.playlists.map((p) => <li>{p}</li>)}</ul>
          </div>
          <div class="rounded-2xl bg-crema p-4 ring-1 ring-profundo/8">
            <p class="flex items-center gap-2 font-bold text-profundo"><Icon name="headphones" class="size-5 text-marca" /> Artistas sugeridos</p>
            <p class="mt-2 text-[0.95rem]">{musica.artistas.join(', ')}.</p>
          </div>
        </div>
      </section>

      <!-- Cierre del manual -->
      <section class="rounded-3xl bg-arena-suave p-6 text-center">
        <Icon name="handshake" class="mx-auto size-10 text-marca" />
        <p class="mt-3 text-lg font-bold text-profundo">Reglamento general</p>
        <p class="mx-auto mt-1 max-w-[520px] text-texto-2">{cierreManual}</p>
        <p class="mt-3 font-semibold text-marca">¡Gracias por tu colaboración y compromiso!</p>
      </section>
    </div>
  </main>
</Manual>

<style>
  .seccion {
    scroll-margin-top: 80px;
    border-radius: 28px;
    background: #fff;
    padding: 20px;
    box-shadow: 0 0 0 1px rgb(33 76 59 / 0.08), 0 20px 40px -32px rgb(33 76 59 / 0.45);
  }
  @media (min-width: 640px) {
    .seccion {
      padding: 28px;
    }
  }
  .seccion-cabeza {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .seccion-cabeza h2 {
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-profundo);
  }
  .seccion-icono {
    display: flex;
    width: 48px;
    height: 48px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: var(--color-menta);
    color: var(--color-profundo);
  }
  .seccion-numero {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-marca);
  }
  .objetivo {
    margin-top: 16px;
    display: flex;
    gap: 10px;
    border-radius: 16px;
    background: var(--color-menta-suave);
    padding: 12px 14px;
    color: var(--color-profundo);
    font-weight: 600;
    line-height: 1.5;
  }
  .subtitulo {
    margin: 22px 0 10px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-profundo);
  }
  .nota {
    margin-top: 16px;
    border-left: 3px solid var(--color-marca);
    padding-left: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-texto-2);
  }
  /* Pasos de atención */
  .pasos {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pasos li {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-radius: 18px;
    background: var(--color-crema);
    padding: 12px 14px;
    line-height: 1.45;
  }
  .pasos strong {
    color: var(--color-profundo);
  }
  .paso-numero {
    display: flex;
    width: 26px;
    height: 26px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-profundo);
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
  }
  .paso-icono {
    display: flex;
    width: 36px;
    height: 36px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #fff;
    color: var(--color-marca);
  }
  /* Lista de cierre */
  .tarea-cierre {
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 12px;
    border-radius: 18px;
    background: var(--color-crema);
    padding: 12px 14px;
    line-height: 1.4;
    transition: background-color 200ms;
  }
  .tarea-cierre strong {
    color: var(--color-profundo);
  }
  .caja {
    display: flex;
    width: 26px;
    height: 26px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: #fff;
    color: transparent;
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  .tarea-cierre:has(input:checked) {
    background: var(--color-menta);
  }
  .tarea-cierre:has(input:checked) .caja {
    background: var(--color-profundo);
    color: #fff;
    box-shadow: none;
  }
  .tarea-cierre:has(input:checked) strong {
    text-decoration: line-through;
  }
  .tarea-cierre:has(input:focus-visible) {
    outline: 2px solid var(--color-marca);
    outline-offset: 2px;
  }
  /* Línea de tiempo de horarios */
  .linea-tiempo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .linea-tiempo::before {
    content: '';
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 21px;
    width: 2px;
    background: var(--color-menta);
  }
  .linea-tiempo li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .punto {
    position: relative;
    display: flex;
    width: 44px;
    height: 44px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: var(--color-profundo);
    color: var(--color-menta);
  }
  @media print {
    .seccion {
      box-shadow: none;
      border: 0.75pt solid #d5ddd8;
      break-inside: avoid;
    }
  }
</style>

<script>
  // La lista de cierre se recuerda en el celular hasta tocar "Empezar de nuevo".
  const CLAVE = 'lola-cierre:v1';
  const cajas = [...document.querySelectorAll<HTMLInputElement>('[data-cierre] input')];
  let marcadas: boolean[] = [];
  try {
    marcadas = JSON.parse(localStorage.getItem(CLAVE) ?? '[]');
  } catch {}
  cajas.forEach((c, k) => {
    c.checked = !!marcadas[k];
    c.addEventListener('change', () => {
      try {
        localStorage.setItem(CLAVE, JSON.stringify(cajas.map((x) => x.checked)));
      } catch {}
    });
  });
  document.querySelector('[data-cierre-reiniciar]')?.addEventListener('click', () => {
    cajas.forEach((c) => (c.checked = false));
    try {
      localStorage.removeItem(CLAVE);
    } catch {}
  });
</script>
