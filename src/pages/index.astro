---
// Inicio de la intranet del equipo. En el celular, primero lo que hay que hacer: saludo, título y
// "Tu camino" en 3 pasos (Bienvenida, góndolas y examen) con el paso actual destacado; después la
// fila para instalar la app y el video de bienvenida. En la compu el video va al costado del título.
// Abajo, las 25 góndolas con su estado (vista o repaso aprobado) y accesos a Guardados, el PDF e Instalar.
import { url } from '../lib/url';
import { render } from 'astro:content';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import VideoBloque from '../components/VideoBloque.astro';
import InstalarApp from '../components/InstalarApp.astro';
import { getGuia, urlCategoria, porZona } from '../data/guia';
import { secciones } from '../data/bienvenida';
import { NIVELES } from '../data/niveles';
import { existsSync } from 'node:fs';

const categorias = await getGuia();
const zonas = porZona(categorias);
const cantidad = Object.fromEntries(
  await Promise.all(categorias.map(async (c) => [c.id, (await render(c)).headings.filter((h) => h.depth === 3).length] as const)),
);
const pdfGuia = existsSync('public/guia-de-productos-lola.pdf');

const pasos = [
  {
    id: 'bienvenida',
    href: url('/bienvenida'),
    icono: 'hand-waving',
    titulo: 'Bienvenida',
    texto: 'Cómo trabajamos en la almacén: atención al cliente, tareas, cierre y nuestros acuerdos.',
    total: secciones.length,
    unidad: 'temas leídos',
    empezar: 'Empezar la Bienvenida',
    seguir: 'Seguir con la Bienvenida',
  },
  {
    id: 'productos',
    href: '#gondolas',
    icono: 'basket',
    titulo: 'Los productos',
    texto: `Las ${categorias.length} góndolas del local: qué es cada cosa y cómo explicarla.`,
    total: categorias.length,
    unidad: 'góndolas completadas',
    empezar: 'Empezar con las góndolas',
    seguir: 'Seguir con las góndolas',
  },
  {
    id: 'examen',
    href: url('/examen'),
    icono: 'exam',
    titulo: 'Examinarme',
    texto: `${NIVELES.map((n) => n.nombre).join(', ').replace(/, ([^,]*)$/, ' y $1')}: comprobá lo que aprendiste.`,
    total: NIVELES.length,
    unidad: 'niveles aprobados',
    empezar: 'Ir al examen',
    seguir: 'Seguir con el examen',
  },
];
---

<Manual>
  <main id="contenido">
    <section class="fondo-hojas px-5 pt-6 pb-10 lg:px-8 lg:pt-14 lg:pb-12">
      <div class="portada mx-auto max-w-[1100px]">
        <!-- Saludo y título -->
        <div class="portada-intro">
          <p class="text-lg font-semibold text-marca-texto" data-saludo>¡Hola!</p>
          <script is:inline>
            // El nombre desde el primer pintado (lo que guardó el login en este celular), sin que el saludo cambie después.
            try {
              var acceso = JSON.parse(localStorage.getItem('lola-acceso:v1') || 'null');
              var nombre = acceso && String(acceso.nombre || '').trim().split(/\s+/)[0];
              if (nombre) document.querySelector('[data-saludo]').textContent = '¡Hola, ' + nombre + '!';
            } catch (e) {}
          </script>
          <h1 class="titulo-degrade mt-1 max-w-[720px] text-[2rem] leading-[1.1] font-bold tracking-tight sm:text-5xl sm:leading-[1.08]">
            Todo lo que necesitás para trabajar en la almacén
          </h1>
          <p class="mt-2 max-w-[620px] text-base text-texto-2 sm:mt-3 sm:text-lg">
            Cómo trabajamos, los productos y el examen, en un solo lugar. Para tu primer día y para todos los demás.
          </p>
          <!-- En la compu no hay barra de abajo: un atajo al buscador (en el celular ya está en el encabezado y en la barra). -->
          <a
            href={url('/buscar')}
            class="mt-6 hidden max-w-[640px] items-center gap-3 rounded-2xl bg-white px-4 py-4 text-base text-texto-2 ring-1 ring-profundo/15 transition-shadow hover:ring-2 hover:ring-marca lg:flex"
          >
            <Icon name="magnifying-glass" class="size-5 shrink-0" />
            Buscá un producto o lo que te preguntó un cliente
          </a>
        </div>

        <!-- Tu camino -->
        <section class="portada-camino" aria-labelledby="titulo-camino">
          <h2 id="titulo-camino" class="text-2xl font-bold tracking-tight text-profundo sm:text-3xl">Tu camino</h2>
          <p class="mt-1 text-base text-texto-2">Tres pasos. Si recién entrás, seguilos en orden.</p>
          <ol class="mt-4 grid gap-3 sm:mt-5 lg:grid-cols-3">
            {
              pasos.map((p, k) => (
                <li>
                  <a href={p.href} class="paso group" data-paso={p.id} data-total={p.total} data-empezar={p.empezar} data-seguir={p.seguir}>
                    <span class="paso-seguir">Seguí por acá</span>
                    <span class="flex items-start gap-4">
                      <span class="relative flex size-14 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
                        <Icon name={p.icono} class="size-7" />
                        <span class="absolute -top-2 -left-2 flex size-6 items-center justify-center rounded-full bg-profundo text-xs font-bold text-white">{k + 1}</span>
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="block text-xl font-bold text-profundo">{p.titulo}</span>
                        <span class="paso-texto mt-1 block text-[0.95rem] leading-snug text-texto-2">{p.texto}</span>
                      </span>
                      <Icon name="arrow-right" class="paso-flecha mt-1 size-5 shrink-0 text-marca-texto" />
                    </span>
                    <span class="mt-4 block">
                      <span class="flex items-center justify-between gap-2 text-xs font-semibold text-texto-2">
                        <span>
                          <span data-hecho>0</span> de {p.total} {p.unidad}
                          <span data-extra />
                        </span>
                        <span class="paso-listo items-center gap-1 text-marca-texto">
                          <Icon name="check-circle" class="size-4" /> Listo
                        </span>
                      </span>
                      <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-menta-suave">
                        <span class="block h-full w-0 rounded-full bg-marca" data-barra />
                      </span>
                    </span>
                    <span class="paso-boton boton boton-principal mt-4 w-full" aria-hidden="true">
                      <span data-boton-texto>{p.empezar}</span>
                      <Icon name="arrow-right" class="size-5" />
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
          <script is:inline define:vars={{ temas: secciones.map((s) => s.id), gondolas: categorias.map((c) => c.id) }}>
            // Antes del primer pintado: el progreso de cada paso con lo guardado en el celular, así la tarjeta
            // destacada y su botón aparecen ya en su lugar (sin saltos).
            (function () {
              function leer(k, d) {
                try {
                  var v = JSON.parse(localStorage.getItem(k) || 'null');
                  return v == null ? d : v;
                } catch (e) {
                  return d;
                }
              }
              var e = leer('lola-app:v1', {});
              var l = leer('lola-bienvenida:v1', []);
              var q = e.quizzes || {};
              var niv = e.niveles || {};
              var vistas = (Array.isArray(e.vistas) ? e.vistas : []).filter(function (g) { return gondolas.indexOf(g) >= 0; }).length;
              var hechos = {
                bienvenida: temas.filter(function (t) { return Array.isArray(l) && l.indexOf(t) >= 0; }).length,
                productos: gondolas.filter(function (g) { return q[g] && q[g].completadaEl; }).length,
                examen: [1, 2, 3].filter(function (n) { return niv[n] && niv[n].aprobadoEl; }).length,
              };
              var marcado = false;
              document.querySelectorAll('[data-paso]').forEach(function (p) {
                var id = p.getAttribute('data-paso');
                var total = Number(p.getAttribute('data-total'));
                var hecho = Math.min(total, hechos[id] || 0);
                var completo = hecho >= total;
                p.querySelector('[data-hecho]').textContent = String(hecho);
                p.querySelector('[data-barra]').style.width = (hecho / total) * 100 + '%';
                if (id === 'productos' && vistas > hecho) p.querySelector('[data-extra]').textContent = ' · ' + vistas + (vistas === 1 ? ' vista' : ' vistas');
                if (completo) p.classList.add('completo');
                // El primer paso sin terminar es "por dónde seguir".
                if (!completo && !marcado) {
                  marcado = true;
                  p.classList.add('actual');
                  var empezo = hecho > 0 || (id === 'productos' && vistas > 0);
                  p.querySelector('[data-boton-texto]').textContent = p.getAttribute(empezo ? 'data-seguir' : 'data-empezar');
                }
              });
            })();
          </script>
        </section>

        <InstalarApp class="portada-instalar" />

        <!-- Video de bienvenida: en el celular, justo debajo del título y a todo el ancho; en la compu, al costado del título -->
        <section class="portada-video" aria-labelledby="titulo-video">
          <h2 id="titulo-video" class="text-xl font-bold tracking-tight text-profundo lg:sr-only">El video de bienvenida</h2>
          <p class="mt-1 text-base text-texto-2 lg:hidden">Un minuto para entender cómo usar la intranet.</p>
          <div class="video-bienvenida">
            <VideoBloque nombre="bienvenida-lola" titulo="Video de bienvenida: qué es la intranet y cómo usarla" />
          </div>
        </section>
      </div>
    </section>

    <!-- Paso 2: las góndolas -->
    <section id="gondolas" class="scroll-mt-20 px-5 py-10 lg:px-8" aria-labelledby="titulo-gondolas">
      <div class="mx-auto max-w-[1100px]">
        <p class="text-xs font-bold tracking-wide text-marca-texto uppercase">Paso 2 · Los productos</p>
        <h2 id="titulo-gondolas" class="mt-1 text-2xl font-bold tracking-tight text-profundo sm:text-3xl">Las góndolas</h2>
        <p class="mt-1 text-base text-texto-2">
          {categorias.length} góndolas, agrupadas como están en el local. Una góndola queda completada cuando aprobás su repaso.
        </p>
        <p class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-texto-2">
          <span class="inline-flex items-center gap-2"><span class="estado-gondola vista" aria-hidden="true" /> Ya la viste</span>
          <span class="inline-flex items-center gap-2">
            <span class="estado-gondola completada" aria-hidden="true"><Icon name="check" class="size-3.5" /></span> Repaso aprobado
          </span>
        </p>
        <div class="mt-6 flex flex-col gap-8">
          {
            zonas.map((z) => (
              <div>
                <h3 class="text-sm font-bold tracking-wide text-marca-texto uppercase">{z.nombre}</h3>
                <ul class="mt-3 grid gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
                  {z.categorias.map((c) => (
                    <li>
                      <a
                        href={urlCategoria(c)}
                        data-gondola={c.id}
                        class="gondola group relative flex h-full min-h-11 items-center gap-3 rounded-2xl bg-white p-3 ring-1 ring-profundo/8 transition-transform duration-500 ease-fluid active:scale-[0.98] sm:flex-col sm:items-start sm:rounded-tarjeta sm:p-5 sm:hover:-translate-y-1"
                      >
                        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta-suave text-profundo group-hover:bg-menta">
                          <Icon name={c.data.icono} class="size-6" />
                        </span>
                        <span class="min-w-0 flex-1 sm:mt-1">
                          <span class="block text-base leading-snug font-semibold text-profundo sm:pr-8 sm:text-lg">
                            {c.data.titulo}
                            <span class="sr-only" data-estado-texto />
                          </span>
                          <span class="mt-0.5 block text-sm text-texto-2">{cantidad[c.id]} productos</span>
                          <span class="mt-1 hidden text-sm text-texto-2 sm:block">{c.data.bajada}</span>
                        </span>
                        <span class="estado-gondola sm:absolute sm:top-4 sm:right-4" aria-hidden="true">
                          <Icon name="check" class="size-3.5" />
                        </span>
                        <Icon name="caret-right" class="size-5 shrink-0 text-marca-texto sm:hidden" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Más -->
    <section class="px-5 pt-4 pb-24 lg:px-8" aria-labelledby="titulo-mas">
      <div class="mx-auto max-w-[1100px]">
        <h2 id="titulo-mas" class="text-xl font-bold tracking-tight text-profundo">Más</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <a href={url('/guardados')} class="flex items-center gap-4 rounded-tarjeta bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="star" class="size-7 shrink-0 text-marca-texto" />
            <span>
              <span class="block font-semibold text-profundo">Tus guardados</span>
              <span class="block text-sm text-texto-2" data-guardados>Las fichas que marcás con la estrella.</span>
            </span>
          </a>
          <a
            href={url(pdfGuia ? '/guia-de-productos-lola.pdf' : '/guia/imprimir')}
            class="flex items-center gap-4 rounded-tarjeta bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave"
          >
            <Icon name="file-pdf" class="size-7 shrink-0 text-marca-texto" />
            <span>
              <span class="block font-semibold text-profundo">La guía en PDF</span>
              <span class="block text-sm text-texto-2">Para imprimir en el local o tenerla guardada.</span>
            </span>
          </a>
          <a href={url('/instalar')} class="solo-navegador flex items-center gap-4 rounded-tarjeta bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="device-mobile" class="size-7 shrink-0 text-marca-texto" />
            <span>
              <span class="block font-semibold text-profundo">Instalar la app</span>
              <span class="block text-sm text-texto-2">Paso a paso para Android y iPhone.</span>
            </span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Manual>

<style>
  /* Portada: en el celular va todo en una columna (título, video, camino, instalar);
     en la compu el video queda a la derecha del título y el camino abajo, a todo el ancho. */
  .portada {
    display: grid;
    row-gap: 28px;
  }
  .portada-intro { order: 1; }
  .portada-video { order: 2; }
  .portada-camino { order: 3; }
  .portada :global(.portada-instalar) { order: 4; }
  .video-bienvenida {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .portada {
      grid-template-columns: minmax(0, 1fr) 340px;
      column-gap: 48px;
      row-gap: 48px;
    }
    .portada-intro {
      grid-column: 1;
      grid-row: 1;
    }
    .portada-video {
      grid-column: 2;
      grid-row: 1;
    }
    .portada-video .video-bienvenida {
      max-width: none;
    }
    .portada-video :global(.video-bloque) {
      margin-top: 0;
    }
    .portada-camino {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    /* La fila de instalar es de otro componente: se ubica con :global */
    .portada :global(.portada-instalar) {
      grid-column: 1;
      grid-row: 3;
    }
  }

  .paso {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius-tarjeta);
    background: #fff;
    padding: 18px;
    box-shadow: var(--shadow-reposo);
    transition: transform 400ms var(--ease-fluid);
  }
  .paso:hover {
    transform: translateY(-2px);
  }
  .paso-flecha {
    transition: transform 300ms var(--ease-fluid);
  }
  .paso:hover .paso-flecha {
    transform: translateX(4px);
  }
  /* El paso por el que hay que seguir: borde, cartel y botón lleno */
  .paso.actual {
    box-shadow: 0 0 0 2px var(--color-marca), var(--shadow-elevada);
  }
  .paso-seguir {
    display: none;
    position: absolute;
    top: -10px;
    right: 18px;
    border-radius: 9999px;
    background: var(--color-marca-texto);
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .paso.actual .paso-seguir {
    display: block;
  }
  .paso-boton {
    display: none;
  }
  .paso.actual .paso-boton {
    display: flex;
  }
  .paso.actual .paso-flecha {
    display: none;
  }
  .paso-listo {
    display: none;
  }
  .paso.completo .paso-listo {
    display: flex;
  }
  /* En el celular, un paso terminado queda más bajo para que el actual suba */
  @media (max-width: 1023px) {
    .paso.completo .paso-texto {
      display: none;
    }
    .paso.completo .mt-4 {
      margin-top: 12px;
    }
  }

  /* Estado de cada góndola: contorno = ya la viste; lleno con tilde = aprobó el repaso */
  .estado-gondola {
    display: flex;
    width: 22px;
    height: 22px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: transparent;
  }
  .gondola .estado-gondola {
    visibility: hidden;
  }
  .gondola[data-estado] .estado-gondola {
    visibility: visible;
  }
  .estado-gondola.vista,
  .gondola[data-estado='vista'] .estado-gondola {
    box-shadow: inset 0 0 0 2px var(--color-marca);
  }
  .estado-gondola.completada,
  .gondola[data-estado='completada'] .estado-gondola {
    background: var(--color-marca-texto);
    color: #fff;
    box-shadow: none;
  }
</style>

<script>
  import { app } from '../scripts/app';
  import { accesoGuardado } from '../scripts/sesion';

  const estado = app.estado();

  // Saludo con el nombre de la cuenta (o el que cargó en el certificado). Normalmente ya lo puso el script
  // del primer pintado; esto lo completa si no había sesión guardada todavía.
  const saludo = document.querySelector<HTMLElement>('[data-saludo]')!;
  const nombre = (accesoGuardado()?.nombre || estado.nombre || '').trim().split(/\s+/)[0];
  if (nombre) saludo.textContent = `¡Hola, ${nombre}!`;

  // Estado de cada góndola: vista (la abrió) o completada (aprobó el repaso).
  const completadas = new Set(
    Object.entries(estado.quizzes)
      .filter(([, q]) => q.completadaEl)
      .map(([g]) => g),
  );
  const vistas = new Set(estado.vistas);
  document.querySelectorAll<HTMLElement>('[data-gondola]').forEach((a) => {
    const g = a.dataset.gondola!;
    const e = completadas.has(g) ? 'completada' : vistas.has(g) ? 'vista' : '';
    if (!e) return;
    a.dataset.estado = e;
    a.querySelector('[data-estado-texto]')!.textContent = e === 'completada' ? ' (repaso aprobado)' : ' (ya la viste)';
  });

  // Guardados
  if (estado.guardadas.length) {
    const g = estado.guardadas.length;
    document.querySelector('[data-guardados]')!.textContent = `Tenés ${g} ficha${g > 1 ? 's' : ''} guardada${g > 1 ? 's' : ''}.`;
  }
</script>
