---
// Inicio de la intranet del equipo: para qué sirve, el camino en 3 pasos (Bienvenida,
// productos y examen) con el progreso de cada uno, el buscador y las góndolas.
import { url } from '../lib/url';
import { render } from 'astro:content';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
import InstalarApp from '../components/InstalarApp.astro';
import { getGuia, urlCategoria, porZona } from '../data/guia';
import { secciones } from '../data/bienvenida';
import { NIVELES } from '../data/niveles';
import { existsSync } from 'node:fs';

const categorias = await getGuia();
const zonas = porZona(categorias);
const cantidad = Object.fromEntries(
  await Promise.all(categorias.map(async (c) => [c.id, (await render(c)).headings.filter((h) => h.depth === 3).length] as const)),
);
const pdfGuia = existsSync('public/guia-de-productos-lola.pdf');

const pasos = [
  {
    id: 'bienvenida',
    href: url('/bienvenida'),
    icono: 'hand-waving',
    titulo: 'Bienvenida',
    texto: 'Cómo trabajamos en Lola: atención al cliente, tareas, cierre y nuestros acuerdos.',
    total: secciones.length,
    unidad: 'temas leídos',
  },
  {
    id: 'productos',
    href: '#gondolas',
    icono: 'basket',
    titulo: 'Los productos',
    texto: `Las ${categorias.length} góndolas de la dietética: qué es cada cosa y cómo explicarla.`,
    total: categorias.length,
    unidad: 'góndolas vistas',
  },
  {
    id: 'examen',
    href: url('/examen'),
    icono: 'exam',
    titulo: 'Examinarme',
    texto: `${NIVELES.map((n) => n.nombre).join(', ').replace(/, ([^,]*)$/, ' y $1')}: comprobá lo que aprendiste.`,
    total: NIVELES.length,
    unidad: 'niveles aprobados',
  },
];
---

<Manual>
  <main id="contenido">
    <!-- Portada -->
    <section class="fondo-hojas px-5 pt-8 pb-8 lg:px-8 lg:pt-14 lg:pb-12">
      <div class="mx-auto max-w-[1100px]">
        <p class="text-lg font-semibold text-marca" data-saludo>¡Hola!</p>
        <h1 class="titulo-degrade mt-1 max-w-[720px] text-4xl leading-[1.08] font-bold tracking-tight sm:text-5xl">
          Todo lo que necesitás para trabajar en Lola
        </h1>
        <p class="mt-3 max-w-[620px] text-lg text-texto-2">
          Acá aprendés cómo trabajamos, conocés los productos de la dietética y te ponés a prueba. Sirve para tu primer día y para
          todos los demás.
        </p>

        <InstalarApp class="mt-6 max-w-[640px]" />

        <div id="buscar" class="relative mt-6 max-w-[640px]">
          <label for="buscador" class="sr-only">Buscar un producto</label>
          <span class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-texto-2">
            <Icon name="magnifying-glass" class="size-5" />
          </span>
          <input
            id="buscador"
            type="search"
            autocomplete="off"
            placeholder="Buscá un producto: chía, boldo, stevia…"
            class="w-full rounded-2xl bg-white py-4 pr-4 pl-12 text-base text-texto ring-1 ring-profundo/15 outline-none placeholder:text-texto-2/70 focus:ring-2 focus:ring-marca"
          />
        </div>
        <p class="mt-3 hidden text-sm text-texto-2" data-buscador-estado aria-live="polite"></p>
        <ol class="mt-3 flex max-w-[640px] flex-col gap-2" data-resultados></ol>
      </div>
    </section>

    <!-- Tu camino -->
    <section class="px-5 pt-2 pb-10 lg:px-8" aria-labelledby="titulo-camino">
      <div class="mx-auto max-w-[1100px]">
        <h2 id="titulo-camino" class="text-2xl font-bold tracking-tight text-profundo sm:text-3xl">Tu camino</h2>
        <p class="mt-1 text-base text-texto-2">Tres pasos. Si recién entrás, seguilos en orden.</p>
        <ol class="mt-5 grid gap-3 lg:grid-cols-3">
          {
            pasos.map((p, k) => (
              <li>
                <a href={p.href} class="paso group" data-paso={p.id} data-total={p.total}>
                  <span class="paso-seguir hidden" data-seguir>
                    Seguí por acá
                  </span>
                  <span class="flex items-start gap-4">
                    <span class="relative flex size-14 shrink-0 items-center justify-center rounded-2xl bg-menta text-profundo">
                      <Icon name={p.icono} class="size-7" />
                      <span class="absolute -top-2 -left-2 flex size-6 items-center justify-center rounded-full bg-profundo text-xs font-bold text-white">{k + 1}</span>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-xl font-bold text-profundo">{p.titulo}</span>
                      <span class="mt-1 block text-[0.95rem] leading-snug text-texto-2">{p.texto}</span>
                    </span>
                    <Icon name="arrow-right" class="mt-1 size-5 shrink-0 text-marca transition-transform group-hover:translate-x-1" />
                  </span>
                  <span class="mt-4 block">
                    <span class="flex items-center justify-between text-xs font-semibold text-texto-2">
                      <span>
                        <span data-hecho>0</span> de {p.total} {p.unidad}
                      </span>
                      <span class="hidden items-center gap-1 text-marca" data-completo>
                        <Icon name="check-circle" class="size-4" /> Listo
                      </span>
                    </span>
                    <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-menta-suave">
                      <span class="block h-full w-0 rounded-full bg-marca transition-[width] duration-700 ease-fluid" data-barra />
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Paso 2: las góndolas -->
    <section id="gondolas" class="scroll-mt-20 px-5 py-10 lg:px-8" aria-labelledby="titulo-gondolas">
      <div class="mx-auto max-w-[1100px]">
        <p class="text-xs font-bold tracking-wide text-marca uppercase">Paso 2 · Los productos</p>
        <h2 id="titulo-gondolas" class="mt-1 text-2xl font-bold tracking-tight text-profundo sm:text-3xl">Las góndolas</h2>
        <p class="mt-1 text-base text-texto-2">{categorias.length} góndolas, agrupadas como están en el local. Las que ya viste tienen un tilde.</p>
        <div class="mt-6 flex flex-col gap-8">
          {
            zonas.map((z) => (
              <div>
                <h3 class="text-sm font-bold tracking-wide text-marca uppercase">{z.nombre}</h3>
                <ul class="mt-3 grid gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-4">
                  {z.categorias.map((c) => (
                    <li>
                      <a
                        href={urlCategoria(c)}
                        data-gondola={c.id}
                        class="group relative flex h-full items-center gap-3 rounded-2xl bg-white p-3 ring-1 ring-profundo/8 transition-transform duration-500 ease-fluid active:scale-[0.98] sm:flex-col sm:items-start sm:rounded-3xl sm:p-5 sm:hover:-translate-y-1"
                      >
                        <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-menta-suave text-profundo group-hover:bg-menta">
                          <Icon name={c.data.icono} class="size-6" />
                        </span>
                        <span class="min-w-0 flex-1 sm:mt-1">
                          <span class="block text-base leading-snug font-semibold text-profundo sm:text-lg">{c.data.titulo}</span>
                          <span class="mt-0.5 block text-sm text-texto-2">{cantidad[c.id]} productos</span>
                          <span class="mt-1 hidden text-sm text-texto-2 sm:block">{c.data.bajada}</span>
                        </span>
                        <span class="hidden size-6 shrink-0 items-center justify-center rounded-full bg-menta text-profundo sm:absolute sm:top-3 sm:right-3" data-vista aria-label="Ya la viste">
                          <Icon name="check" class="size-4" />
                        </span>
                        <Icon name="caret-down" class="size-5 shrink-0 -rotate-90 text-marca sm:hidden" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Más -->
    <section class="px-5 pt-4 pb-24 lg:px-8" aria-labelledby="titulo-mas">
      <div class="mx-auto max-w-[1100px]">
        <h2 id="titulo-mas" class="text-xl font-bold tracking-tight text-profundo">Más</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <a href={url('/guardados')} class="flex items-center gap-4 rounded-3xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="bookmark-simple" class="size-7 shrink-0 text-marca" />
            <span>
              <span class="block font-semibold text-profundo">Tus guardados</span>
              <span class="block text-sm text-texto-2" data-guardados>Las fichas que marcás con la estrella.</span>
            </span>
          </a>
          <a href={url(pdfGuia ? '/guia-de-productos-lola.pdf' : '/guia/imprimir')} class="flex items-center gap-4 rounded-3xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="file-pdf" class="size-7 shrink-0 text-marca" />
            <span>
              <span class="block font-semibold text-profundo">La guía en PDF</span>
              <span class="block text-sm text-texto-2">Para imprimir en el local o tenerla guardada.</span>
            </span>
          </a>
          <a href={url('/instalar')} class="solo-navegador flex items-center gap-4 rounded-3xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
            <Icon name="device-mobile" class="size-7 shrink-0 text-marca" />
            <span>
              <span class="block font-semibold text-profundo">Instalar la app</span>
              <span class="block text-sm text-texto-2">Paso a paso para Android y iPhone.</span>
            </span>
          </a>
        </div>

      </div>
    </section>
  </main>
</Manual>

<style>
  .paso {
    position: relative;
    display: block;
    height: 100%;
    border-radius: 28px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 0 0 1px rgb(33 76 59 / 0.08), 0 20px 40px -32px rgb(33 76 59 / 0.45);
    transition: transform 400ms var(--ease-fluid);
  }
  .paso:hover {
    transform: translateY(-2px);
  }
  .paso.actual {
    box-shadow: 0 0 0 2px var(--color-marca), 0 20px 40px -28px rgb(33 76 59 / 0.5);
  }
  .paso-seguir {
    position: absolute;
    top: -10px;
    right: 18px;
    border-radius: 9999px;
    background: var(--color-marca);
    padding: 3px 10px;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
</style>

<script>
  import { initBuscador } from '../scripts/buscador';
  import { app, type Nivel } from '../scripts/app';
  import { leidas } from '../scripts/leidas';
  initBuscador();

  const estado = app.estado();

  // Saludo con el nombre, si ya lo cargó en el examen.
  if (estado.nombre) document.querySelector('[data-saludo]')!.textContent = `¡Hola, ${estado.nombre}!`;

  // Góndolas ya vistas
  document.querySelectorAll<HTMLElement>('[data-gondola]').forEach((a) => {
    if (!estado.vistas.includes(a.dataset.gondola!)) return;
    const tilde = a.querySelector<HTMLElement>('[data-vista]');
    tilde?.classList.remove('hidden');
    tilde?.classList.add('flex');
  });

  // Progreso del camino
  const hechos: Record<string, number> = {
    bienvenida: leidas().length,
    productos: new Set(estado.vistas).size,
    examen: ([1, 2, 3] as Nivel[]).filter((n) => app.nivel(n).aprobadoEl).length,
  };
  let marcado = false;
  document.querySelectorAll<HTMLElement>('[data-paso]').forEach((p) => {
    const total = Number(p.dataset.total);
    const hecho = Math.min(total, hechos[p.dataset.paso!] ?? 0);
    p.querySelector('[data-hecho]')!.textContent = String(hecho);
    p.querySelector<HTMLElement>('[data-barra]')!.style.width = `${(hecho / total) * 100}%`;
    const completo = hecho >= total;
    p.querySelector('[data-completo]')!.classList.toggle('hidden', !completo);
    p.querySelector('[data-completo]')!.classList.toggle('flex', completo);
    // El primer paso sin terminar es "por dónde seguir".
    if (!completo && !marcado) {
      marcado = true;
      p.classList.add('actual');
      p.querySelector('[data-seguir]')!.classList.remove('hidden');
    }
  });

  // Guardados
  if (estado.guardadas.length) {
    const g = estado.guardadas.length;
    document.querySelector('[data-guardados]')!.textContent = `Tenés ${g} ficha${g > 1 ? 's' : ''} guardada${g > 1 ? 's' : ''}.`;
  }
</script>
