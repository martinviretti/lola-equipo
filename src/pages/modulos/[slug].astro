---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import Manual from '../../layouts/Manual.astro';
import Icon from '../../components/Icon.astro';
import Alerta from '../../components/Alerta.astro';
import Tabla from '../../components/Tabla.astro';
import Quiz from '../../components/Quiz.astro';
import { getModulos, urlModulo, numeroModulo, type Modulo } from '../../data/modulos';

export async function getStaticPaths() {
  const modulos = await getModulos();
  return modulos.map((modulo, i) => ({
    params: { slug: modulo.id },
    props: { modulo, anterior: modulos[i - 1], siguiente: modulos[i + 1] },
  }));
}

interface Props {
  modulo: Modulo;
  anterior?: Modulo;
  siguiente?: Modulo;
}

const { modulo, anterior, siguiente } = Astro.props;
const { Content, headings } = await render(modulo);
const d = modulo.data;
const secciones = headings.filter((h) => h.depth === 2);
---

<Manual title={d.titulo} progreso>
  <main id="contenido" class="px-5 pt-8 pb-24 lg:px-8 lg:pt-12">
    <div class="mx-auto grid max-w-[1200px] gap-12 lg:grid-cols-[1fr_260px]">
      <article class="min-w-0 max-w-[720px]">
        <a href={url('/manual')} class="no-print inline-flex items-center gap-2 text-sm font-semibold text-marca hover:underline">
          <Icon name="arrow-left" class="size-4" />
          Manual completo
        </a>

        <header class="mt-6">
          <p class="flex items-center gap-2 text-sm font-semibold text-marca">
            <Icon name={d.icono} class="size-5" />
            Módulo {numeroModulo(modulo)} · {d.parte}
          </p>
          <h1 class="titulo-degrade mt-3 text-4xl font-bold tracking-tight sm:text-5xl">{d.titulo}</h1>
          <p class="mt-4 text-lg text-texto-2">{d.resumen}</p>
          <p class="mt-4 flex flex-wrap gap-2 text-sm font-semibold text-profundo">
            <span class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 ring-1 ring-profundo/10">
              <Icon name="clock" class="size-4" />
              {d.minutos} min de lectura
            </span>
            {
              d.quiz.length > 0 && (
                <a href="#quiz" class="no-print inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 ring-1 ring-profundo/10 hover:bg-menta-suave">
                  <Icon name="list-checks" class="size-4" />
                  {d.quiz.length} preguntas
                </a>
              )
            }
            <span data-estado-leido class="hidden items-center gap-1 rounded-full bg-menta px-3 py-1">
              <Icon name="check-circle" class="size-4" />
              Leído
            </span>
          </p>
        </header>

        {
          d.objetivos.length > 0 && (
            <section class="mt-8 rounded-3xl bg-menta-suave p-5 sm:p-6" aria-label="Objetivos">
              <p class="text-sm font-bold text-profundo">Cuando termines este módulo vas a poder:</p>
              <ul class="mt-3 flex flex-col gap-2">
                {d.objetivos.map((o) => (
                  <li class="flex gap-2 text-base">
                    <Icon name="check" class="mt-1 size-4 shrink-0 text-marca" />
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <details class="no-print mt-6 rounded-2xl bg-white ring-1 ring-profundo/10 lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between p-4 text-sm font-semibold text-profundo">
            En este módulo
            <Icon name="caret-down" class="size-4" />
          </summary>
          <ol class="flex flex-col gap-1 px-4 pb-4">
            {secciones.map((h) => (
              <li><a href={`#${h.slug}`} class="block rounded-lg px-2 py-1 text-sm text-texto-2 hover:bg-menta-suave">{h.text}</a></li>
            ))}
          </ol>
        </details>

        <div class="prosa mt-10">
          <Content components={{ Alerta, table: Tabla }} />
        </div>

        {
          d.fuentes.length > 0 && (
            <section class="mt-12 border-t border-profundo/10 pt-6 text-sm text-texto-2">
              <p class="font-semibold text-profundo">Fuentes consultadas</p>
              <ul class="mt-2 flex flex-col gap-1">
                {d.fuentes.map((f) => (
                  <li>
                    <a href={f.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-profundo">{f.titulo}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {d.quiz.length > 0 && <Quiz slug={modulo.id} preguntas={d.quiz} />}

        <div class="no-print mt-10 flex flex-wrap gap-3">
          <button type="button" data-marcar-leido={modulo.id} class="boton boton-principal">
            <Icon name="check-circle" class="size-5" />
            <span data-texto>Marcar como leído</span>
          </button>
          <button type="button" onclick="window.print()" class="boton boton-secundario">
            <Icon name="printer" class="size-5" />
            Imprimir este módulo
          </button>
        </div>

        <nav class="no-print mt-12 grid gap-3 sm:grid-cols-2" aria-label="Otros módulos">
          {
            anterior ? (
              <a href={urlModulo(anterior)} class="group rounded-2xl bg-white p-4 ring-1 ring-profundo/10 hover:bg-menta-suave">
                <span class="flex items-center gap-1 text-sm font-semibold text-marca">
                  <Icon name="arrow-left" class="size-4" /> Anterior
                </span>
                <span class="mt-1 block font-semibold text-profundo">{anterior.data.titulo}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            siguiente && (
              <a href={urlModulo(siguiente)} class="group rounded-2xl bg-profundo p-4 text-right text-white hover:bg-profundo-2">
                <span class="flex items-center justify-end gap-1 text-sm font-semibold text-menta">
                  Siguiente <Icon name="arrow-right" class="size-4" />
                </span>
                <span class="mt-1 block font-semibold">{siguiente.data.titulo}</span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="no-print hidden lg:block">
        <div class="sticky top-24">
          <p class="text-sm font-bold text-profundo">En este módulo</p>
          <ol class="mt-3 flex flex-col gap-1 border-l border-profundo/10" data-toc>
            {secciones.map((h) => (
              <li>
                <a href={`#${h.slug}`} data-toc-link={h.slug} class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-texto-2 hover:text-profundo">
                  {h.text}
                </a>
              </li>
            ))}
            {d.quiz.length > 0 && (
              <li>
                <a href="#quiz" data-toc-link="quiz" class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm font-semibold text-marca hover:text-profundo">
                  Ponete a prueba
                </a>
              </li>
            )}
          </ol>
        </div>
      </aside>
    </div>
  </main>
</Manual>

<style>
  [data-toc-link].activo {
    border-color: var(--color-marca);
    color: var(--color-profundo);
    font-weight: 600;
  }
</style>

<script>
  import { leer, marcarLeido } from '../../scripts/progreso';

  const boton = document.querySelector<HTMLButtonElement>('[data-marcar-leido]');
  const chip = document.querySelector<HTMLElement>('[data-estado-leido]');
  const slug = boton?.dataset.marcarLeido ?? '';

  const pintar = () => {
    const leido = !!leer().leidos[slug];
    chip?.classList.toggle('hidden', !leido);
    chip?.classList.toggle('inline-flex', leido);
    if (boton) boton.querySelector('[data-texto]')!.textContent = leido ? 'Leído. Desmarcar' : 'Marcar como leído';
  };
  boton?.addEventListener('click', () => {
    marcarLeido(slug, !leer().leidos[slug]);
    pintar();
  });
  pintar();

  // Índice lateral: marca la sección visible.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.classList.toggle('activo', l.dataset.tocLink === e.target.id));
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  links.forEach((l) => {
    const el = document.getElementById(l.dataset.tocLink!);
    if (el) obs.observe(el);
  });
</script>
