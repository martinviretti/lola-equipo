---
import { url } from '../../lib/url';
import Manual from '../../layouts/Manual.astro';
import Icon from '../../components/Icon.astro';
import Cartel, { type DatosCartel } from '../../components/Cartel.astro';
import carteles from '../../data/carteles.json';
import { existsSync } from 'node:fs';

const lista = carteles as DatosCartel[];
const hayPdf = existsSync('public/carteles-lola.pdf');
---

<Manual title="Carteles para las góndolas">
  <main id="contenido" class="px-5 pt-8 pb-24 lg:px-8">
    <div class="no-print mx-auto max-w-[1200px]">
      <h1 class="titulo-degrade text-4xl font-bold tracking-tight sm:text-5xl">Carteles para las góndolas</h1>
      <p class="mt-3 max-w-[640px] text-lg text-texto-2">
        Una hoja A4 por sector, con datos curiosos para que el cliente lea mientras elige. Imprimilos en color,
        plastificalos y pegalos en cada góndola.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {
          hayPdf && (
            <a href={url('/carteles-lola.pdf')} download class="boton boton-principal">
              <Icon name="file-pdf" class="size-5" /> Descargar todos en PDF
            </a>
          )
        }
        <button type="button" onclick="window.print()" class:list={['boton', hayPdf ? 'boton-secundario' : 'boton-principal']}>
          <Icon name="printer" class="size-5" /> Imprimir todos
        </button>
      </div>
      <p class="mt-3 text-sm text-texto-2">En la ventana de impresión: papel A4, sin márgenes y con "Gráficos de fondo" activado.</p>
    </div>

    <ul class="carteles mx-auto mt-10 grid max-w-[1200px] gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        lista.map((c) => (
          <li>
            <Cartel cartel={c} />
            <a href={url(`/carteles/${c.slug}`)} class="no-print mt-3 inline-flex items-center gap-2 text-sm font-semibold text-marca hover:underline">
              <Icon name="printer" class="size-4" /> Imprimir solo este
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Manual>

<style>
  @media print {
    main {
      padding: 0 !important;
    }
    .carteles {
      display: block;
      max-width: none;
      margin: 0;
    }
  }
</style>
