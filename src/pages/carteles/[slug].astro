---
import { url } from '../../lib/url';
import Manual from '../../layouts/Manual.astro';
import Icon from '../../components/Icon.astro';
import Cartel, { type DatosCartel } from '../../components/Cartel.astro';
import carteles from '../../data/carteles.json';

export function getStaticPaths() {
  return (carteles as DatosCartel[]).map((cartel) => ({ params: { slug: cartel.slug }, props: { cartel } }));
}

const { cartel } = Astro.props as { cartel: DatosCartel };
---

<Manual title={`Cartel: ${cartel.sector}`}>
  <main id="contenido" class="px-5 pt-6 pb-24 lg:px-8 print:p-0">
    <div class="no-print mx-auto flex max-w-[620px] flex-wrap items-center gap-3">
      <a href={url('/carteles')} class="inline-flex items-center gap-2 text-sm font-semibold text-marca hover:underline">
        <Icon name="arrow-left" class="size-4" /> Todos los carteles
      </a>
      <button type="button" onclick="window.print()" class="boton boton-principal ml-auto !py-2 !text-sm">
        <Icon name="printer" class="size-5" /> Imprimir
      </button>
    </div>
    <div class="mx-auto mt-6 max-w-[620px] print:mt-0 print:max-w-none">
      <Cartel cartel={cartel} />
    </div>
  </main>
</Manual>
