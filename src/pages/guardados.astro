---
import { url } from '../lib/url';
import Manual from '../layouts/Manual.astro';
import Icon from '../components/Icon.astro';
---

<Manual title="Guardados">
  <main id="contenido" class="px-5 pt-6 pb-16 lg:px-8 lg:pt-10">
    <div class="mx-auto max-w-[680px]">
      <h1 class="titulo-degrade text-4xl font-bold tracking-tight outline-none" tabindex="-1" data-titulo>Guardados</h1>
      <p class="mt-1 text-base text-texto-2">Las fichas que marcaste con la estrella, para tenerlas a mano.</p>

      <p class="cargando mt-8 text-base text-texto-2" data-cargando>Cargando tus guardados…</p>

      <div class="mt-8 rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" data-vacio hidden>
        <span class="mx-auto flex size-14 items-center justify-center rounded-full bg-menta-suave text-profundo">
          <Icon name="star" class="size-7" />
        </span>
        <p class="mt-4 text-lg font-semibold text-profundo">Todavía no guardaste nada</p>
        <p class="mt-1 text-base text-texto-2">
          En cada ficha de producto hay una estrella. Tocala para guardar las que más te cuesta recordar.
        </p>
        <a href={url('/#gondolas')} class="boton boton-principal mt-5">Ir a las góndolas</a>
      </div>

      <div class="mt-8 rounded-3xl bg-white p-6 text-center ring-1 ring-profundo/10" role="alert" data-error hidden>
        <span class="mx-auto flex size-14 items-center justify-center rounded-full bg-ambar-suave text-ambar">
          <Icon name="wifi-slash" class="size-7" />
        </span>
        <p class="mt-4 text-lg font-semibold text-profundo">No pudimos cargar tus guardados</p>
        <p class="mt-1 text-base text-texto-2">Sin conexión: probá de nuevo en un rato.</p>
        <button type="button" class="boton boton-principal mt-5" data-reintentar>
          <Icon name="arrows-clockwise" class="size-5" /> Reintentar
        </button>
      </div>

      <ul class="mt-6 flex flex-col gap-3" data-lista></ul>
    </div>
  </main>
</Manual>

<style>
  /* "Cargando…" solo si tarda: casi siempre la lista sale enseguida */
  .cargando {
    animation: aparecer 200ms 400ms both;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { app, cargarFichas, type Ficha } from '../scripts/app';
  import { avisar } from '../scripts/aviso';

  const lista = document.querySelector<HTMLUListElement>('[data-lista]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const error = document.querySelector<HTMLElement>('[data-error]')!;
  const cargando = document.querySelector<HTMLElement>('[data-cargando]')!;
  const titulo = document.querySelector<HTMLElement>('[data-titulo]')!;

  let fichas: Ficha[] | null = null;

  function mostrar(que: 'cargando' | 'vacio' | 'error' | 'lista') {
    cargando.hidden = que !== 'cargando';
    vacio.hidden = que !== 'vacio';
    error.hidden = que !== 'error';
    lista.hidden = que !== 'lista';
  }

  function tarjeta(f: Ficha) {
    const li = document.createElement('li');
    li.className = 'rounded-3xl bg-white p-5 ring-1 ring-profundo/10';
    li.dataset.id = f.id;
    const cab = document.createElement('div');
    cab.className = 'flex items-start justify-between gap-3';
    const enlace = document.createElement('a');
    enlace.href = f.url;
    enlace.innerHTML = `<span class="block text-xs font-semibold text-marca-texto"></span><span class="mt-0.5 block text-lg font-semibold text-profundo"></span>`;
    enlace.children[0].textContent = f.gondola;
    enlace.children[1].textContent = f.titulo;
    const quitar = document.createElement('button');
    quitar.type = 'button';
    quitar.className =
      'tap -mt-1.5 -mr-1.5 inline-flex shrink-0 items-center justify-center rounded-full px-4 text-sm font-semibold text-texto-2 ring-1 ring-profundo/10 hover:bg-menta-suave';
    quitar.textContent = 'Quitar';
    quitar.setAttribute('aria-label', `Quitar ${f.titulo} de Guardados`);
    quitar.dataset.quitar = '';
    quitar.addEventListener('click', () => void quitarFicha(f));
    cab.append(enlace, quitar);
    const ul = document.createElement('ul');
    ul.className = 'mt-3 flex flex-col gap-1.5 text-[0.95rem]';
    for (const l of f.lineas) {
      const item = document.createElement('li');
      if (l.etiqueta) {
        item.className = `rounded-xl px-3 py-2 ${l.etiqueta === 'Ojo' ? 'bg-ambar-suave' : l.etiqueta === 'Propiedades' ? 'bg-arena-suave' : 'bg-menta-suave'}`;
        const b = document.createElement('strong');
        b.className = 'text-profundo';
        b.textContent = `${l.etiqueta}: `;
        item.append(b);
      }
      item.append(document.createTextNode(l.texto));
      ul.append(item);
    }
    li.append(cab, ul);
    return li;
  }

  /** Lleva el foco al botón "Quitar" de una tarjeta (o al título si no quedó ninguna). */
  function enfocar(id?: string) {
    const destino = id ? lista.querySelector<HTMLElement>(`li[data-id="${CSS.escape(id)}"] [data-quitar]`) : null;
    (destino ?? titulo).focus();
  }

  async function quitarFicha(f: Ficha) {
    const ids = app.estado().guardadas;
    const posicion = ids.indexOf(f.id);
    // Después de quitar, el foco pasa a la tarjeta que sigue (o a la anterior, si era la última).
    const vecina = ids[posicion + 1] ?? ids[posicion - 1];
    app.guardarFicha(f.id, false);
    await pintar();
    enfocar(vecina);
    avisar('Quitada de Guardados', {
      accion: {
        texto: 'Deshacer',
        alTocar: async () => {
          app.guardarFicha(f.id, true, posicion);
          await pintar();
          enfocar(f.id);
        },
      },
    });
  }

  async function pintar() {
    const ids = app.estado().guardadas;
    if (!ids.length) {
      lista.replaceChildren();
      mostrar('vacio');
      return;
    }
    if (!fichas) {
      try {
        fichas = await cargarFichas();
      } catch (e) {
        console.error(e);
        lista.replaceChildren();
        mostrar('error');
        return;
      }
    }
    const porId = new Map(fichas.map((f) => [f.id, f]));
    const guardadas = ids.map((id) => porId.get(id)).filter((f): f is Ficha => !!f);
    lista.replaceChildren(...guardadas.map(tarjeta));
    mostrar(guardadas.length ? 'lista' : 'vacio');
  }

  const reintentar = document.querySelector<HTMLButtonElement>('[data-reintentar]')!;
  reintentar.addEventListener('click', async () => {
    mostrar('cargando');
    await pintar();
    if (error.hidden) return titulo.focus();
    reintentar.focus();
    avisar('Sigue sin conexión. Probá de nuevo en un rato.');
  });

  void pintar();
</script>
